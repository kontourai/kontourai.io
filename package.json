{
  "name": "kontourai-io",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "node scripts/check-content-boundary.cjs && node scripts/validate-public-evidence-registry.mjs && node --test tests/public-evidence-registry.test.mjs && node scripts/check-theme-tokens.mjs && node scripts/check-security-hardening.mjs && node scripts/check-receipts.mjs && node scripts/check-playwright-pin.mjs && node scripts/check-marketing-assets.mjs && node scripts/check-brand-downloads.mjs && node scripts/validate.mjs && node scripts/check-sitemap.mjs",
    "check:site-verify": "bash scripts/check-site-verify.sh",
    "test:rendered": "npm run build && playwright test",
    "refresh:product-status": "node scripts/refresh-product-status.mjs",
    "check:product-status": "node scripts/refresh-product-status.mjs --dry-run",
    "check:pin-drift": "node scripts/detect-pin-drift.mjs",
    "check:content-boundary": "node scripts/check-content-boundary.cjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:playwright-pin": "node scripts/check-playwright-pin.mjs",
    "check:receipts": "node scripts/check-receipts.mjs",
    "check:theme-tokens": "node scripts/check-theme-tokens.mjs",
    "check:security-hardening": "node scripts/check-security-hardening.mjs",
    "sync-versions": "node scripts/sync-versions.mjs",
    "sync-versions:check": "node scripts/sync-versions.mjs --check",
    "workflow:sidecar": "flow-agents-workflow-sidecar",
    "workflow:validate-artifacts": "flow-agents-validate-artifacts",
    "check:marketing-freshness": "node scripts/check-marketing-freshness.mjs",
    "check:marketing-assets": "node scripts/check-marketing-assets.mjs",
    "capture:marketing-screenshot": "node scripts/capture-marketing-screenshot.mjs",
    "render:brand-assets": "node scripts/render-brand-assets.mjs",
    "check:public-evidence": "node scripts/validate-public-evidence-registry.mjs",
    "check:public-evidence-reachability": "node scripts/check-public-evidence-reachability.mjs",
    "test:public-evidence": "node --test tests/public-evidence-registry.test.mjs",
    "export:brand-downloads": "node scripts/export-brand-downloads.mjs",
    "check:brand-downloads": "node scripts/check-brand-downloads.mjs"
  },
  "dependencies": {
    "@kontourai/surface": "2.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@kontourai/flow-agents": "5.10.0",
    "@kontourai/ui": "^1.20.1",
    "@kontourai/veritas": "1.11.4",
    "@playwright/test": "^1.64.1",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "hachure": "0.18.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
