---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Card from '@/components/Card.astro';
import Grid from '@/components/Grid.astro';
import { getPublicEvidenceClaimSources } from '@/lib/public-evidence';

const claimSources = {
  corePremise: getPublicEvidenceClaimSources('fieldwork.comparison.core-premise'),
  grounding: getPublicEvidenceClaimSources('fieldwork.comparison.grounding'),
  humanReview: getPublicEvidenceClaimSources('fieldwork.comparison.human-review'),
  recheckAndReplay: getPublicEvidenceClaimSources('fieldwork.comparison.recheck-and-replay'),
  reviewedOutput: getPublicEvidenceClaimSources('fieldwork.comparison.reviewed-output'),
  runtimePosture: getPublicEvidenceClaimSources('fieldwork.comparison.runtime-posture'),
};

function sourceUrl(sources: typeof claimSources.corePremise, sourceId: string): string {
  const source = sources.find((candidate) => candidate.id === sourceId);
  if (!source) throw new Error(`Claim evidence is missing canonical source ${sourceId}`);
  return source.url;
}

const sources = {
  langextract: sourceUrl(claimSources.corePremise, 'comparison.langextract-readme'),
  fieldwork: sourceUrl(claimSources.corePremise, 'fieldwork.readme'),
  survey: sourceUrl(claimSources.humanReview, 'survey.readme'),
  lookout: sourceUrl(claimSources.recheckAndReplay, 'lookout.readme'),
};

const rows = [
  {
    concern: 'Core premise',
    upstream: 'Schema- and example-guided structured extraction from unstructured text, with source locations for inspection.',
    kontour: 'Schema-directed, source-grounded proposals are the starting point; Fieldwork composes that work into an application review loop.',
    evidence: claimSources.corePremise,
  },
  {
    concern: 'Grounding',
    upstream: 'Reports character intervals when an extraction can be located in the source; unlocatable output is marked without an interval.',
    kontour: 'Traverse verifies excerpts against prepared text and derives exact chars: start–end locators rather than trusting provider-supplied offsets.',
    evidence: claimSources.grounding,
  },
  {
    concern: 'Human review',
    upstream: 'Provides an interactive HTML view for inspecting extractions in context.',
    kontour: 'Survey owns first-class source → extraction → candidate → review records; Fieldwork persists and validates the reviewed workflow before export.',
    evidence: claimSources.humanReview,
  },
  {
    concern: 'Recheck and replay',
    upstream: 'The pinned README describes extraction and visualization; this comparison does not attribute a source-drift workflow to it.',
    kontour: 'Forage snapshots enable exact replay; Lookout compares proposal observations so changed evidence can become a new review round.',
    evidence: claimSources.recheckAndReplay,
  },
  {
    concern: 'Reviewed output',
    upstream: 'Writes extraction results for downstream use and visualization.',
    kontour: 'After server-owned review, Fieldwork exports a Surface-validated, portable reviewed trust bundle with provenance rather than treating a model response as reviewed truth.',
    evidence: claimSources.reviewedOutput,
  },
  {
    concern: 'Runtime posture',
    upstream: 'Documents cloud and local model options, plus provider extension points.',
    kontour: 'Relay carries invocations; Dispatch can apply explicit budgets, fallback, and receipts. Those adapters describe execution mechanics, not model quality.',
    evidence: claimSources.runtimePosture,
  },
];

const sourceNames: Record<string, string> = {
  'comparison.langextract-readme': 'Pinned upstream README',
  'fieldwork.readme': 'Fieldwork README',
  'traverse.readme': 'Traverse README',
  'survey.readme': 'Survey README',
  'lookout.readme': 'Lookout README',
  'surface.readme': 'Surface README',
  'relay.readme': 'Relay README',
  'dispatch.readme': 'Dispatch README',
};
---

<Layout
  title="Fieldwork vs. Google LangExtract — a bounded comparison · Kontour AI"
  description="A source-linked comparison of Fieldwork's reviewed grounded-extraction workflow and Google LangExtract, with explicit evidence and claim limits."
>
  <Nav active="developers" />

  <Section contour size="hero" borderBottom>
    <Glow accent="cobalt-2" position="top-right" />
    <div class="container comparison-hero">
      <Eyebrow accent="cobalt-2">Deliberate comparison</Eyebrow>
      <p class="comparison-hero__label">Fieldwork and Google LangExtract</p>
      <h1 class="display-xl comparison-hero__title">Same grounded-extraction premise. Different completion boundary.</h1>
      <p class="hero-copy comparison-hero__copy">
        Both begin with structured information tied back to source text. Fieldwork is a
        composed application path: proposals are reviewed, rechecked against later source
        snapshots, and exported as portable trust evidence only after the review state is valid.
      </p>
      <div class="comparison-hero__actions">
        <a class="btn-primary" href="/fieldwork/">Explore Fieldwork →</a>
        <a class="btn-ghost" href={sources.langextract} target="_blank" rel="noopener">Read pinned upstream source ↗</a>
      </div>
      <p class="fine comparison-hero__receipt">
        Upstream reference pinned to public commit <code>0dff5479</code>. This page compares
        documented interfaces and repository evidence; it is not a benchmark.
      </p>
    </div>
  </Section>

  <Section borderBottom>
    <div class="container container--readable">
      <Eyebrow accent="gold-2">The shared ground</Eyebrow>
      <h2 class="display-md">Useful comparison starts with what is actually alike.</h2>
      <p class="lead measure">
        Google LangExtract and Kontour's extraction path both make a deliberate move away from
        untraceable free-form answers: a caller describes a structure, an extraction is tied to
        source text, and a person can inspect the result. That is the supported equivalence.
      </p>
      <p class="body measure">
        Fieldwork then composes public Kontour libraries around that premise: Traverse proposes
        and grounds; Survey records review; Lookout rechecks and diffs; Surface validates the
        reviewed trust export. The added layers are workflow and evidence boundaries—not a claim
        that any provider or model is generally more accurate.
      </p>
    </div>
  </Section>

  <Section tone="alt" borderBottom>
    <div class="container">
      <Eyebrow accent="cobalt-2">Capability map</Eyebrow>
      <h2 class="display-md comparison-heading">A source-linked comparison, row by row.</h2>
      <p class="body measure comparison-intro">
        “Kontour” below means the Fieldwork composition and its public dependencies, not a
        replacement API for a Python library.
      </p>

      <div class="comparison-table-wrap" tabindex="0" role="region" aria-label="Fieldwork and Google LangExtract comparison table">
        <table class="comparison-table">
          <thead>
            <tr>
              <th scope="col">Concern</th>
              <th scope="col">Google LangExtract</th>
              <th scope="col">Fieldwork composition</th>
              <th scope="col">Public evidence</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row">{row.concern}</th>
                <td>{row.upstream}</td>
                <td>{row.kontour}</td>
                <td>
                  <ul class="source-links">
                    {row.evidence.map((source) => (
                      <li><a href={source.url} target="_blank" rel="noopener">{sourceNames[source.id]} ↗</a></li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <Section borderBottom>
    <div class="container">
      <Eyebrow accent="gold-2">What the composition adds</Eyebrow>
      <h2 class="display-md comparison-heading">Evidence has a life after extraction.</h2>
      <Grid cols={3} gap="md" class="difference-grid">
        <Card accent="gold-2" bar="top">
          <p class="label-md difference-card__number">01 / Review</p>
          <h3>First-class human review</h3>
          <p class="body">Candidates and decisions stay attached to their source and extraction records. A browser approval alone is not the final authority.</p>
          <a href={sources.survey} target="_blank" rel="noopener">Survey review contract ↗</a>
        </Card>
        <Card accent="cobalt-2" bar="top">
          <p class="label-md difference-card__number">02 / Change</p>
          <h3>Drift and replay</h3>
          <p class="body">Snapshot references and proposal-observation diffs distinguish a changed source from a changed review decision, so work can be re-opened deliberately.</p>
          <a href={sources.lookout} target="_blank" rel="noopener">Lookout recheck contract ↗</a>
        </Card>
        <Card accent="green" bar="top">
          <p class="label-md difference-card__number">03 / Action</p>
          <h3>Portable trust, evidence-gated action</h3>
          <p class="body">A reviewed export carries its provenance into a Surface-validated trust bundle; action remains gated on the evidence the application requires.</p>
          <a href={sources.fieldwork} target="_blank" rel="noopener">Fieldwork export boundary ↗</a>
        </Card>
      </Grid>
    </div>
  </Section>

  <Section tone="alt" borderBottom>
    <div class="container">
      <Eyebrow accent="red-2">Evidence ceiling</Eyebrow>
      <h2 class="display-md comparison-heading">What this page does not claim.</h2>
      <Grid cols={2} gap="md" class="limits-grid">
        <Card accent="red-2" bar="top" class="limit-card">
          <h3>No drop-in API compatibility</h3>
          <p class="body">The public interfaces, languages, data models, and composition boundaries differ. Moving between them requires an intentional integration.</p>
        </Card>
        <Card accent="red-2" bar="top" class="limit-card">
          <h3>No general accuracy or provider superiority</h3>
          <p class="body">Grounding mechanics, review records, and runtime adapters do not establish that one model, provider, or system is generally more accurate.</p>
        </Card>
        <Card accent="red-2" bar="top" class="limit-card">
          <h3>No multipass-gain claim</h3>
          <p class="body">The upstream README describes multiple passes for higher recall. Kontour does not claim a recall gain from multipass processing here.</p>
        </Card>
        <Card accent="red-2" bar="top" class="limit-card">
          <h3>No upstream-suite result</h3>
          <p class="body">Kontour has not claimed to run or pass Google LangExtract’s exact upstream test suite. Its deterministic fixtures test its own contracts.</p>
        </Card>
        <Card accent="red-2" bar="top" class="limit-card">
          <h3>PDF and OCR are host adapters</h3>
          <p class="body">PDF parsing and OCR require explicit host-supplied adapters. They are not built-in engines, and an adapter’s existence does not prove extraction quality.</p>
        </Card>
        <Card accent="red-2" bar="top" class="limit-card">
          <h3>Runtime adapters are not a quality score</h3>
          <p class="body">Relay and Dispatch describe invocation, policy, receipts, budgets, and fallback. They do not prove a model’s quality for a task.</p>
        </Card>
      </Grid>
      <p class="fine limits-receipt">
        Evidence tiers: the linked public repositories establish documented interfaces and deterministic mechanics.
        They do not establish live-provider performance. Fieldwork’s checked-in comparison-neutral oracles retain
        expected typed values, proposal order, exact excerpts and locators, and reviewed claim evidence.
        A provider-quality claim would still require a task-specific, independently authored oracle.
      </p>
    </div>
  </Section>

  <Section>
    <div class="container container--readable comparison-close">
      <Eyebrow accent="cobalt-2">Choose the boundary you need</Eyebrow>
      <h2 class="display-md">Extraction inspection is valuable. So is knowing what happens next.</h2>
      <p class="lead measure">
        If your job ends with structured output and source inspection, Google LangExtract’s documented
        visualization path may be a direct fit. If your job needs reviewed decisions, source rechecks,
        replayable evidence, and a portable trust export, explore Fieldwork’s composition boundary.
      </p>
      <div class="comparison-close__actions">
        <a class="btn-primary" href="/fieldwork/">Explore Fieldwork →</a>
        <a class="btn-ghost" href={sources.fieldwork} target="_blank" rel="noopener">Read public contracts ↗</a>
      </div>
    </div>
  </Section>

  <Footer />
</Layout>

<style>
  .comparison-hero { max-width: 960px; }
  .comparison-hero__label { margin: 1.25rem 0 0; color: var(--color-cobalt-2); font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase; }
  .comparison-hero__title { max-width: 900px; margin: 0.75rem 0 1.5rem; }
  .comparison-hero__copy { max-width: 700px; }
  .comparison-hero__actions, .comparison-close__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .comparison-hero__receipt { margin-top: 1.25rem; max-width: 680px; }
  .comparison-heading { margin: 0.5rem 0 1rem; }
  .comparison-intro { margin-bottom: 2rem; }
  .comparison-table-wrap { overflow-x: auto; border: 1px solid var(--color-edge); border-radius: 0.5rem; }
  .comparison-table { width: 100%; min-width: 920px; border-collapse: collapse; text-align: left; }
  .comparison-table th, .comparison-table td { padding: 1.25rem; vertical-align: top; border-bottom: 1px solid var(--color-edge); }
  .comparison-table thead th { color: var(--color-chalk); background: var(--color-ink-2); font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; }
  .comparison-table tbody th { width: 13%; color: var(--color-gold-2); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; }
  .comparison-table td { width: 29%; color: var(--color-chalk-2); font-size: 0.9rem; line-height: 1.65; }
  .comparison-table tbody tr:last-child th, .comparison-table tbody tr:last-child td { border-bottom: 0; }
  .source-links { display: grid; gap: 0.45rem; margin: 0; padding: 0; list-style: none; font-size: 0.8rem; }
  .source-links a, .difference-grid a, .limits-receipt a { color: var(--color-cobalt-2); text-decoration: underline; text-underline-offset: 0.2em; }
  .difference-grid h3, .limits-grid h3 { margin: 0.25rem 0 0.75rem; color: var(--color-chalk); font-family: var(--font-display); font-size: 1.45rem; font-weight: 400; }
  .difference-grid .body, .limits-grid .body { margin: 0 0 1rem; }
  .difference-grid a { font-size: 0.85rem; }
  .difference-card__number { margin: 0; color: var(--accent); }
  .limits-grid { margin-top: 2rem; }
  .limit-card { min-height: 100%; }
  .limits-receipt { margin-top: 1.5rem; max-width: 760px; }
  .comparison-close { padding-bottom: 2rem; }
  @media (max-width: 700px) {
    .comparison-hero__title { font-size: clamp(2.65rem, 13vw, 4rem); }
    .comparison-table-wrap { margin-inline: -0.25rem; }
    .comparison-table th, .comparison-table td { padding: 1rem; }
    .comparison-hero__actions .btn-primary, .comparison-hero__actions .btn-ghost, .comparison-close__actions .btn-primary, .comparison-close__actions .btn-ghost { width: 100%; justify-content: center; }
  }
</style>
