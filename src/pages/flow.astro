---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Terminal from '@/components/Terminal.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import PlatformContext from '@/components/PlatformContext.astro';
import Card from '@/components/Card.astro';
import Grid from '@/components/Grid.astro';
import Split from '@/components/Split.astro';
import QuestionGrid from '@/components/QuestionGrid.astro';
import ProductMark from '@/components/ProductMark.astro';
import { getProductStatus, productBadge } from '@/lib/product-status';
import type { Accent } from '@/lib/theme';

const flowStatus = getProductStatus('flow');

// The version that produced the terminal captures below. Deliberately a pinned
// literal, NOT productBadge(flowStatus): a capture note is a claim about output
// recorded at a moment, so deriving it from live product status would re-label
// these transcripts at every release with no re-run — the same defect the
// screenshot captions had. Re-capture, then bump this.
const captureVersion = '3.10.0';

const answers: { q: string; accent?: Accent }[] = [
  { q: 'What was this run supposed to do?' },
  { q: 'Where did it stop?' },
  { q: 'What is it waiting for?', accent: 'cobalt-2' },
  { q: 'What proof did that step need?', accent: 'cobalt-2' },
  { q: 'What proof actually showed up?', accent: 'green' },
  { q: 'Why did it move on — or why did it not?', accent: 'gold' },
  { q: 'Did someone sign off on a gap, and who?', accent: 'red' },
  { q: 'Can a fresh session pick this up?' },
];

const objects: { label: string; detail: string; accent: Accent }[] = [
  { label: 'Flow Definition', detail: 'The required path — linear or a dependency DAG — and gate expectations', accent: 'cobalt-2' },
  { label: 'Flow Run', detail: 'One concrete execution with state and history', accent: 'green' },
  { label: 'Gate Evidence', detail: 'Tests, CI, traces, approvals, Veritas reports', accent: 'gold' },
  { label: 'Flow Report', detail: 'Current state, blocked gates, next action', accent: 'chalk-2' },
];

const integrations: { title: string; body: string; accent: Accent }[] = [
  { title: 'Durable workflow engines', body: 'Keep Camunda, Temporal, Dapr, Inngest, or Trigger.dev running the work while Flow makes required gates and their evidence inspectable.', accent: 'gold' },
  { title: 'Agent frameworks', body: 'Run LangGraph, CrewAI, OpenAI Agents, Microsoft Agent Framework, or your SDK of choice and give every loop the same visible completion criteria.', accent: 'cobalt-2' },
  { title: 'Observability stacks', body: 'Turn Phoenix, LangSmith, AgentOps, and OpenTelemetry traces into evidence evaluated against a declared gate.', accent: 'green' },
  { title: 'Policy and security tools', body: 'Carry OPA, security scanners, and Veritas decisions into the run history so reviewers can see what passed and what was waived.', accent: 'red' },
];

const consoleFeatures = [
  { label: 'Process graph', body: 'See the required path and where the run sits on it right now.' },
  { label: 'Transition timeline', body: 'Walk every gate the run cleared, blocked on, or routed back from.' },
  { label: 'Gate detail', body: 'Inspect the evidence a gate expected and what was actually collected.' },
  { label: 'Evidence links', body: 'Jump from a gate to the tests, CI, traces, or readiness reports behind it.' },
];

type TLine = { cls: string; text: string };

/* Every terminal below is an unedited capture from the demo that ships inside
   the published @kontourai/flow package (see product-status.json for the
   version the notes render), taken on 25 July 2026 in an empty directory with
   `npm install -D @kontourai/flow` followed by `npx flow init --demo`.

   The demo's own flow definition (agent-dev-flow) and its own evidence fixture
   are the only inputs. No run id, gate name, or line of output on this page was
   written by hand. Where a capture is trimmed or where blank separators were
   inserted between commands, the note under that terminal says so. */

const quickstartRun: TLine[] = [
  { cls: 'prompt', text: 'npm install -D @kontourai/flow' },
  { cls: 'prompt', text: 'npx @kontourai/flow init --demo' },
  { cls: 'muted', text: 'initialized .flow' },
  { cls: 'muted', text: 'demo run ready: demo' },
  { cls: 'muted', text: 'try:' },
  { cls: 'muted', text: '  flow status demo' },
  { cls: 'muted', text: '  flow resume demo' },
  { cls: 'muted', text: '  flow console --run demo' },
];

/* After `npx flow evaluate demo --exit-code` exits 1 at the implement gate. */
const heroRun: TLine[] = [
  { cls: 'prompt', text: 'npx flow status demo --format summary' },
  { cls: 'info', text: 'flow run: agent-dev-flow / demo-checkout-banner' },
  { cls: 'muted', text: 'current step: implement' },
  { cls: 'muted', text: '' },
  { cls: 'pass', text: 'PASS  plan gate: Acceptance criteria are ready for implementation. satisfied' },
  { cls: 'warn', text: 'BLOCK implementation gate: The implementation diff is scoped to the' },
  { cls: 'warn', text: '      planned change. missing' },
  { cls: 'muted', text: '      expected: The implementation diff is scoped to the planned change.' },
  { cls: 'muted', text: '      transition diagnostics: transition.gate.block' },
  { cls: 'muted', text: 'WAIT  verify gate: verify gate waiting' },
  { cls: 'muted', text: '' },
  { cls: 'muted', text: 'status: blocked' },
  { cls: 'muted', text: 'next action: attach scoped files before continuing' },
  { cls: 'muted', text: 'continuation: resume from implement, not chat memory' },
  { cls: 'muted', text: 'report: .kontourai/flow/runs/demo/report.md' },
  { cls: 'muted', text: 'ready steps: implement' },
];

/* Same run, one step later: the implement gate has been satisfied and the run
   has reached verify, where nothing has been attached yet. Exits 1. */
const routeBackRun: TLine[] = [
  { cls: 'prompt', text: 'npx flow evaluate demo --exit-code' },
  { cls: 'warn', text: 'route-back verify-gate: Test results are ready for verification. missing' },
  { cls: 'muted', text: 'current step: verify' },
  { cls: 'muted', text: 'next action: return to verify and replace failing evidence attempt 1/3' },
];

const lifecycleRun: TLine[] = [
  { cls: 'prompt', text: 'npx flow pause demo --request pause-request.json' },
  { cls: 'muted', text: 'pause: demo' },
  { cls: 'muted', text: 'status: paused' },
  { cls: 'muted', text: 'request: kontourai.io#231' },
  { cls: 'muted', text: '' },
  { cls: 'prompt', text: 'npx flow resume-run demo --request resume-request.json' },
  { cls: 'muted', text: 'resume: demo' },
  { cls: 'muted', text: 'status: blocked' },
  { cls: 'muted', text: 'request: kontourai.io#231' },
  { cls: 'muted', text: '' },
  { cls: 'prompt', text: 'npx flow kit validate ./release-kit' },
  { cls: 'pass', text: 'valid Flow Kit container: ./release-kit' },
];

const consoleRun: TLine[] = [
  { cls: 'prompt', text: 'npx flow console --run demo --port 4317' },
  { cls: 'info', text: 'Flow Console: http://127.0.0.1:4317/' },
  { cls: 'muted', text: 'run: demo' },
  { cls: 'muted', text: 'Press Ctrl+C to stop.' },
];
---

<Layout
  title="Flow — Inspectable required paths for AI-assisted work · Kontour AI"
  description="Flow makes required process paths inspectable by recording gates, evidence, transitions, exceptions, and resumable state."
>
  <Nav active="flow" />

  <!-- Hero -->
  <Section contour size="hero" borderBottom>
    <Glow accent="cobalt-2" position="top-right" />
    <div class="container">
      <Split ratio="1-1" gap="lg" align="center">
        <div>
          <PlatformContext />
          <div class="hero-badges">
            <span class="trust-badge trust-badge--verified">{productBadge(flowStatus)}</span>
            <span class="install-hint">npm install -D @kontourai/flow</span>
          </div>

          <ProductMark product="flow" size={40} class="product-hero-mark animate-fade-up" data-accent="cobalt-2" />
          <h1 class="product-title animate-fade-up">Flow</h1>
          <p class="product-tagline animate-fade-up delay-100" data-accent="cobalt-2">the agent said it was done — this is the part it skipped</p>

          <p class="hero-copy hero-copy--wide hero-copy--lead animate-fade-up delay-200">
            Your agent reports the task complete. It ran the tests — but did it
            ever open the page? Did the review happen, or did it get summarized
            away when the session ran out of room?
          </p>

          <p class="hero-copy hero-copy--wide animate-fade-up delay-300">
            Flow puts the answer in plain files next to your code. Every step
            has a gate — a checkpoint that names what the step has to hand over
            before the work moves on. Flow records what each gate asked for,
            what actually arrived, and anything a person waived on purpose.
            Nothing becomes "done" because an agent said so.
          </p>

          <div class="hero-actions animate-fade-up delay-400">
            <a href="https://kontourai.github.io/flow/" target="_blank" rel="noopener" class="btn-primary" data-umami-event="flow-hero-docs">Read the docs →</a>
            <a href="https://github.com/kontourai/flow" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="flow-hero-github">GitHub</a>
            <a href="https://www.npmjs.com/package/@kontourai/flow" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="flow-hero-npm">npm package</a>
            <a href="/surface/" class="btn-ghost" data-umami-event="flow-hero-surface">Built with Surface</a>
          </div>
        </div>

        <div>
          <Terminal class="animate-fade-in delay-300" title="flow status — a run that stopped">
            <pre class="code">{heroRun.map(({ cls, text }) => (
              cls === 'prompt'
                ? <span><span class="prompt">$ </span><span class="cmd">{text}</span>{'\n'}</span>
                : <span class={cls}>{text}{'\n'}</span>
            ))}</pre>
          </Terminal>
          <p class="term-note animate-fade-in delay-300">
            Real output from the demo inside @kontourai/flow {captureVersion},
            captured after <code>npx flow init --demo</code> and then <code>npx
            flow evaluate demo --exit-code</code>, which exits 1 and leaves the
            run exactly here. Nothing is added or reworded; the one over-long
            line is wrapped onto the indented line beneath it, and nothing else
            is changed. The gate that stopped the run is the demo's own
            implement gate — we did not pick it, and the run id, the step names
            and the gate descriptions are all the demo's.
          </p>
        </div>
      </Split>
    </div>
  </Section>

  <!-- Quickstart -->
  <Section tone="alt" borderBottom>
    <div class="container">
      <Eyebrow accent="cobalt-2">Quickstart</Eyebrow>
      <Terminal title="flow quickstart">
        <pre class="code">{quickstartRun.map(({ cls, text }) => (
          cls === 'prompt'
            ? <span><span class="prompt">$ </span><span class="cmd">{text}</span>{'\n'}</span>
            : <span class={cls}>{text}{'\n'}</span>
        ))}</pre>
      </Terminal>
      <p class="term-note">
        Real output from @kontourai/flow {captureVersion} in an empty
        directory. npm's own install output is trimmed; the six lines printed
        by <code>init --demo</code> are unedited, and the three commands it
        suggests are the ones the rest of this page runs.
      </p>
    </div>
  </Section>

  <!-- See it -->
  <Section borderBottom>
    <div class="container">
      <Eyebrow accent="cobalt-2" gap="sm">See it</Eyebrow>
      <figure class="product-shot product-shot--terminal">
        <img src="/screenshots/flow-demo.gif" alt="Terminal recording: flow init --demo, status, a blocked evaluate --exit-code, and resume" loading="lazy" width="1000" height="620" />
        <figcaption>Watch the third command. <code>flow evaluate --exit-code</code> exits non-zero and names the piece of proof that never showed up — the run does not become "done" because the agent said so. The fourth command picks the work back up from exactly that point. <a href="https://kontourai.github.io/flow/" target="_blank" rel="noopener">Full walkthrough in the docs →</a></figcaption>
      </figure>
    </div>
  </Section>

  <!-- What Flow answers -->
  <Section size="lg">
    <div class="container">
      <Eyebrow gap="lg">What Flow answers</Eyebrow>
      <h2 class="display-md measure-lg flow-answers-title">The status questions that should not depend on a transcript.</h2>
      <QuestionGrid items={answers} min="280" />
    </div>
  </Section>

  <!-- Example use case -->
  <Section borderTop>
    <div class="container">
      <Split ratio="1-1" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt-2">Example use case</Eyebrow>
          <h2 class="display-md diff__title">A release path that waits for evidence.</h2>
          <p class="body diff__copy">
            A team asks an agent to ship a pricing-page change. The flow they
            declare names the required path — plan, implementation, code review,
            rendered-page verification, release readiness — and what each step
            has to hand over. The work can only advance when each gate has the
            evidence it asked for.
          </p>
          <p class="body diff__copy diff__copy--last">
            The demo that ships with the package is that idea in four steps, and
            the capture beside this is what it actually does. The run has
            cleared plan and implementation and reached verify, where the gate
            asked for test results that were never attached. The run does not
            become "done." It routes back to the step that can fix it, carrying
            the reason and the attempt count with it.
          </p>
        </div>

        <div>
          <Terminal title="flow evaluate — the gate that was not satisfied">
            <pre class="code">{routeBackRun.map(({ cls, text }) => (
              cls === 'prompt'
                ? <span><span class="prompt">$ </span><span class="cmd">{text}</span>{'\n'}</span>
                : <span class={cls}>{text}{'\n'}</span>
            ))}</pre>
          </Terminal>
          <p class="term-note">
            Real output from the same demo run as the hero, after attaching the
            demo's own scoped-diff evidence to clear the implement gate.
            Unedited; the command exits 1. This is the demo's verify gate, not
            the release path described on the left — that path is an
            illustration, and we do not have a capture of it.
          </p>
        </div>
      </Split>
    </div>
  </Section>

  <!-- The difference -->
  <Section borderTop>
    <div class="container container--readable order-free">
      <Eyebrow accent="cobalt-2">Works the way the work actually happens</Eyebrow>
      <h2 class="display-md order-free__title">
        The conversation can wander.<br />The gate still asks for proof.
      </h2>
      <p class="body measure order-free__copy">
        Real sessions do not run in order. The agent grabs the screenshots
        first, the test run lands three messages later, and the review comes
        back the next morning from someone else. Tools that audit by insisting
        on a fixed sequence spend all their time fighting that.
      </p>
      <p class="body measure order-free__copy order-free__copy--last">
        Flow does not care what order the proof arrived in. At each gate it
        asks one question: is everything this step needs here, recent enough,
        and from a source you trust? Same answer whether it all landed in one
        go or in pieces across three sessions. And when something does not hold
        up, the work routes back — it returns to the step that caused the
        problem, with the reason attached. The run is not broken. It just is
        not finished.
      </p>
    </div>
  </Section>

  <Section tone="alt" borderTop borderBottom>
    <div class="container">
      <Split ratio="1-1" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt-2">The difference</Eyebrow>
          <h2 class="display-md diff__title">A trace says what happened.<br />Flow says whether it was enough.</h2>
          <p class="body diff__copy">
            Observability is necessary, but a trace alone does not know whether
            the right verification happened, whether approval had enough context,
            or whether the agent skipped a required handoff.
          </p>
          <p class="body diff__copy diff__copy--last">
            Flow turns required paths into evidence-gated transitions. If the
            evidence is missing, the run blocks or routes back. If the user accepts
            the gap, the exception becomes part of the record.
          </p>
        </div>

        <Grid cols={2} gap="md">
          {objects.map(({ label, detail, accent }) => (
            <div class="minicard" data-accent={accent}>
              <div class="minicard__label">{label}</div>
              <div class="minicard__detail">{detail}</div>
            </div>
          ))}
        </Grid>
      </Split>
    </div>
  </Section>

  <!-- Run authority + distribution (#164) -->
  <Section borderTop tone="alt">
    <div class="container">
      <Split ratio="1-1" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt-2" gap="sm">Authority over a run</Eyebrow>
          <h2 class="display-md authority__title">Pausing a run is a decision, and it says who decided.</h2>
          <p class="body authority__copy">
            Stopping a run is not something that just happens to it.{' '}
            <code class="code-plain">flow pause</code>,{' '}
            <code class="code-plain">flow resume-run</code>, and{' '}
            <code class="code-plain">flow cancel</code> each take a small
            request file saying who asked and why, and that lands in the run's
            history alongside everything else. A whole process can travel the
            same way: <code class="code-plain">flow kit validate</code>,{' '}
            <code class="code-plain">install</code>, and{' '}
            <code class="code-plain">inspect</code> turn a way of working into
            something a teammate can install and check, instead of a wiki page
            nobody reads.
          </p>
        </div>
        <div>
          <Terminal title="run lifecycle">
            <pre class="code">{lifecycleRun.map(({ cls, text }) => (
              cls === 'prompt'
                ? <span><span class="prompt">$ </span><span class="cmd">{text}</span>{'\n'}</span>
                : <span class={cls}>{text}{'\n'}</span>
            ))}</pre>
          </Terminal>
          <p class="term-note">
            Real output from the same demo run, unedited except for the blank
            line inserted between commands. Two lines are worth reading
            literally. The echoed <code>request:</code> value is the file's
            own <code>authority.request_ref</code> — here an issue on this
            site's repo — not the file name. And <code>resume-run</code>{' '}
            reports <code>status: blocked</code> because pause captured the
            status it interrupted and then put it back. The kit is a two-file
            container we built for this capture.
          </p>
        </div>
      </Split>
    </div>
  </Section>

  <!-- Integrations -->
  <Section borderTop>
    <div class="container">
      <Eyebrow gap="sm">Fits your stack</Eyebrow>
      <h2 class="display-md measure-lg">Give the tools you already use one visible definition of done.</h2>
      <Grid cols={4} gap="md">
        {integrations.map(({ title, body, accent }) => (
          <Card accent={accent} bar="top" pad="sm">
            <h3 class="feature-title">{title}</h3>
            <p class="feature-body">{body}</p>
          </Card>
        ))}
      </Grid>
    </div>
  </Section>

  <!-- Flow Console -->
  <Section borderTop>
    <div class="container">
      <Split ratio="1-1" gap="md" align="start">
        <div>
          <Eyebrow accent="cobalt-2">Flow Console</Eyebrow>
          <h2 class="display-md fc__title">See the run<br />where the work happens.</h2>
          <p class="body fc__copy">
            <code class="codechip" data-accent="cobalt-2">flow console --run &lt;id&gt;</code>{' '}
            opens a page on your own machine that reads the run straight out of{' '}
            <code class="code-plain">.kontourai/flow/runs/&lt;id&gt;/</code> — the
            path the work took, every gate it cleared or stopped at, and the
            evidence behind each one. It updates while the run does. It picks a
            free port unless you name one with{' '}
            <code class="code-plain">--port</code>, and it only ever listens on
            your own machine: no account, no upload, nothing hosted.
          </p>

          <div class="fc-list">
            {consoleFeatures.map(({ label, body }) => (
              <div class="kv fc-row">
                <div class="fc-row__key">{label}</div>
                <div class="kv__val">{body}</div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <Terminal title="flow console">
            <pre class="code">{consoleRun.map(({ cls, text }) => (
              cls === 'prompt'
                ? <span><span class="prompt">$ </span><span class="cmd">{text}</span>{'\n'}</span>
                : <span class={cls}>{text}{'\n'}</span>
            ))}</pre>
          </Terminal>
          <p class="term-note">
            Real output from the same demo run, unedited. Three lines is all
            that <code>flow console</code> prints; it then holds the terminal
            until you stop it. Everything else the console has to show is in
            the page it serves.
          </p>
        </div>
      </Split>
    </div>
  </Section>

  <!-- Where Flow fits -->
  <Section tone="alt" borderTop>
    <div class="container container--readable">
      <Eyebrow accent="gold">Where Flow fits</Eyebrow>
      <h2 class="display-md line__title">Flow is the record.<br />Flow Agents is what puts it in your editor.</h2>
      <p class="body measure line__copy">
        Flow on its own is a CLI and a library — you point it at whatever is
        already running your work. If you would rather not wire anything up,
        Flow Agents ships these checkpoints into your coding agent already set
        up: blocking in Claude Code and Codex, advisory everywhere else.
      </p>
      <div class="hero-actions line__actions">
        <a href="/flow-agents/" class="btn-primary" data-umami-event="flow-next-flow-agents">Start with Flow Agents →</a>
        <a href="/developers/#ownership" class="btn-ghost" data-umami-event="flow-next-ownership">See how the pieces fit</a>
        <a href="https://kontourai.github.io/flow/" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="flow-next-docs">Read the Flow docs</a>
      </div>
    </div>
  </Section>

  <Footer active="flow" />
</Layout>

<style>
  .hero-copy--wide {
    max-width: 500px;
  }
  /* Two hero paragraphs read as one thought; the global 2.5rem gap splits them. */
  .hero-copy--lead {
    margin-bottom: 1.25rem;
  }

  /* The demo GIF is 1000px wide and no longer upscales, so pin the figure to
     the recording's native width — otherwise the caption runs the full 1280px
     container and reads wider than the clip it describes. */
  .product-shot--terminal {
    max-width: 1000px;
    margin-inline: auto;
  }

  .diff__title,
  .flow-answers-title,
  .fc__title,
  .line__title,
  .order-free__title {
    margin-bottom: 1.25rem;
  }
  .diff__copy,
  .line__copy,
  .order-free__copy {
    margin-bottom: 1.5rem;
  }
  .diff__copy--last,
  .order-free__copy--last {
    margin-bottom: 0;
  }
  .line__actions {
    margin-top: 0.5rem;
  }

  .fc__copy {
    margin-bottom: 1.5rem;
  }
  .fc-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fc-row__key {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-cobalt-2);
    min-width: 130px;
    padding-top: 1px;
  }
  .authority__title { margin-bottom: 1.25rem; }
  .authority__copy { margin-bottom: 0; }

  /* Provenance note under a terminal: what was captured, and what was trimmed. */
  .term-note {
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-chalk-3);
    margin-top: 0.9rem;
    max-width: 52ch;
  }
  .term-note code {
    font-size: 0.75rem;
  }
</style>
