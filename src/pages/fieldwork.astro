---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Grid from '@/components/Grid.astro';
import Card from '@/components/Card.astro';
import Split from '@/components/Split.astro';
import Terminal from '@/components/Terminal.astro';
import { getProductStatus, productBadge } from '@/lib/product-status';
import { getPublicEvidenceClaimSourceUrl } from '@/lib/public-evidence';
import type { Accent } from '@/lib/theme';

const fieldworkStatus = getProductStatus('fieldwork');

const sources = {
  readme: getPublicEvidenceClaimSourceUrl('fieldwork.published-contract', 'fieldwork.readme'),
  browser: getPublicEvidenceClaimSourceUrl('fieldwork.browser-review-evidence', 'fieldwork.browser-review'),
  conformance: getPublicEvidenceClaimSourceUrl('fieldwork.deterministic-conformance', 'fieldwork.conformance'),
  release: getPublicEvidenceClaimSourceUrl('fieldwork.release-source', 'fieldwork.release'),
  runtime: getPublicEvidenceClaimSourceUrl('fieldwork.runtime-boundary', 'fieldwork.readme'),
};

const workflow: { step: string; owner: string; body: string; accent: Accent }[] = [
  { step: 'Find the values', owner: 'Extract', body: 'Pull renewal dates, amounts, obligations, status values, or other typed fields from the source text you give it.', accent: 'cobalt-2' },
  { step: 'Show the evidence', owner: 'Inspect', body: 'Put every proposed value beside the exact excerpt and locator that support it.', accent: 'gold-2' },
  { step: 'Record review', owner: 'Decide', body: 'Capture accept, reject, hold, and notes as a replayable review trail instead of a loose browser click.', accent: 'green' },
  { step: 'Catch changes', owner: 'Recheck', body: 'Compare a later source observation with the reviewed run so stale evidence reopens the work.', accent: 'gold' },
  { step: 'Export proof', owner: 'Publish', body: 'Export only when the reviewed state is resolved, current, and tied back to source.', accent: 'chalk-2' },
];

const adoptionPaths: { title: string; accent: Accent; items: string[] }[] = [
  {
    title: 'Run the complete review app',
    accent: 'green',
    items: [
      'Start locally with a task and source file',
      'Inspect proposals beside exact supporting excerpts',
      'Record review decisions and export resolved results',
    ],
  },
  {
    title: 'Embed the experience',
    accent: 'gold-2',
    items: [
      'Use the shared source inspector and review workbench',
      'Keep your product labels, rules, and storage',
      'Replay decisions against the exact reviewed snapshot',
    ],
  },
  {
    title: 'Connect more source formats',
    accent: 'cobalt-2',
    items: [
      'Bring acquired web pages, API records, PDFs, or scans',
      'Attach layout and table context to the evidence view',
      'Choose local, CLI, SDK, or hosted runtime execution',
    ],
  },
];

const evidence: { title: string; body: string; href: string; label: string; accent: Accent }[] = [
  {
    title: 'Published contract',
    body: 'The released CLI documents run, open, recheck, inspect, and export behavior, including the unresolved/stale/tampered export refusal.',
    href: sources.runtime,
    label: `Read the v${fieldworkStatus.version} contract →`,
    accent: 'green',
  },
  {
    title: 'Browser review evidence',
    body: 'The public browser tests exercise the shared inspection and review surfaces at desktop and mobile widths; the screenshots below are exact test snapshots.',
    href: sources.browser,
    label: 'Inspect the browser test →',
    accent: 'gold-2',
  },
  {
    title: 'Deterministic conformance',
    body: 'Checked-in fixtures and oracles establish mechanics such as locators, replay, review, and export. They do not establish live provider or model quality.',
    href: sources.conformance,
    label: 'Inspect the fixtures →',
    accent: 'cobalt-2',
  },
  {
    title: 'Runtime receipts',
    body: 'A host may select a live runtime. Dispatch receipts retain bounded execution evidence, but optional provider execution remains separate from the deterministic contract.',
    href: sources.readme,
    label: 'Read the runtime note →',
    accent: 'gold',
  },
];
---

<Layout
  title="Fieldwork — Grounded extraction reviewed before export · Kontour AI"
  description="Fieldwork is a local, credential-free review application for grounded extraction: inspect proposals, review source-linked evidence, recheck changes, then export a reviewed trust bundle."
>
  <Nav active="developers" />

  <Section contour size="hero" borderBottom>
    <Glow accent="green" position="top-right" />
    <div class="container">
      <Split ratio="1-1" gap="lg" align="center">
        <div>
          <div class="hero-badges">
            <span class="trust-badge trust-badge--verified">{productBadge(fieldworkStatus)}</span>
            <span class="install-hint">{fieldworkStatus.packageName}</span>
          </div>
          <Eyebrow accent="green" gap="sm">Standalone application</Eyebrow>
          <h1 class="product-title animate-fade-up">Fieldwork</h1>
          <p class="product-tagline animate-fade-up delay-100" data-accent="green">extract facts from messy sources, then prove what was reviewed</p>
          <p class="hero-copy animate-fade-up delay-200">
            Fieldwork is the local review app for work like vendor renewals,
            policy tables, public records, and research notes: source text goes
            in, typed proposals come out, and every accepted value keeps the
            excerpt, locator, reviewer decision, and recheck history that made
            it safe to use.
          </p>
          <div class="hero-actions animate-fade-up delay-300">
            <a href={sources.release} target="_blank" rel="noopener" class="btn-primary" data-umami-event="fieldwork-hero-release">Release source →</a>
            <a href={sources.readme} target="_blank" rel="noopener" class="btn-ghost" data-umami-event="fieldwork-hero-docs">Read the contract →</a>
            <a href="https://www.npmjs.com/package/@kontourai/fieldwork" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="fieldwork-hero-npm">npm</a>
          </div>
        </div>

        <Terminal class="animate-fade-in delay-300" title="credential-free quickstart">
          <pre class="code"><span class="t-com"># Node 22 · no API key needed</span>{'\n'}<span class="t-kw">npm</span> install <span class="t-str">@kontourai/fieldwork</span>{'\n'}<span class="t-kw">npm</span> exec -- fieldwork run \{'\n'}  --task node_modules/@kontourai/fieldwork/examples/generic/task.json \{'\n'}  --source node_modules/@kontourai/fieldwork/examples/generic/source.txt \{'\n'}  --json{'\n'}<span class="t-com"># open the generated review run</span>{'\n'}<span class="t-kw">npm</span> exec -- fieldwork open /path/from/runDirectory{'\n'}<span class="t-com"># approve or reject the grounded proposal, then export</span>{'\n'}<span class="t-kw">npm</span> exec -- fieldwork export /path/from/runDirectory --output reviewed.json --json</pre>
        </Terminal>
      </Split>
      <p class="quickstart-note">
        The checked-in provider is deterministic and offline, so this path needs no credential, network, or private configuration. The loopback launch URL is capability-bearing; treat it as local and do not share it. <a href={sources.readme} target="_blank" rel="noopener">Public CLI contract →</a>
      </p>
    </div>
  </Section>

  <Section size="lg" borderBottom>
    <div class="container">
      <Eyebrow accent="green" gap="sm">What the reviewer gets</Eyebrow>
      <h2 class="display-md measure-lg">A worked path from source text to reviewed data.</h2>
      <p class="body measure-lg workflow-intro">Use it when a value should not become operational data until someone can see where it came from, decide on it, and rerun the check when the source changes.</p>
      <Grid cols={5} gap="sm">
        {workflow.map(({ step, owner, body, accent }, index) => (
          <Card accent={accent} bar="top" pad="sm" class="workflow-card">
            <span class="workflow-card__number">0{index + 1}</span>
            <h3 class="workflow-card__title">{step}</h3>
            <p class="workflow-card__owner">{owner}</p>
            <p class="workflow-card__body">{body}</p>
            <a href={sources.readme} target="_blank" rel="noopener" class="workflow-card__link">Contract evidence →</a>
          </Card>
        ))}
      </Grid>
    </div>
  </Section>

  <Section tone="alt" borderBottom>
    <div class="container">
      <Eyebrow accent="green" gap="sm">Adopt it your way</Eyebrow>
      <h2 class="display-md measure-lg">Use the app today, then embed the pieces your product needs.</h2>
      <Grid cols={3} gap="lg">
        {adoptionPaths.map(({ title, accent, items }) => (
          <Card accent={accent} bar="top" pad="md">
            <h3 class="boundary-title">{title}</h3>
            <ul class="boundary-list">
              {items.map((item) => <li>{item}</li>)}
            </ul>
          </Card>
        ))}
      </Grid>
      <p class="boundary-proof"><a href={sources.readme} target="_blank" rel="noopener">Fieldwork's public host contract →</a></p>
    </div>
  </Section>

  <Section borderBottom>
    <div class="container">
      <Eyebrow accent="green" gap="sm">Repository-backed review states</Eyebrow>
      <h2 class="display-md measure-lg">A source-linked proposal can be inspected before anyone accepts it.</h2>
      <div class="fieldwork-shot-grid">
        <figure class="product-shot">
          <img src="/screenshots/fieldwork-review.png" alt="Fieldwork Grounded Review desktop view with a source inspector, extraction evidence for record status, and a Survey review workbench showing an accepted proposal." loading="lazy" />
          <figcaption>Exact desktop snapshot from Fieldwork {productBadge(fieldworkStatus)}’s public browser test: source inspection above the shared review workbench after the proposed value is accepted. <a href={sources.browser} target="_blank" rel="noopener">Source test →</a></figcaption>
        </figure>
        <figure class="product-shot fieldwork-shot--mobile">
          <img src="/screenshots/fieldwork-review-mobile.png" alt="Fieldwork Grounded Review mobile view with source filters, a proposed record status value, and visible review controls including Use proposed and Could not confirm." loading="lazy" />
          <figcaption>Exact 390px mobile snapshot from the same public browser coverage. The review actions remain visible without horizontal overflow. <a href={sources.browser} target="_blank" rel="noopener">Source test →</a></figcaption>
        </figure>
      </div>
    </div>
  </Section>

  <Section tone="alt" borderBottom>
    <div class="container">
      <Split ratio="1-1" gap="lg" align="center">
        <div>
          <Eyebrow accent="gold" gap="sm">Documents and scans</Eyebrow>
          <h2 class="display-md">Review PDF and OCR results with their layout context intact.</h2>
          <p class="body">
            Connect the parser or OCR adapter you already trust, then show page,
            layout, and table-cell context beside each proposed value. The
            adapter identity stays attached to the run, so reviewers can see
            how the source was prepared.
          </p>
          <p class="body">Fieldwork includes the review and evidence experience; PDF parsing and OCR enter through explicit adapters. If one is missing, the CLI returns a typed adapter-required result.</p>
          <a href={sources.browser} target="_blank" rel="noopener" class="handoff-link" data-umami-event="fieldwork-format-test">Inspect the format browser test →</a>
        </div>
        <figure class="product-shot">
          <img src="/screenshots/fieldwork-format-inspection.png" alt="Fieldwork Grounded Review desktop view of a format conformance fixture, showing PDF page, layout element, and table-cell context beside the proposed record status." loading="lazy" />
          <figcaption>Exact {productBadge(fieldworkStatus)} snapshot of PDF page, layout, and table-cell context carried into the inspector by an explicit format adapter.</figcaption>
        </figure>
      </Split>
    </div>
  </Section>

  <Section size="lg">
    <div class="container">
      <Eyebrow accent="green" gap="sm">What the public evidence establishes</Eyebrow>
      <h2 class="display-md measure-lg">Mechanics, interface evidence, and optional runtime execution are kept distinct.</h2>
      <Grid cols={4} gap="md">
        {evidence.map(({ title, body, href, label, accent }) => (
          <Card accent={accent} bar="top" pad="md">
            <h3 class="evidence-title">{title}</h3>
            <p class="evidence-body">{body}</p>
            <a href={href} target="_blank" rel="noopener" class="evidence-link">{label}</a>
          </Card>
        ))}
      </Grid>
    </div>
  </Section>

  <Footer active="developers" />
</Layout>

<style>
  .quickstart-note { margin: 1.5rem 0 0; color: var(--color-chalk-3); font-size: 0.82rem; line-height: 1.6; max-width: 720px; }
  .quickstart-note a, .boundary-proof a, .workflow-card__link, .evidence-link, .handoff-link { color: var(--color-green); }
  .workflow-intro { margin: 1rem 0 2rem; color: var(--color-chalk-2); }
  .workflow-card { min-height: 100%; display: flex; flex-direction: column; }
  .workflow-card__number, .workflow-card__owner { font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-chalk-3); }
  .workflow-card__title, .boundary-title, .evidence-title { margin: 0.5rem 0 0; font-size: 1rem; }
  .workflow-card__owner { color: var(--accent); margin: 0.35rem 0 0; }
  .workflow-card__body, .evidence-body { color: var(--color-chalk-2); font-size: 0.83rem; line-height: 1.55; margin: 0.85rem 0; }
  .workflow-card__link, .evidence-link, .handoff-link { font-family: var(--font-mono); font-size: 0.72rem; margin-top: auto; }
  .boundary-list { margin: 1rem 0 0; padding-left: 1.1rem; color: var(--color-chalk-2); font-size: 0.86rem; line-height: 1.6; }
  .boundary-list li + li { margin-top: 0.65rem; }
  .boundary-proof { margin: 1.5rem 0 0; font-family: var(--font-mono); font-size: 0.76rem; }
  .fieldwork-shot-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 0.34fr); gap: 1.5rem; align-items: start; margin-top: 2rem; }
  .fieldwork-shot--mobile { max-width: 390px; justify-self: center; }
  @media (max-width: 760px) {
    .fieldwork-shot-grid { grid-template-columns: 1fr; }
    .fieldwork-shot--mobile { max-width: 390px; width: 100%; }
  }
</style>
