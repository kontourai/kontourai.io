---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Terminal from '@/components/Terminal.astro';
import {
  receipts,
  badgeVariant,
  deriveReport,
  formatValue,
  GAP_TYPE_GLOSS,
  STATUS_GLOSS,
} from '@/lib/receipts';
import pkg from '../../../package.json';

// Second re-derive path (#111): versions rendered from the package.json pins,
// which check-receipts.mjs enforces and exercises on every validate run.
const hachurePin = pkg.devDependencies.hachure;
const surfacePin = pkg.dependencies['@kontourai/surface'];
const ajvPin = pkg.devDependencies.ajv;

export function getStaticPaths() {
  return receipts.map((receipt) => ({
    params: { slug: receipt.slug },
    props: { receipt },
  }));
}

const { receipt } = Astro.props;
const { bundle, provenance } = receipt;

// Everything numeric on this page comes out of the same derivation the
// advertised command runs — never out of the file's stored status strings.
const derived = deriveReport(receipt);
const counts = derived.statusCounts;
const downloadPath = `/receipts/${receipt.slug}.trust.bundle`;
const commitUrl = `https://github.com/${provenance.repo}/blob/${provenance.commit}/${provenance.path}`;

const countOf = (status: string) => counts.find((entry) => entry.status === status)?.count ?? 0;
const disputedCount = countOf('disputed') + countOf('rejected');
const blockingGaps = derived.gaps.filter((gap) => gap.blocking);

function plural(n: number, one: string, many: string): string {
  return n === 1 ? one : many;
}

const headline =
  disputedCount > 0
    ? 'The answer was no.'
    : blockingGaps.length > 0
      ? `Nothing was disputed — but ${blockingGaps.length} ${plural(blockingGaps.length, 'check is', 'checks are')} flagged as blocking, written down rather than dropped.`
      : derived.gaps.length > 0
        ? 'It came out clean, with open flags the receipt records rather than drops.'
        : 'Everything it claimed came back supported.';

const countsSentence = counts.map((entry) => `${entry.count} ${entry.status}`).join(', ');

function truncate(value: string, max = 220): string {
  if (value.length <= max) return value;
  return `${value.slice(0, max).trimEnd()}…`;
}

const claimById = new Map(derived.claims.map((claim) => [claim.id, claim]));
---

<Layout
  title={`${receipt.title} — trust receipt · Kontour AI`}
  description={receipt.summary}
>
  <Nav active="receipts" />

  <!-- Hero -->
  <Section contour size="hero" borderBottom>
    <Glow accent={receipt.accent} position="top-right" />
    <div class="container container--readable" data-accent={receipt.accent}>
      <a class="back-link" href="/receipts/">← All receipts</a>
      <Eyebrow accent={receipt.accent}>{receipt.pipeline}</Eyebrow>
      <h1 class="receipt-h1">{receipt.title}</h1>
      <p class="receipt-lead">{receipt.summary}</p>

      <div class="hero-badges">
        {counts.map((entry) => (
          <span class={`trust-badge trust-badge--${badgeVariant(entry.status)}`}>
            {entry.count} {entry.status}
          </span>
        ))}
      </div>
      <p class="badge-note">
        These are the statuses the validator works out from the evidence, not the
        ones written in the file. Run the command further down and you get this
        row back.
      </p>

      <div class="hero-actions">
        <a class="download-btn" href={downloadPath} download>Download raw .bundle</a>
        <span class="hero-meta">
          schemaVersion {bundle.schemaVersion} · {bundle.claims.length} claims ·
          {bundle.evidence.length} evidence
        </span>
      </div>
    </div>
  </Section>

  <!-- Plain-language read -->
  <Section size="lg" borderBottom tone="alt">
    <div class="container container--readable">
      <Eyebrow accent={receipt.accent} gap="sm">In plain language</Eyebrow>
      <h2 class="section-heading">What this receipt says</h2>
      <p class="section-lead read-headline">{headline}</p>

      <dl class="read-grid">
        <dt>What was checked</dt>
        <dd>
          {bundle.claims.length === 1
            ? 'One claim, about one thing — a single assertion this run makes about itself, with its own policy attached.'
            : `${bundle.claims.length} separate claims, each one a single assertion this run makes about itself — not one summary verdict you have to take or leave.`}
          {' '}The {plural(derived.claimTypes.length, 'kind', 'kinds')} of thing being claimed:
          <ul class="type-list">
            {derived.claimTypes.map((type) => (
              <li class="mono-inline">{type}</li>
            ))}
          </ul>
        </dd>

        <dt>How they came out</dt>
        <dd>
          {countsSentence}.
          <ul class="gloss-list">
            {counts.map((entry) => (
              <li>
                <span class={`trust-badge trust-badge--${badgeVariant(entry.status)}`}>
                  {entry.status}
                </span>
                <span class="gloss-text">
                  {STATUS_GLOSS[entry.status] ?? 'see the format spec for this status'}
                </span>
              </li>
            ))}
          </ul>
        </dd>

        <dt>What backs them</dt>
        <dd>
          {derived.evidenceTotal} evidence {plural(derived.evidenceTotal, 'record', 'records')}
          {' '}captured while the commands ran — {derived.evidencePassing} reporting a pass,
          {' '}{derived.evidenceFailing} reporting a failure.
          {derived.claimsWithNoSupportRecord > 0 ? (
            <Fragment>
              {' '}{derived.claimsWithNoSupportRecord}{' '}
              {plural(derived.claimsWithNoSupportRecord, 'claim carries', 'claims carry')} neither
              an evidence record nor a verification event, which is why{' '}
              {plural(derived.claimsWithNoSupportRecord, 'it', 'they')} can't come out verified.
            </Fragment>
          ) : (
            <Fragment>
              {' '}Every claim here is backed by an evidence record, a verification event, or both.
            </Fragment>
          )}
        </dd>

        <dt>What's still open</dt>
        <dd>
          {derived.gaps.length === 0 ? (
            <Fragment>
              The validator finds no transparency gaps in this file.
              {derived.highImpactUnsupported.length > 0 && (
                <Fragment>
                  {' '}It does list {derived.highImpactUnsupported.length} high-impact{' '}
                  {plural(derived.highImpactUnsupported.length, 'claim', 'claims')} as unsupported —
                  spelled out below.
                </Fragment>
              )}
            </Fragment>
          ) : (
            <Fragment>
              {derived.gaps.length} transparency {plural(derived.gaps.length, 'gap', 'gaps')}
              {blockingGaps.length > 0 ? ', blocking,' : ','} listed in full below. The receipt
              records {plural(derived.gaps.length, 'it', 'them')} rather than dropping
              {plural(derived.gaps.length, ' it', ' them')}.
            </Fragment>
          )}
        </dd>

        {derived.storedStatusMismatches > 0 && (
          <Fragment>
            <dt>Where the file and the answer differ</dt>
            <dd>
              {derived.storedStatusMismatches}{' '}
              {plural(derived.storedStatusMismatches, 'claim', 'claims')} in this file{' '}
              {plural(derived.storedStatusMismatches, 'stores', 'store')} a status the validator
              does not agree with. The stored string loses: it isn't part of the format's
              required shape, and the answer is recomputed from the evidence every time. The raw
              table below marks which {plural(derived.storedStatusMismatches, 'one', 'ones')}.
            </dd>
          </Fragment>
        )}

        <dt>What it doesn't tell you</dt>
        <dd>
          Whether the code is correct, or whether the checks that ran were the right checks. A
          receipt records what was asked, what was run, and what came back. It narrows what you
          have to take on faith; it doesn't get it to zero.
        </dd>
      </dl>
    </div>
  </Section>

  <!-- Recompute — moved up: the command is the reason to trust the rest -->
  <Section size="lg" borderBottom>
    <div class="container container--readable">
      <Eyebrow accent="green" gap="sm">Check it yourself</Eyebrow>
      <h2 class="section-heading">Recompute this exact file</h2>
      <p class="section-lead">
        Download the raw <span class="mono-inline">.bundle</span> above and run it through{' '}
        <span class="mono-inline">@kontourai/surface</span> — our implementation of the{' '}
        <a href="https://github.com/hachure-org/spec" target="_blank" rel="noopener">Hachure
        trust.bundle format</a>, an open spec we publish schemas for but don't own the
        definition of. The command prints the same status row this page shows, and exits
        non-zero if the artifact isn't a well-formed trust.bundle.
      </p>
      <Terminal title="validate this receipt">
        <div><span class="prompt">$</span> <span class="cmd">npx @kontourai/surface@{surfacePin} report \</span></div>
        <div><span class="cmd">    --input {receipt.slug}.trust.bundle --format summary</span></div>
        <div class="muted"># exit 0 prints the trust summary; a broken file exits 1</div>
      </Terminal>
      <p class="section-lead recompute-second">
        Want a second opinion from a different codebase? The{' '}
        <span class="mono-inline">hachure</span> reference CLI reads the same file against the
        spec's own schemas and reaches the same verdict. Both are still maintained by us — the
        implementations are independent, the organization behind them isn't yet.
      </p>
      <Terminal title="second opinion — the reference CLI">
        <div><span class="prompt">$</span> <span class="cmd">npx -y -p ajv@{ajvPin} -p hachure@{hachurePin} hachure validate \</span></div>
        <div><span class="cmd">    {receipt.slug}.trust.bundle</span></div>
        <div class="pass">valid TrustBundle (schemaVersion {receipt.bundle.schemaVersion})</div>
      </Terminal>
      <p class="section-lead recompute-foot">
        Prefer the library directly? The CLI just calls it:
      </p>
      <Terminal title="node — the named validator">
        <div><span class="t-kw">import</span> <span class="cmd">{'{ validateTrustBundle }'}</span> <span class="t-kw">from</span> <span class="t-str">"@kontourai/surface"</span>;</div>
        <div><span class="t-kw">import</span> <span class="cmd">{'{ readFileSync }'}</span> <span class="t-kw">from</span> <span class="t-str">"node:fs"</span>;</div>
        <div><span class="t-fn">validateTrustBundle</span>(<span class="t-fn">JSON.parse</span>(<span class="t-fn">readFileSync</span>(<span class="t-str">"{receipt.slug}.trust.bundle"</span>, <span class="t-str">"utf8"</span>)));</div>
        <div class="muted"># throws if the bundle is invalid; returns the parsed bundle otherwise</div>
      </Terminal>
    </div>
  </Section>

  <!-- Gaps -->
  <Section size="lg" borderBottom tone="alt">
    <div class="container container--readable">
      <Eyebrow accent={receipt.accent} gap="sm">Open questions</Eyebrow>
      <h2 class="section-heading">What this receipt leaves open</h2>
      <p class="section-lead">
        Straight from the validator's own <span class="mono-inline">transparencyGaps</span> and
        high-impact-unsupported lists — the same lines the command above prints. Not a count
        this site works out for itself.
      </p>

      {derived.gaps.length === 0 ? (
        <p class="section-lead gap-empty">
          <span class="trust-badge trust-badge--verified">0 transparency gaps</span>
          <span>
            Nothing contradicts anything else, no policy went unsatisfied, and no evidence has
            aged past what its policy allows.
          </span>
        </p>
      ) : (
        <ul class="gap-list">
          {derived.gaps.map((gap) => (
            <li class="gap-item">
              <div class="gap-head">
                <span class="trust-badge trust-badge--disputed">{gap.type}</span>
                <span class="gap-sev">severity {gap.severity}</span>
                {gap.blocking && <span class="gap-sev gap-sev--blocking">blocking</span>}
              </div>
              <p class="gap-detail">
                <strong>{gap.message}</strong>
                {GAP_TYPE_GLOSS[gap.type] ? ` — ${GAP_TYPE_GLOSS[gap.type]}.` : ''}
              </p>
              <p class="gap-claim">
                On the claim: “{truncate(claimById.get(gap.claimId)?.fieldOrBehavior ?? gap.claimId, 400)}”
              </p>
              <p class="gap-meta mono-inline">{truncate(gap.claimId, 140)}</p>
              {gap.policyId && <p class="gap-meta mono-inline">under policy {gap.policyId}</p>}
            </li>
          ))}
        </ul>
      )}

      {derived.highImpactUnsupported.length > 0 && (
        <div class="gap-unsupported">
          <h3 class="sub-heading">
            High-impact claims counted as unsupported ({derived.highImpactUnsupported.length})
          </h3>
          <p class="fine">
            Claims the run marked high-impact that no verified evidence stands behind. In these
            receipts that is what a disclosed waiver looks like: the run wrote down what it
            couldn't stand behind instead of leaving it out. The wording is the run's own,
            verbatim.
          </p>
          <ul class="unsupported-list">
            {derived.highImpactUnsupported.map((claim) => (
              <li>
                <span class={`trust-badge trust-badge--${badgeVariant(claim.status)}`}>
                  {claim.status}
                </span>
                <p class="unsupported-text">{truncate(claim.fieldOrBehavior, 600)}</p>
                <p class="unsupported-id mono-inline">{truncate(claim.id, 140)}</p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </Section>

  <!-- Provenance -->
  <Section size="md" borderBottom>
    <div class="container container--readable">
      <Eyebrow accent={receipt.accent} gap="sm">Provenance</Eyebrow>
      <h2 class="section-heading">Where this file came from</h2>
      <p class="prov-note">{provenance.note}</p>
      <dl class="prov-grid">
        <dt>Repository</dt>
        <dd class="mono-inline">{provenance.repo}</dd>
        <dt>Source path</dt>
        <dd class="mono-inline">{provenance.path}</dd>
        <dt>Pinned commit</dt>
        <dd class="mono-inline">
          <a href={commitUrl} target="_blank" rel="noopener">{provenance.commit}</a>
        </dd>
        <dt>Bundle source</dt>
        <dd class="mono-inline">{bundle.source}</dd>
      </dl>
      <p class="fine prov-fine">
        Recomputing tells you the file is internally consistent and hasn't been edited since.
        It doesn't tell you nobody rewrote the evidence before publishing — that's what the
        pinned commit is for. Follow it and compare.
      </p>
    </div>
  </Section>

  <!-- Evidence -->
  <Section size="lg" borderBottom tone="alt">
    <div class="container container--readable">
      <Eyebrow accent={receipt.accent} gap="sm">Evidence</Eyebrow>
      <h2 class="section-heading">
        What actually ran — {derived.evidencePassing} passing, {derived.evidenceFailing} failing
      </h2>
      <ul class="evidence-list">
        {bundle.evidence.map((item) => (
          <li class="evidence-item">
            <div class="evidence-head">
              <span class={`evidence-dot ${item.passing === false ? 'is-fail' : 'is-pass'}`}></span>
              <span class="evidence-method mono-inline">{item.method}</span>
              <span class="evidence-type">{item.evidenceType}</span>
            </div>
            <p class="evidence-summary">{truncate(item.excerptOrSummary ?? '', 320)}</p>
            <p class="evidence-source mono-inline">{item.sourceRef}</p>
          </li>
        ))}
        {bundle.evidence.length === 0 && (
          <li class="evidence-item"><p class="evidence-summary">No evidence records in this bundle.</p></li>
        )}
      </ul>
    </div>
  </Section>

  <!-- Raw claims table, demoted behind a disclosure -->
  <Section size="lg" borderBottom>
    <div class="container container--readable">
      <Eyebrow accent={receipt.accent} gap="sm">The artifact</Eyebrow>
      <h2 class="section-heading">Every claim, raw</h2>
      <p class="section-lead">
        The unedited claim list as it sits in the file. The wording is the pipeline's own
        note-taking — written for the next run, not for reading — and it's here so you can
        check that the summary above didn't quietly skip anything.
      </p>
      <details class="raw-claims">
        <summary>
          Show all {bundle.claims.length} claims{derived.storedStatusMismatches > 0
            ? ` · ${derived.storedStatusMismatches} where the file's stored status disagrees`
            : ''}
        </summary>
        <div class="table-scroll">
          <table class="claims-table">
            <thead>
              <tr>
                <th>Derived status</th>
                <th>Subject / field</th>
                <th>Type · facet</th>
                <th>Value</th>
              </tr>
            </thead>
            <tbody>
              {derived.claims.map((claim) => (
                <tr>
                  <td>
                    <span class={`trust-badge trust-badge--${badgeVariant(claim.status)}`}>
                      {claim.status}
                    </span>
                    {claim.storedStatusDiffers && (
                      <span class="stored-flag">file says “{claim.storedStatus}”</span>
                    )}
                  </td>
                  <td>
                    <span class="claim-subject mono-inline">{claim.subjectId}</span>
                    <span class="claim-field">{claim.fieldOrBehavior}</span>
                  </td>
                  <td>
                    <span class="claim-type">{claim.claimType}</span>
                    <span class="claim-facet mono-inline">{claim.facet}</span>
                  </td>
                  <td class="claim-value mono-inline">{formatValue(claim.value)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </Section>

  <!-- Next -->
  <Section size="md" tone="alt">
    <div class="container container--readable">
      <h2 class="section-heading">Next</h2>
      <div class="next-links">
        <a class="btn-ghost" href="/receipts/">← All receipts</a>
        <a class="btn-ghost" href="/flow-agents/">Where these come from</a>
        <a class="btn-ghost" href="/trust/">What this still can't catch</a>
        <a
          class="btn-ghost"
          href="https://github.com/hachure-org/spec"
          target="_blank"
          rel="noopener"
        >
          The format spec
        </a>
      </div>
    </div>
  </Section>

  <Footer />
</Layout>

<style>
  .container--readable {
    margin-inline: auto;
  }
  .mono-inline {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-chalk-2);
  }
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-chalk-3);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }
  .back-link:hover {
    color: var(--color-chalk-2);
  }
  .receipt-h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    color: var(--color-chalk);
  }
  .receipt-lead {
    color: var(--color-chalk-2);
    line-height: 1.7;
    max-width: 68ch;
    margin: 0 0 1.75rem;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }
  .badge-note {
    color: var(--color-chalk-3);
    font-size: 0.85rem;
    line-height: 1.6;
    max-width: 60ch;
    margin: 0 0 1.75rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }
  .download-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-ink);
    background: var(--accent, var(--color-gold));
    border-radius: 4px;
    padding: 0.5rem 1rem;
    text-decoration: none;
    font-weight: 500;
  }
  .download-btn:hover {
    filter: brightness(1.08);
  }
  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-chalk-3);
  }

  /* Plain-language read */
  .read-headline {
    color: var(--color-chalk);
    font-size: 1.15rem;
    margin-bottom: 2rem;
  }
  .read-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    margin: 0;
    max-width: 72ch;
  }
  .read-grid dt {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.65rem;
    color: var(--accent, var(--color-chalk-3));
    margin-top: 1.75rem;
  }
  .read-grid dt:first-of-type {
    margin-top: 0;
  }
  .read-grid dd {
    margin: 0;
    color: var(--color-chalk-2);
    line-height: 1.7;
  }
  .gloss-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .gloss-list li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    min-width: 0;
  }
  .gloss-text {
    font-size: 0.9rem;
    color: var(--color-chalk-3);
    min-width: 0;
  }

  .prov-note {
    color: var(--color-chalk-2);
    line-height: 1.7;
    max-width: 72ch;
    margin: 0 0 1.5rem;
  }
  .prov-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.25rem;
    margin: 0;
  }
  .prov-grid dt {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.65rem;
    color: var(--color-chalk-3);
    align-self: start;
    padding-top: 0.15rem;
  }
  .prov-grid dd {
    margin: 0;
    word-break: break-word;
  }
  .prov-grid a {
    color: var(--accent, var(--color-gold));
  }
  .prov-fine {
    margin: 1.5rem 0 0;
    max-width: 72ch;
  }
  .section-heading {
    font-size: 1.6rem;
    margin: 0 0 1rem;
    color: var(--color-chalk);
  }
  .sub-heading {
    font-size: 1.05rem;
    color: var(--color-chalk);
    margin: 0 0 0.5rem;
  }
  .section-lead {
    color: var(--color-chalk-2);
    line-height: 1.7;
    max-width: 70ch;
    margin: 0 0 1.75rem;
  }
  .section-lead a {
    color: var(--color-gold);
  }
  .recompute-foot {
    margin: 1.5rem 0 0.75rem;
    font-size: 0.9rem;
  }
  .recompute-second {
    margin: 1.75rem 0 0.75rem;
  }

  .raw-claims {
    border: 1px solid var(--color-edge);
    border-radius: 8px;
    background: var(--color-ink-1);
  }
  .raw-claims summary {
    cursor: pointer;
    padding: 0.9rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-chalk-2);
    line-height: 1.5;
  }
  .raw-claims summary:hover {
    color: var(--color-chalk);
  }
  .table-scroll {
    overflow-x: auto;
    border-top: 1px solid var(--color-edge);
  }
  .claims-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }
  .claims-table th {
    text-align: left;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.62rem;
    color: var(--color-chalk-3);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-edge);
    background: var(--color-ink-2);
    white-space: nowrap;
  }
  .claims-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-edge);
    vertical-align: top;
    color: var(--color-chalk-2);
  }
  .claims-table tr:last-child td {
    border-bottom: none;
  }
