---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Terminal from '@/components/Terminal.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Card from '@/components/Card.astro';
import Grid from '@/components/Grid.astro';
import Split from '@/components/Split.astro';
import ProductMark from '@/components/ProductMark.astro';
import EnforcementMatrix from '@/components/EnforcementMatrix.astro';
import { getProductStatus, productBadge } from '@/lib/product-status';
import type { Accent } from '@/lib/theme';

const flowAgentsStatus = getProductStatus('flow-agents');

const catches: { claim: string; body: string; accent: Accent }[] = [
  {
    claim: '“All tests pass.”',
    accent: 'chalk-2',
    body: 'The capture log says that command exited 1. The gate holds the “done” and shows you both lines side by side.',
  },
  {
    claim: 'npm test || true',
    accent: 'gold',
    body: 'A command that cannot fail is not evidence. A pass claimed on a laundered exit code does not count as one.',
  },
  {
    claim: '“Lint is clean now.”',
    accent: 'green',
    body: 'It is — because the agent edited .eslintrc.json. The write is refused before it lands, with a note to fix the code instead.',
  },
  {
    claim: 'git commit --no-verify',
    accent: 'cobalt-2',
    body: 'Refused at the tool call. If the hook is genuinely wrong, the fix is the hook, not a way around it.',
  },
];

const trustTiers: { title: string; body: string; accent: Accent }[] = [
  {
    title: 'While the agent works',
    accent: 'chalk-2',
    body: 'The agent sees what it still owes, and gets stopped or sent back to an earlier step when the evidence is not there. Everything it records lands in files you can open.',
  },
  {
    title: 'Then somewhere it cannot reach',
    accent: 'green',
    body: 'A clean environment reruns the declared checks and reconciles the result against what actually changed in git. For code work today, that environment is your CI.',
  },
  {
    title: 'When the evidence is missing',
    accent: 'gold',
    body: 'The work does not get called done. You can accept the gap — and that decision gets written down too, with your name on it.',
  },
];

const kits: { name: string; href: string; job: string; note: string; accent: Accent; external?: boolean }[] = [
  {
    name: 'Builder Kit',
    href: '/builder-kit/',
    accent: 'chalk-2',
    job: 'Shape the work, plan it, build it, review it, verify it, then publish with the evidence attached.',
    note: 'Ships with the engine. Start here if you are shipping code.',
  },
  {
    name: 'Knowledge Kit',
    href: '/knowledge-kit/',
    accent: 'gold',
    job: 'Notes, decisions and repo conventions stored as markdown in your repo, each one carrying where it came from and when.',
    note: 'Ships with the engine. Add it when stale context starts steering the work.',
  },
  {
    name: 'Release Evidence Kit',
    href: 'https://github.com/kontourai/flow-agents/tree/main/kits/release-evidence',
    accent: 'green',
    job: 'One gate in CI that will not pass until a trusted release-evidence claim is attached to the run.',
    note: 'Ships with the engine. No agent involved — flows only.',
    external: true,
  },
  {
    name: 'Veritas Governance Kit',
    href: '/veritas/',
    accent: 'cobalt-2',
    job: 'Turns your repo’s own standards into readiness reports and feeds them into the gates as evidence.',
    note: 'Installed separately, from the Veritas repo. Not bundled with the engine.',
  },
];
---

<Layout
  title="Flow Agents - Make your coding agent show its work · Kontour AI"
  description="Your agent says the tests pass. Flow Agents checks that against a log of what actually ran, and holds the “done” when the two disagree. It installs into the coding agent you already use."
>
  <Nav active="flow-agents" />

  <Section contour size="hero" borderBottom>
    <Glow accent="chalk-2" position="top-right" />
    <div class="container">
      <Split ratio="1-1" gap="lg" align="center">
        <div>
          <div class="hero-badges">
            <span class="trust-badge trust-badge--verified">{productBadge(flowAgentsStatus)}</span>
            <span class="install-hint">npx @kontourai/flow-agents init</span>
          </div>

          <ProductMark product="flow-agents" size={40} class="product-hero-mark animate-fade-up" data-accent="chalk-2" />
          <h1 class="product-title animate-fade-up">Flow Agents</h1>
          <p class="product-tagline animate-fade-up delay-100" data-accent="chalk-2">make your coding agent show its work — in the tools you already run</p>

          <p class="hero-copy hero-copy--wide animate-fade-up delay-200">
            Your agent says the tests pass. Flow Agents checks that claim
            against a log of what actually ran — and when the two disagree, it
            holds the “done” and shows you both. It installs into the coding
            agent you already use, so you keep your tools and the agent picks
            up the habit of leaving evidence behind.
          </p>

          <div class="hero-actions animate-fade-up delay-300">
            <a href="#install" class="btn-primary" data-umami-event="flow-agents-hero-install">Try it on one repo -></a>
            <a href="https://kontourai.github.io/flow-agents/" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="flow-agents-hero-docs">Read the docs</a>
            <a href="https://www.npmjs.com/package/@kontourai/flow-agents" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="flow-agents-hero-npm">npm package</a>
          </div>
        </div>

        <div>
          <Terminal class="animate-fade-in delay-300" title="stop hook — the agent tried to finish">
            <p class="fail">[stop-gate] Goal Fit warning:</p>
            <p class="fail term-wrap"> - .kontourai/flow-agents/false-pass evidence check unit-tests: capture
              log CONTRADICTS claimed pass — command "npm test" was recorded as
              FAIL (exitCode:1). This is a caught false-completion.</p>
            <p class="muted term-elide">… 2 further gaps on the same run, elided</p>
            <p class="fail term-wrap">[stop-gate] Stop blocked — 3 evidence gap(s) (block 1; after 3 identical
              blocks I stop blocking and hand this to you)</p>
          </Terminal>
          <p class="term-caption">
            Reproduced from the engine’s own conformance fixture
            (<code>stop-goal-fit--block-capture-contradicts-claimed-pass</code>)
            against the shipped Stop hook. The sidecar it names,{' '}
            <code>false-pass</code>, is the fixture’s slug.
          </p>
        </div>
      </Split>
    </div>
  </Section>

  <Section id="catches" size="lg">
    <div class="container">
      <Eyebrow gap="sm">What it catches</Eyebrow>
      <h2 class="display-md measure-lg section-title">Four moments you have probably already had.</h2>
      <p class="fine measure section-note">
        These are not scenarios. Each one is a check that ships in the engine
        today, quoted from the message it prints when it fires.
      </p>

      <Grid cols={4} gap="md">
        {catches.map(({ claim, body, accent }) => (
          <Card accent={accent} bar="top" pad="sm">
            <h3 class="catch-claim">{claim}</h3>
            <p class="feature-body">{body}</p>
          </Card>
        ))}
      </Grid>

      <Split ratio="1-1" gap="lg" align="center" class="catch-split">
        <Terminal title="pre-tool-use hook — refused before the write lands">
          <p class="muted">-> the agent edits .eslintrc.json</p>
          <p class="fail term-wrap">BLOCKED: Modifying .eslintrc.json is not allowed. Fix the source code to satisfy linter/formatter rules instead of weakening the config. If this is a legitimate config change, disable the config-protection hook temporarily.</p>
          <br />
          <p class="muted">-> the agent runs: git commit --no-verify -m "wip"</p>
          <p class="fail term-wrap">BLOCKED: "git commit --no-verify" bypasses git verification hooks. Verification hooks enforce project quality gates and must not be opted out. Fix the failing check instead of skipping it. If the hook is genuinely misconfigured, correct the hook configuration directly.</p>
        </Terminal>

        <div>
          <p class="body measure catch-copy">
            Both of those refusals land at the tool call, before the write or
            the command goes through. The done-check — the one that compares a
            claimed pass against the capture log — is the one that can stop a
            finish, and out of the box it blocks on Claude Code and Codex.
            Everywhere else it reports rather than refuses.
          </p>
          <p class="fine measure catch-copy">
            None of this is a correctness proof. It catches a claim the record
            contradicts and a shortcut around the checks you already have —
            nothing more. What each runtime can actually enforce differs, and
            the honest version is right below.
          </p>
          <p class="fine catch-copy--last">
            <a href="#enforcement">Where each runtime actually blocks -></a>
          </p>
        </div>
      </Split>
    </div>
  </Section>

  <Section tone="alt" borderTop borderBottom>
    <div class="container">
      <Eyebrow accent="green" gap="sm">So how was that caught?</Eyebrow>
      <h2 class="display-md measure-lg section-title">Know what ran, what passed, and what still needs a decision.</h2>
      <p class="fine measure section-note">
        Four checks ride your coding agent’s own hooks: a nudge about where the
        agent is in the work, a format-and-lint pass after each edit, an
        evidence check before it is allowed to stop, and a veto on edits to the
        configs that would weaken those checks. What they record is written to
        plain files in your repo, so it survives the chat, the context window,
        and the session.
      </p>

      <Grid cols={3} gap="lg">
        {trustTiers.map(({ title, body, accent }) => (
          <Card accent={accent} bar="top" pad="md">
            <h3 class="feature-title">{title}</h3>
            <p class="feature-body">{body}</p>
          </Card>
        ))}
      </Grid>

      <h3 id="enforcement" class="enforcement-heading">Where the gate actually blocks, per runtime</h3>
      <p class="fine measure enforcement-note">
        The same check does not have the same teeth everywhere, because not
        every runtime gives a hook the ability to stop a turn. This is where
        each one stands today.
      </p>
      <EnforcementMatrix />
    </div>
  </Section>

  <Section id="kits" borderBottom>
    <div class="container">
      <Eyebrow accent="chalk-2" gap="sm">Kits</Eyebrow>
      <h2 class="display-md measure-lg section-title">A kit is a workflow, written down.</h2>
      <p class="body measure kit-copy">
        Flow Agents on its own is a referee with no rulebook. A kit is the
        rulebook: it names the steps a piece of work goes through, what
        evidence each step has to leave behind, and what the agent is not
        allowed to skip. Install the ones you want and leave the rest out —
        the engine runs them all the same way.
      </p>

      <Grid cols={4} gap="md">
        {kits.map(({ name, href, job, note, accent, external }) => (
          <a
            class="kit-card"
            href={href}
            data-accent={accent}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener' : undefined}
          >
            <span class="kit-card__name">{name}</span>
            <span class="kit-card__job">{job}</span>
            <span class="kit-card__proof">{note}</span>
          </a>
        ))}
      </Grid>

      <p class="fine measure kit-note">
        Your own workflow can run here too: declare it in a{' '}
        <code>kit.json</code> and it goes through the same validation and the
        same gates the first-party kits do.
      </p>
    </div>
  </Section>

  <Section id="install" tone="alt" borderTop>
    <div class="container">
      <Split ratio="1-1" gap="lg" align="center">
        <div>
          <Eyebrow accent="gold" gap="sm">Try it</Eyebrow>
          <h2 class="display-md install-title">One repo, one command.</h2>
          <p class="body measure install-copy">
            Needs Node 22 or newer. It detects the coding agent you are already
            running, writes its hook scripts and kit files into the
            destination, and wires them into that agent’s config. Per-run
            working state — what the agent claimed, what the log captured,
            what is still open — goes to <code>.kontourai/flow-agents/</code>
            in the repo, as plain files you can read, diff, and delete.
          </p>
          <p class="fine measure install-copy install-copy--last">
            Nothing leaves your machine unless you point it at a Console.{' '}
            <a href="https://kontourai.github.io/flow-agents/" target="_blank" rel="noopener" data-umami-event="flow-agents-install-docs">Read the install guide -></a>
          </p>
        </div>

        <Terminal title="install">
          <p><span class="prompt">$ </span><span class="cmd">npx @kontourai/flow-agents init --dest ~/dev/my-project</span></p>
          <br />
          <p class="muted">Installed Claude Code bundle into ~/dev/my-project</p>
          <br />
          <p class="muted">Flow Agents install summary:</p>
          <p class="pass">  ✓ Runtime: claude-code (auto-detected)</p>
          <p class="pass">  ✓ Destination: ~/dev/my-project</p>
          <p class="pass">  ✓ Telemetry sink: local-files</p>
          <p class="muted">  - Console: local-only</p>
          <br />
          <p class="muted">Next steps:</p>
          <p class="muted term-wrap">  - Run your agent inside ~/dev/my-project -- Flow Agents hooks are already wired.</p>
          <p class="muted term-wrap">  - Re-run `flow-agents init` anytime to reconfigure runtime, destination, or Console connection.</p>
        </Terminal>
      </Split>
    </div>
  </Section>

  <Footer active="flow-agents" />
</Layout>

<style>
  .hero-copy--wide {
    max-width: 540px;
  }
  .section-title,
  .install-title {
    margin-bottom: 1rem;
  }
  .section-note {
    margin-bottom: 2.25rem;
  }
  .term-caption {
    margin: 0.85rem 0 0;
    color: var(--color-chalk-3);
    font-size: 0.78rem;
    line-height: 1.65;
  }
  .term-caption code {
    font-size: 0.95em;
    word-break: break-word;
  }
  /* Long verbatim hook messages wrap instead of forcing a horizontal scroll. */
  .term-wrap {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  /* Our elision marker — deliberately not styled like tool output. */
  .term-elide {
    font-style: italic;
    opacity: 0.75;
  }
  .catch-split {
    margin-top: 2.75rem;
  }
  .catch-claim {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--accent);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }
  .catch-copy {
    margin-bottom: 1rem;
  }
  .catch-copy--last {
    margin-bottom: 0;
  }
  .enforcement-heading {
    font-size: 1.15rem;
    color: var(--color-chalk);
    margin: 3rem 0 0.75rem;
    scroll-margin-top: 5rem;
  }
  .enforcement-note {
    margin-bottom: 1.5rem;
  }
  .kit-copy {
    margin-bottom: 1.75rem;
  }
  .kit-note {
    margin: 1.75rem 0 0;
  }
  .install-copy {
    margin-bottom: 1rem;
  }
  .install-copy--last {
    margin-bottom: 0;
  }
  .kit-card {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    color: inherit;
    text-decoration: none;
    background: var(--color-ink-1);
    border: 1px solid var(--color-edge);
    border-top: 2px solid var(--accent);
    border-radius: 6px;
  }
  .kit-card:hover {
    border-color: color-mix(in srgb, var(--accent) 52%, var(--color-edge));
  }
  .kit-card__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--accent);
    letter-spacing: 0;
  }
  .kit-card__job {
    color: var(--color-chalk);
    line-height: 1.55;
  }
  .kit-card__proof {
    margin-top: auto;
    color: var(--color-chalk-3);
    font-size: 0.82rem;
    line-height: 1.6;
  }
</style>
