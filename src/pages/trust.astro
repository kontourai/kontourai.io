---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Card from '@/components/Card.astro';
import Grid from '@/components/Grid.astro';
import EnforcementMatrix from '@/components/EnforcementMatrix.astro';
import type { Accent } from '@/lib/theme';

const guarantees: { label: string; body: string; formula?: string; tail?: string }[] = [
  {
    label: 'Recomputable',
    body: 'Any machine with the same evidence and the same rules re-derives the same verdict — ',
    formula: 'status = f(evidence, policy, now)',
    tail: ", a published function, not a model's opinion. It moves only where it should: evidence with a shelf life goes stale on schedule.",
  },
  {
    label: 'Captured, not narrated',
    body: "Results come from the log the harness wrote while the command ran — the actual exit code, not a summary of it — never from the model's story about the run.",
  },
  {
    label: 'Refuses or escalates',
    body: "The agent can't end a turn by asserting it's done. Either the evidence backs the claim, or the gate refuses — or it hands the decision to you. It never just proceeds.",
  },
];

const dialLevels: { level: string; title: string; accent: Accent; body: string }[] = [
  {
    level: 'L0',
    title: 'L0 — Unsigned, local.',
    accent: 'chalk-2',
    body: 'Recomputes identically to any other bundle; provenance is unverified. Five minutes to your first receipt.',
  },
  {
    level: 'L1',
    title: 'L1 — Signed by a CI identity.',
    accent: 'cobalt-2',
    body: "A level the Hachure spec defines: the record is signed with a short-lived key bound to an identity an OIDC provider asserts, such as a CI workflow's, and optionally logged in a public transparency log. A default Flow Agents setup doesn't reach it. You get it only by running Flow Agents' checkpoint seal yourself in a CI job granted id-token: write — and Flow Agents does not currently verify that signature.",
  },
  {
    level: 'L2',
    title: 'L2 — Organization-held keys.',
    accent: 'gold',
    body: 'Signing bound to keys your organization controls, for the highest-stakes work.',
  },
];

// Runtime rows render through the shared EnforcementMatrix (#110) so this
// table and the flow-agents page can't drift apart.

const ADR_0017_URL = 'https://github.com/kontourai/flow-agents/blob/main/docs/adr/0017-anti-gaming-trust-security-model.md';
const ADR_0018_URL = 'https://github.com/kontourai/flow-agents/blob/main/docs/adr/0018-freeze-local-shell-heuristics.md';
const ANTI_GAMING_SUITE_URL ='https://github.com/kontourai/flow-agents/blob/main/evals/ci/antigaming-suite.sh';
const RUNTIME_HOOK_SPEC_URL = 'https://github.com/kontourai/flow-agents/blob/main/docs/spec/runtime-hook-surface.md';
const PR_475_URL = 'https://github.com/kontourai/flow-agents/pull/475';
const CONFIG_PROTECTION_URL = 'https://github.com/kontourai/flow-agents/blob/main/scripts/hooks/config-protection.js';
const ISSUE_1008_URL = 'https://github.com/kontourai/flow-agents/issues/1008';
const ISSUE_1009_URL = 'https://github.com/kontourai/flow-agents/issues/1009';
const SURFACE_SIGSTORE_URL = 'https://github.com/kontourai/surface/blob/main/src/signing/sigstore.ts';
const VERIFIABLE_TRUST_URL = 'https://github.com/kontourai/flow-agents/blob/v8.0.0/docs/verifiable-trust.md';
const MERGE_CHANGE_URL = 'https://github.com/kontourai/flow-agents/blob/v8.0.0/src/cli/merge-change.ts';
const TRUST_RECONCILE_DECISION_URL = 'https://github.com/kontourai/flow-agents/blob/v8.0.0/docs/decisions/trust-reconcile.md';
---

<Layout
  title="Trust — what we can't certify, and four ways to cheat the gate · Kontour AI"
  description="We can't certify that an agent is right. Here's what we do instead, exactly where it stops working, and four ways someone could cheat it."
>
  <Nav />

  <!-- Section 1: Hero -->
  <Section contour size="hero" borderBottom>
    <Glow accent="chalk-2" position="top-right" />
    <div class="container container--readable">
      <Eyebrow accent="chalk-2">For the skeptic</Eyebrow>
      <h1 class="product-title animate-fade-up">We can't certify an agent is right. No one can.</h1>
      <p class="hero-copy trust-hero-copy animate-fade-up delay-200">
        An agent tells you it ran the migration test. It didn't. You find out in production. The
        problem isn't that the model was wrong — it's that nothing between its claim and your merge
        was capable of disagreeing with it. So we don't sell proof of correctness. We make what an
        answer actually stood on — and what it skipped — visible and re-checkable by anyone,
        instead of hidden behind a checkmark the model gave itself.
      </p>

      <Grid cols={3} gap="md" class="guarantee-grid animate-fade-up delay-300">
        {guarantees.map(({ label, body, formula, tail }) => (
          <div class="minicard">
            <div class="minicard__label">{label}</div>
            <p class="minicard__body">
              {body}
              {formula && <code class="mono-inline">{formula}</code>}
              {tail}
            </p>
          </div>
        ))}
      </Grid>

      <div class="hero-actions animate-fade-up delay-300">
        <a href="/early-access/" class="btn-primary" data-umami-event="trust-hero-early-access">Get early access →</a>
        <a href="/receipts/" class="btn-ghost" data-umami-event="trust-hero-receipts">Check the receipts yourself →</a>
      </div>
    </div>
  </Section>

  <!-- Section 2: The lead example — what the separation buys you -->
  <Section size="lg" borderBottom>
    <div class="container container--readable">
      <Eyebrow accent="gold">What that looks like</Eyebrow>
      <h2 class="section-heading">The security fix that almost shipped its own backdoor</h2>
      <p class="body lead-story__body">
        Flow Agents had a capture bug: on one runtime, failing commands were being recorded as
        passes. The first patch fixed it and opened a worse hole — its parser could be fooled by
        any command that merely printed <code class="mono-inline">Process exited with code 0</code>.
        A mandatory adversarial security review built a working exploit against that patch and
        confirmed it, and the fix went back. It was re-planned and reviewed again: the second
        review re-ran its own exploit, reported five new bypass probes that all failed safe, and
        the pull request merged with CI's reconciliation check green on its head.
      </p>
      <p class="body lead-story__body">
        Nothing there was caught by trusting the author. It was caught because the claim and the
        check were separable, and something was allowed to disagree. The rest of this page is how
        that separation is built — and the four places it stops working.
      </p>
      <p class="fine receipt-line">
        Receipt: <a href={PR_475_URL} target="_blank" rel="noopener">Flow Agents PR #475</a>. Its
        description records both review iterations, the critical confirmed in the first fix, and
        the second review's verdicts, including the five probes; those counts are the reviewing
        session's own report, not a committed artifact. Its Trust Reconcile check passed on the
        head commit; Flow Agents retired that CI step in 8.0.0.
      </p>
    </div>
  </Section>

  <!-- Section 3: The bypass list -->
  <Section tone="alt" size="lg" borderBottom>
    <Glow accent="cobalt-2" position="top-left" />
    <div class="container container--readable">
      <Eyebrow accent="cobalt-2">The bypass list</Eyebrow>
      <h2 class="section-heading">Four ways to cheat it — and who catches each one.</h2>
      <p class="section-lead">
        You can't judge a boundary you can't see. So here is where ours are, and where they end.
      </p>

      <div class="bypass-list">
        <div class="bypass-row" data-accent="green">
          <div class="bypass-row__head">
            <span class="bypass-row__num">01</span>
            <h3 class="bypass-row__title">Tamper with it locally.</h3>
            <span class="trust-badge trust-badge--verified">Caught</span>
          </div>
          <p class="body bypass-row__body">
            Edit the bundle, the logs, or the workflow state on your own machine. Locally, the
            evidence is a tamper-evident hash chain — break a link and the chain no longer
            verifies. But the authoritative catch isn't local. Make your pull requests' own checks
            required, and every pull request re-runs the real verification fresh on its exact head,
            in a clean environment the agent can't pre-disable. CI doesn't take the bundle's word for
            anything: a claimed pass the tests don't reproduce simply fails the check. Flow Agents'
            merge step adds the other half — it won't land a change unless the delivering session's
            evidence is committed at that same head. (Flow Agents used to ship a separate action that
            reconciled the bundle against CI, run in its own repo as{' '}
            <code class="mono-inline">Trust Reconcile</code>; 8.0.0 retired it, because the required
            checks already caught what it caught.)
          </p>
          <p class="body bypass-row__body">
            One level down, a local gate refuses an agent's direct writes to the protected workflow
            and gate files themselves. It works by reading the command before it runs — and a
            command string doesn't always say what it will do. Hardening it overnight closed a run
            of ways past it: a raw newline used as a separator, a bare <code class="mono-inline">{'&'}</code>,{' '}
            <code class="mono-inline">eval</code> with a quoted operand, a redirect placed before
            the command word, <code class="mono-inline">source</code> and <code class="mono-inline">.</code>,
            and ANSI-C <code class="mono-inline">{"$'cd'"}</code>. One class stays open, and can't be
            closed there: a directory change reached through a shell variable, an array element, a
            positional parameter or <code class="mono-inline">printf -v</code> leaves no signal in
            the string. <code class="mono-inline">X=cd; $X /path</code> is character-for-character
            identical to <code class="mono-inline">X=notcd; $X /path</code>, which doesn't change
            directory — separating the two needs values that exist only while the command runs. A
            second gap sits beside it: a redirect written inside a quoted operand, as in{' '}
            <code class="mono-inline">{'eval "echo … > <gate file>"'}</code> or{' '}
            <code class="mono-inline">{'sh -c "…"'}</code>, is never extracted as a target at all.
            Both are tracked in one open issue in the public repo. That gate raises the cost of reaching a
            protected file; it was never the boundary, and the code now says so in the file itself.
            What catches the write is what catches the rest — it breaks the local hash chain, and
            CI re-runs your declared checks fresh in an environment the agent never touched. Where
            we're taking it: stop predicting what a command will do, and check what actually
            changed, by hashing those files before and after.
          </p>
          <p class="fine bypass-row__residual">
            <em>Where this stops: a determined agent can still flip a local kill-switch through its
            own shell. That's exactly why the authority lives in CI, not in the local gate. And
            the CI catch is only authoritative once you make your checks required — installing the
            tool doesn't configure your branch protection for you. (This site's own repo requires
            its check, no-bypass — and its workflow definitions and CI scripts require owner
            review via CODEOWNERS.)</em>
          </p>
        </div>

        <div class="bypass-row" data-accent="green">
          <div class="bypass-row__head">
            <span class="bypass-row__num">02</span>
            <h3 class="bypass-row__title">Forge the content.</h3>
            <span class="trust-badge trust-badge--verified">Caught</span>
          </div>
          <p class="body bypass-row__body">
            Fabricate a green result, or launder the exit code (<code class="mono-inline">npm test || true</code>).
            Two things catch it. The local gate rejects any verify command carrying{' '}
            <code class="mono-inline">||</code>, and checks claimed passes against the log of what
            actually ran. Then the pull request's required checks re-run the real tests on its
            exact head, from the code rather than from anything the agent wrote, so a fabricated
            "green" in the bundle doesn't make a failing test pass there. Flow Agents' merge step
            only confirms that the session's evidence is complete and committed at that head;
            whether the tests pass is the required checks' call.
          </p>
          <p class="fine bypass-row__residual">
            <em>On your laptop, tampering is detectable, not impossible. It stops mattering at the
            required checks, which run where the agent can't reach: tamper-evident locally, checked
            independently in CI — never "tamper-proof." That holds only once the checks are
            required, and only for the tests they run: an edit that makes the CI workflow itself
            swallow failures is for code-owner review to catch, not a re-run.</em>
          </p>
        </div>

        <div class="bypass-row" data-accent="gold">
          <div class="bypass-row__head">
            <span class="bypass-row__num">03</span>
            <h3 class="bypass-row__title">Let a real pass go stale.</h3>
            <span class="trust-badge trust-badge--stale">Caught locally; re-run independently in CI</span>
          </div>
          <p class="body bypass-row__body">
            Run the tests, watch them pass, then keep editing. The old pass no longer advances a
            cursor-moving gate: it is bound to the revision it observed, and freshness is checked
            again before the run moves on. CI still supplies the independent clean-environment rerun. A narrowed or weakened test can survive both, so that part remains review's job. Same story if the
            agent runs one test file instead of the suite, or edits the test until it goes green —
            the gate reads what actually ran, and what actually ran was green. On the pull request
            CI closes most of this: it re-runs your required checks against the final code, and
            Flow Agents' merge step won't land the change unless the session's evidence was
            committed at that exact head.
          </p>
          <p class="fine bypass-row__residual">
            <em>Where this stops: an edited test survives the trip, because CI runs the test you
            wrote. That one is on review, not on the machine. And before the pull request exists,
            all three of these are on you.</em>
          </p>
        </div>

        <div class="bypass-row" data-accent="red">
          <div class="bypass-row__head">
            <span class="bypass-row__num">04</span>
            <h3 class="bypass-row__title">Bypass as an admin.</h3>
            <span class="trust-badge trust-badge--disputed">Named, not caught</span>
          </div>
          <p class="body bypass-row__body">
            Force-merge past branch protection, or approve your own malicious change. Nothing
            machine-side stops this, and nothing ever will. It is the irreducible human boundary —
            the one place the whole model depends on trusting a person, not a proof. What's left is
            ordinary: branch protection with enforced admins, code-owner review on the gate and CI
            config, and a human who declines the <code class="mono-inline">--admin</code> shortcut.
          </p>
        </div>
      </div>

      <p class="fine receipt-line">
        Receipt: the layered defense and its residuals are published in Flow Agents' anti-gaming
        trust security model (<a href={ADR_0017_URL} target="_blank" rel="noopener">ADR 0017</a>) —
        four of them, including two not described above: a verify command pointed at a wrapper
        script that exits 0, and writes to protected files through exotic tools the local checks
        don't enumerate. A follow-on decision (<a href={ADR_0018_URL} target="_blank" rel="noopener">ADR 0018</a>)
        freezes those local checks in place and documents two further limitations they accept.
        All of it is held there by a required{' '}
        <a href={ANTI_GAMING_SUITE_URL} target="_blank" rel="noopener">anti-gaming regression suite</a> that
        turns CI red if any gate is weakened.
      </p>

      <p class="fine receipt-line">
        Receipt: the open class is Flow Agents{' '}
        <a href={ISSUE_1009_URL} target="_blank" rel="noopener">issue #1009</a>, which also carries
        the move from prediction to content hashing; the quoted-operand gap was{' '}
        <a href={ISSUE_1008_URL} target="_blank" rel="noopener">issue #1008</a>, closed as folded
        into #1009 rather than fixed. The gate itself
        carries the limitation in its own source (<a href={CONFIG_PROTECTION_URL} target="_blank" rel="noopener">config-protection.js</a>).
        This list is what we know of today, not everything that exists.
      </p>
    </div>
  </Section>

  <!-- Section 3: Objection handler — isn't this what CI does -->
  <Section size="lg" borderBottom>
    <div class="container container--readable">
      <Eyebrow accent="cobalt-2">The objection</Eyebrow>
      <h2 class="section-heading">But isn't that what CI does?</h2>
      <p class="section-lead">
        For a code change that has a test, CI is a real backstop — it reruns the suite fresh and
        the PR goes red on a failure. We don't claim otherwise. The gap is around that.
      </p>

      <div class="bypass-list">
        <div class="bypass-row" data-accent="chalk-2">
          <div class="bypass-row__head">
            <span class="bypass-row__num">01</span>
            <h3 class="bypass-row__title">CI is green on what nobody wrote a check for.</h3>
          </div>
          <p class="body bypass-row__body">
            CI answers exactly one question — did the declared checks pass? — and is silent on
            the claim with no test behind it ("added validation and tested it," "verified the
            migration is reversible," "no security regression"). CI can't turn red on a claim it
            can't execute. We surface what was skipped, not just what passed.
          </p>
        </div>

        <div class="bypass-row" data-accent="cobalt-2">
          <div class="bypass-row__head">
            <span class="bypass-row__num">02</span>
            <h3 class="bypass-row__title">Required checks, plus exact-head evidence at merge.</h3>
          </div>
          <p class="body bypass-row__body">
            Make your own checks required and they re-run on the exact head of every pull request,
            in an environment the agent never touched, without reading anything the agent wrote.
            Flow Agents adds the other half at merge: its merge step requires the delivering
            session's evidence committed at that exact head, so the commit that merged is the
            commit the evidence was recorded against (<a href={MERGE_CHANGE_URL} target="_blank" rel="noopener">merge-change</a>).
            That is the whole of it: since 8.0.0, Flow Agents ships no CI check of its own that
            re-verifies the bundle (<a href={TRUST_RECONCILE_DECISION_URL} target="_blank" rel="noopener">why it was retired</a>).
          </p>
        </div>

        <div class="bypass-row" data-accent="gold">
          <div class="bypass-row__head">
            <span class="bypass-row__num">03</span>
            <h3 class="bypass-row__title">Before CI, in the loop.</h3>
          </div>
          <p class="body bypass-row__body">
            The check fires while the agent works, not after a push, a PR, and a CI cycle — so a
            real failure surfaces before anything leaves the laptop. If the agent claims a check
            passed but nothing captured shows it ran, the gate doesn't take the claim on faith —
            it re-runs the project's own declared check itself, right there, and a real result
            stands in place of the claim. And if the agent tries to launder the exit code
            (<code class="mono-inline">npm test || true</code>), the local gate rejects it as
            evidence on the spot — the same thing CI would catch on the PR, just earlier, before
            a push ever happens.
          </p>
        </div>
      </div>

      <p class="dial-closing">
        And every objection here assumes there's a CI at all. Agents running business
        processes — intake, research, support, records — have no CI. For them, this is the
        only check there is.
      </p>
    </div>
  </Section>

  <!-- Section 4: The assurance dial -->
  <Section size="lg" borderBottom>
    <div class="container container--readable">
      <Eyebrow accent="green">Signing is a dial, not a gate</Eyebrow>
      <h2 class="section-heading">Turn up assurance as the stakes rise.</h2>
      <p class="section-lead">
        Start unsigned and local in five minutes. Turn the dial to a CI identity's keyless
        signature, then to organization-held keys, as the stakes rise. The dial changes how much you can trust{' '}
        <em>where a bundle came from</em> — never how it was <em>derived</em>. An unsigned bundle
        recomputes to exactly the same verdict as a signed one.
      </p>

      <Grid cols={3} gap="lg" class="dial-grid">
        {dialLevels.map(({ title, accent, body }) => (
          <Card accent={accent} bar="top" pad="lg">
            <h3 class="dial-card__title">{title}</h3>
            <p class="dial-card__body">{body}</p>
          </Card>
        ))}
      </Grid>

      <p class="dial-closing">Assurance caps trust in provenance, never in derivation.</p>

      <p class="fine receipt-line">
        Receipt: the L0/L1/L2 assurance levels are defined in the open{' '}
        <a href="https://github.com/hachure-org/spec/blob/main/assurance.md" target="_blank" rel="noopener">Hachure specification</a>,
        with in-toto/DSSE and transparency-log interop. The signer is Surface's (identical in 5.0.0,
        which Flow Agents 8.0.0 depends on, and in 6.0.0): it attempts to sign when it sees{' '}
        <code class="mono-inline">GITHUB_ACTIONS</code> or <code class="mono-inline">SIGSTORE_ID_TOKEN</code>,
        and otherwise falls back to unsigned without saying so (<a href={SURFACE_SIGSTORE_URL} target="_blank" rel="noopener">source</a>).
        Flow Agents ships no workflow that grants it a token, its merge step accepts an unsigned
        checkpoint, and nothing in Flow Agents has verified a signature since the CI trust anchor
        was retired. Not to be confused with Flow Agents' own "L1" and "L2" in its{' '}
        <a href={VERIFIABLE_TRUST_URL} target="_blank" rel="noopener">verifiable-trust guide</a>, which
        name its local gate and your required CI checks, not signing levels.
      </p>
    </div>
  </Section>

  <!-- Section 5: Runtime enforcement, badged per runtime -->
  <Section tone="alt" size="lg" borderBottom>
    <Glow accent="cobalt-2" position="top-right" />
    <div class="container container--readable">
      <Eyebrow accent="cobalt-2">Runtime by runtime</Eyebrow>
      <h2 class="section-heading">Enforcement isn't uniform. Here's exactly where it blocks.</h2>
      <p class="section-lead">
        Everything above holds only as far as your runtime lets it. "Gates are laws" is true where
        a runtime hands the gate real exit codes; here is which ones do.
      </p>

      <EnforcementMatrix />

      <p class="body enforcement-closing">
        Blocking has two forms. A tool-call block refuses that action and returns the reason to the
        agent; a blocking Stop hook can keep the turn from ending on unproven work before escalating
        the decision to you. Advisory runtimes compute and surface the evidence without owning the
        final stop decision.
      </p>

      <p class="fine receipt-line">
        Receipt: the runtime hook surface is documented in the Flow Agents README /
        <a href={RUNTIME_HOOK_SPEC_URL} target="_blank" rel="noopener">runtime-hook-surface spec</a>.
        That spec grades adapters on its own L0–L2 conformance scale — a different dial from the
        signing assurance levels above.
      </p>
    </div>
  </Section>

  <!-- Section 6: The closing story + CTA pair -->
  <Section size="lg" borderTop>
    <div class="container container--readable">
      <Eyebrow accent="gold">When it mattered</Eyebrow>
      <h2 class="section-heading">The agent that refused its own admin powers</h2>

      <div class="story-grid">
        <p class="body story-card__body">
          Two green pull requests couldn't merge because branch protection demanded up-to-date
          branches, and the tooling offered <code class="mono-inline">--admin</code> to force it.
          The agent declined — admin bypass is the one boundary the whole trust model names as
          irreducible, and an agent using it would hollow out every other guarantee. The branches
          were updated properly and CI re-certified before merge. It took longer. It's also the
          only reason the rest of this page means anything.
        </p>
        <p class="fine receipt-line">
          Receipt: <a href={ADR_0017_URL} target="_blank" rel="noopener">ADR 0017</a> names admin
          bypass as the one boundary the model can't close — which is why an agent reaching for it
          is the failure, not the fix.
        </p>
      </div>

      <div class="hero-actions story-actions">
        <a href="/receipts/" class="btn-ghost" data-umami-event="trust-cta-receipts">Check the receipts yourself →</a>
        <a href="/early-access/" class="btn-primary" data-umami-event="trust-cta-early-access">Get early access →</a>
      </div>
    </div>
  </Section>

  <Footer />
</Layout>

<style>
  .container--readable {
    margin-inline: auto;
  }
  .trust-hero-copy {
    max-width: 68ch;
    margin-bottom: 2.5rem;
  }
  .mono-inline {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-chalk-2);
  }

  .guarantee-grid {
    margin-bottom: 2.5rem;
  }
  .minicard__body {
    font-size: 0.82rem;
    color: var(--color-chalk-2);
    line-height: 1.6;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .section-heading {
    font-size: 1.75rem;
    margin: 0 0 1rem;
    color: var(--color-chalk);
    max-width: 40ch;
  }
  .section-lead {
    color: var(--color-chalk-2);
    line-height: 1.7;
    max-width: 70ch;
    margin: 0 0 2rem;
  }
  .receipt-line {
    color: var(--color-chalk-3);
    line-height: 1.6;
    max-width: 72ch;
    margin: 1.75rem 0 0;
  }
  .receipt-line a {
    color: var(--color-chalk-2);
  }

  /* Bypass list */
  .bypass-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .bypass-row {
