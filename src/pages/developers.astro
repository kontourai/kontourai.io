---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Card from '@/components/Card.astro';
import Grid from '@/components/Grid.astro';
import ProofChain from '@/components/ProofChain.astro';
import Terminal from '@/components/Terminal.astro';
import { applications, kits } from '@/lib/products';
import { getProductStatus, productBadge } from '@/lib/product-status';
import type { Accent } from '@/lib/theme';
import pkg from '../../package.json';

// Validator pins rendered from package.json, same as the receipts pages
// (#111) — the advertised commands can't drift from what CI exercises.
const hachurePin = pkg.devDependencies.hachure;
const ajvPin = pkg.devDependencies.ajv;
const surfacePin = pkg.dependencies['@kontourai/surface'];

// The two paged kits come from the shared catalog copy. The two external kits
// live in their own repos, so each links to its own source — not a shared
// docs root. Their asset counts are read off their kit.json manifests.
const kitCards: { name: string; href: string; job: string; note: string; accent: Accent; external?: boolean; event: string }[] = [
  { name: 'Builder Kit', href: '/builder-kit/', accent: 'chalk-2', event: 'developers-kit-builder', job: kits[0].job, note: 'The delivery path: the agent shapes the work, builds it, has it reviewed and verified, and hands you a receipt at the end.' },
  { name: 'Knowledge Kit', href: '/knowledge-kit/', accent: 'gold', event: 'developers-kit-knowledge', job: kits[1].job, note: 'What the agent learned, kept with the source it came from, with a gate before anything gets promoted to fact.' },
  { name: 'Release Evidence Kit', href: 'https://github.com/kontourai/flow-agents/tree/main/kits/release-evidence', accent: 'green', external: true, event: 'developers-kit-release-evidence', job: 'A release gate with no agent involved.', note: 'One flow and nothing else. CI attaches an evidence claim, the gate reads it, and no agent runs at any point — proof the engine works without one.' },
  { name: 'Veritas Governance Kit', href: 'https://github.com/kontourai/veritas', accent: 'cobalt-2', external: true, event: 'developers-kit-veritas-governance', job: "Your repo's own rules, as a gate.", note: 'Two flows and three agent skills, installed from a different repo than the engine — which is the proof outside kits get no special treatment.' },
];

const applicationCards = applications.map((application) => {
  const status = getProductStatus(application.key);
  return { ...application, status, badge: productBadge(status) };
});

// Hachure is deliberately not in this list any more: it is the open format the
// whole proof story rests on, not one of our small tools. It leads the proof
// chain and has its own page.
const labRepos = [
  {
    slug: 'datum',
    label: 'Datum',
    repo: 'https://github.com/kontourai/datum',
    description:
      "Your model registry. Define providers, models, and roles once, then resolve which backend, which model, whose key, what URL. It doesn't call models for you — apart from four opt-in commands that exist to test a connection.",
  },
  {
    slug: 'bearing',
    label: 'Bearing',
    repo: 'https://github.com/kontourai/bearing',
    description:
      'Which model is actually good at what, and where that judgement came from. Compiles observations into catalog snapshots you can diff, and ranks models for a given runtime — without calling any of them.',
  },
  {
    slug: 'traverse',
    label: 'Traverse',
    repo: 'https://github.com/kontourai/traverse',
    description:
      'Pulls structured fields out of documents against a schema you supply, and hands back proposals for a person to review — each one still carrying the passage it came from.',
  },
  {
    slug: 'forage',
    label: 'Forage',
    repo: 'https://github.com/kontourai/forage',
    description:
      'Fetches untrusted URLs safely and keeps a snapshot of what came back, so a crawl can be replayed instead of re-guessed. Refuses requests aimed at your internal network.',
  },
  {
    slug: 'lookout',
    label: 'Lookout',
    repo: 'https://github.com/kontourai/lookout',
    description:
      "Watches sources you re-check over time and tells you what changed since the last look. Built on Forage's snapshots; it doesn't extract fields itself.",
  },
  {
    slug: 'ephemeris',
    label: 'Ephemeris',
    repo: 'https://github.com/kontourai/ephemeris',
    description:
      'Turns "this expires on Friday" into an event the rest of the suite can act on — a standalone freshness scheduler and event bridge. Not under active development.',
  },
  {
    slug: 'kit-research',
    label: 'Research Kit',
    repo: 'https://github.com/kontourai/kit-research',
    description:
      'A Flow Agents kit for source-traced research: capture, compile, recall, with every claim tied to where it came from.',
  },
  {
    slug: 'ui',
    label: 'Console Kit (UI)',
    repo: 'https://github.com/kontourai/ui',
    description:
      "Shared design tokens and React/web-component pieces for Kontour consoles. You only need this if you're building a console of your own.",
  },
] as const;
---

<Layout
  title="Developers — Install the Flow Agents engine, add kits, keep the receipts · Kontour AI"
  description="Start with the Flow Agents engine and its kits — Builder, Knowledge, and the agentless evidence kits — then go deeper into the disciplines it wires in: Surface trust records, Flow gates, Veritas readiness, Console projections."
>
  <Nav active="developers" />

  <Section contour size="hero" borderBottom>
    <Glow accent="gold" position="top-right" />
    <div class="container dev-hero">
      <div class="hero-badges">
        <span class="trust-badge trust-badge--proposed">developer start</span>
        <span class="install-hint">npx @kontourai/flow-agents init</span>
      </div>
      <h1 class="product-title animate-fade-up">Kontour for developers</h1>
      <p class="product-tagline animate-fade-up delay-100" data-accent="gold">install the engine, add a kit, keep the receipts</p>
      <p class="hero-copy hero-copy--wide animate-fade-up delay-200">
        Your coding agent says the tests pass. <a href="/flow-agents/">Flow
        Agents</a> installs into that agent and makes it show the work before
        it can call the job done — then writes a file recording what ran, what
        passed, and what it skipped. Anyone can re-check that file without
        trusting us or the agent. This page is the map: install it below, then
        open whichever part you want to look inside.
      </p>
      <div class="hero-actions animate-fade-up delay-300">
        <a href="#quickstart" class="btn-primary" data-umami-event="developers-hero-quickstart">Install the engine →</a>
        <a href="https://github.com/kontourai" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="developers-hero-github">Open repositories</a>
      </div>
    </div>
  </Section>

  <!-- Quickstart: real commands first, diagrams after ---------------------- -->
  <Section id="quickstart" borderBottom>
    <div class="container">
      <Eyebrow gap="sm" accent="green">Start here</Eyebrow>
      <h2 class="display-md measure-lg">Install it, then check our receipts before you believe us.</h2>
      <p class="body measure quickstart-intro">
        Two minutes: put the engine in a workspace you already use, then take
        one of our published receipts and recompute under two validators
        yourself. Both commands on the right are the ones this site's own CI
        runs on every change.
      </p>
      <Grid cols={2} gap="lg" align="start">
        <div class="quickstart-col">
          <Terminal title="install the engine + kits">
            <p><span class="prompt">$ </span><span class="cmd">npx @kontourai/flow-agents init</span></p>
            <p class="muted"># asks which agent you use, then wires it up:</p>
            <p class="muted"># Claude Code, Codex, Kiro, opencode, and pi —</p>
            <p class="muted"># gates block on Claude Code and Codex; the rest</p>
            <p class="muted"># are advisory out of the box (matrix on /trust)</p>
          </Terminal>
          <p class="fine quickstart-note">
            Know what it costs you before you paste it. It installs into the
            directory you run it in — 18 top-level entries, including a <code>README.md</code> and
            a <code>CLAUDE.md</code>. If your agent already has Flow Agents
            hooks at the user level, it warns you about the collision rather
            than quietly running everything twice. Run it at the root of a repo
            you can commit, and read the diff before you push. Nothing leaves
            your machine unless you point it at a Console.
          </p>
        </div>
        <div class="quickstart-col">
          <Terminal title="check the receipt, then check the checker">
            <p class="muted"># download a bundle from /receipts/, then read it</p>
            <p class="muted"># with our own validator</p>
            <p><span class="prompt">$ </span><span class="cmd">npx @kontourai/surface@{surfacePin} report \</span></p>
            <p><span class="cmd">    --input flow-agents-delivery.trust.bundle --format summary</span></p>
            <p class="pass">Claims: 34 (proposed: 1, assumed: 1, verified: 32)</p>
            <p>Stale: none</p>
            <p>Disputed: none</p>
            <p>Transparency gaps: 1</p>
            <p class="muted"># (the report names that gap in full — trimmed here)</p>
            <p class="muted"># now run the same file through a different</p>
            <p class="muted"># implementation, one that reads the open spec's</p>
            <p class="muted"># schemas instead. ajv is hachure's schema engine,</p>
            <p class="muted"># not a second opinion; both are pinned to the</p>
            <p class="muted"># versions CI uses.</p>
            <p><span class="prompt">$ </span><span class="cmd">npx -y -p ajv@{ajvPin} -p hachure@{hachurePin} \</span></p>
            <p><span class="cmd">    hachure validate flow-agents-delivery.trust.bundle</span></p>
            <p class="pass">valid TrustBundle (schemaVersion 5)</p>
          </Terminal>
          <p class="fine quickstart-note">
            Two implementations, one file, same verdict. Surface is ours; the <span class="mono-inline">hachure</span> CLI
            is written against <a href="/hachure/">the open format</a> instead.
            Honest scope: both are still Kontour-maintained, so that is
            implementation independence, not organizational independence.
          </p>
        </div>
      </Grid>
      <p class="fine measure quickstart-proof">
        We run this on ourselves. This site's own pull requests can't merge
        until a required <span class="mono-inline">Trust Verify</span> check
        passes, and the bundle it produces is published on <a href="/receipts/" data-umami-event="developers-quickstart-proof-receipts">the receipts page</a>.
      </p>
      <div class="quickstart-links">
        <a href="/receipts/" class="btn-ghost" data-umami-event="developers-quickstart-receipts">Download real receipts →</a>
        <a href="/trust/" class="btn-ghost" data-umami-event="developers-quickstart-trust">Read the bypass list →</a>
        <a href="https://kontourai.github.io/flow-agents/" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="developers-quickstart-docs">Engine docs →</a>
      </div>
    </div>
  </Section>

  <!-- The kits: what you actually install on the engine ------------------- -->
  <Section id="kits" tone="alt" borderTop borderBottom>
    <div class="container">
      <Eyebrow gap="sm" accent="chalk-2">The kits</Eyebrow>
      <h2 class="display-md measure-lg">Four workflows ship with it. Pick one.</h2>
      <p class="body measure kits-intro">
        A kit is a workflow the engine runs: what the steps are, what evidence
        each one has to produce, and when it stops to ask you. <a href="/flow-agents/#kits" data-umami-event="developers-kits-how">How kits work →</a>
      </p>
      <Grid min="260" gap="md">
        {kitCards.map(({ name, href, job, note, accent, external, event }) => (
          <a
            href={href}
            class="kit-card"
            data-accent={accent}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener' : undefined}
            data-umami-event={event}
          >
            <span class="kit-card__name">{name}</span>
            <span class="kit-card__job">{job}</span>
            <span class="kit-card__note">{note}</span>
            <span class="kit-card__cta">{external ? 'On GitHub →' : `Explore ${name} →`}</span>
          </a>
        ))}
      </Grid>
    </div>
  </Section>

  <!-- The one technical map: the disciplines the engine wires in ----------- -->
  <Section id="ownership" size="lg">
    <div class="container">
      <Eyebrow gap="sm">Under the hood</Eyebrow>
      <h2 class="display-md measure-lg">Everything that had to agree before that receipt said valid.</h2>
      <p class="fine measure ownership-note">
        You just validated a receipt. Everything below is what had to happen for
        that file to exist, starting with the format — which isn't ours. Take any
        one layer on its own, or let <code>init</code> assemble the whole chain
        and never look at this again.
      </p>

      <ProofChain eventPrefix="developers" />

      <p class="fine measure map-note">
        Every piece above is on npm today. Two things are preview-grade and
        say so in their own docs: the AWS Strands framework adapters, and
        conformance certification for third-party kits. Lane one is the odd one
        out — <a href="/hachure/" data-umami-event="developers-map-hachure-page">the receipt format</a> is
        published outside Kontour, so we can't quietly change what a receipt is
        allowed to say.
      </p>
    </div>
  </Section>

  <Section id="applications" tone="alt" borderTop borderBottom>
    <div class="container">
      <Eyebrow gap="sm" accent="gold-2">Built on it</Eyebrow>
      <h2 class="display-md measure-lg">Fieldwork: the whole workflow as a finished app.</h2>
      <p class="body measure applications-intro">
        It sits on that chain rather than being a link in it, which is why it
        isn't a lane in the map. Start here when you want the complete
        workflow instead of the parts.
      </p>
      <div class="application-single">
        {applicationCards.map(({ href, label, accent, repo, packageName, job, composition, status, badge, key }) => (
          <Card accent={accent} bar="top" pad="md">
            <h3 class="product-card__title">{label}</h3>
            <p class="product-card__body">{job}</p>
            <p class="application-card__composition">{composition}</p>
            <p class="application-card__status">{packageName} · {badge}</p>
            <div class="product-card__links">
              <a href={href} data-umami-event={`developers-application-${key}`}>Explore {label} →</a>
              {status.sourceUrl && <a href={status.sourceUrl} target="_blank" rel="noopener" data-umami-event={`developers-application-${key}-npm`}>npm →</a>}
              <a href={repo} target="_blank" rel="noopener" data-umami-event={`developers-application-${key}-repo`}>GitHub →</a>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </Section>

  <Section borderTop>
    <div class="container">
      <Eyebrow gap="sm">More from the lab</Eyebrow>
      <p class="fine measure lab-intro">
        Smaller pieces we built for ourselves and published anyway. Each does
        one thing, and each works without the rest.
      </p>
      <Grid min="280" gap="md">
        {labRepos.map(({ slug, label, repo, description }) => (
          <Card accent="chalk-2" pad="md">
            <h3 class="product-card__title">{label}</h3>
            <p class="product-card__body">{description}</p>
            <div class="product-card__links">
              <a href={repo} target="_blank" rel="noopener" data-umami-event={`developers-lab-${slug}-repo`}>GitHub →</a>
            </div>
          </Card>
        ))}
      </Grid>
    </div>
  </Section>

  <Section tone="alt" borderTop>
    <div class="container">
      <div class="next-links">
        <Eyebrow>Where to go next</Eyebrow>
        <a href="/flow-agents/" data-umami-event="developers-next-flow-agents">Install it and find out what a gate feels like</a>
        <a href="/receipts/" data-umami-event="developers-next-receipts">Download a real receipt and try to break it</a>
        <a href="/trust/" data-umami-event="developers-next-trust">Three ways to cheat it — and who catches each one</a>
        <a href="/memory/" data-umami-event="developers-next-memory">Already have a memory layer? Where Kontour sits next to it</a>
      </div>
    </div>
  </Section>

  <Footer active="developers" />
</Layout>

<style>
  .dev-hero {
    max-width: 820px;
  }


  .ownership-note,
  .lab-intro {
    margin: 0.8rem 0 2rem;
  }

  .map-note {
    margin: 2rem 0 0;
  }

  .map-note a {
    color: var(--color-gold);
    text-decoration: none;
  }










  .product-card__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-chalk);
    margin-bottom: 0.8rem;
  }

  .product-card__body {
    color: var(--color-chalk-2);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .product-card__links,
  .next-links {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.2rem;
  }

  .product-card__links a,
  .next-links a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-gold);
    text-decoration: none;
  }

  .next-links {
    align-content: start;
    flex-direction: column;
    padding: 1rem 0;
  }

  /* Kits section ---------------------------------------------------------- */
  .kits-intro {
    margin-bottom: 2rem;
  }

  .kits-intro a {
    color: var(--color-gold);
    text-decoration: none;
    margin-left: 0.35rem;
  }

  .applications-intro {
    margin: 0.8rem 0 2rem;
  }

  /* One application ships today, so the card is constrained rather than
     stretched across an auto-fill grid built for several. */
  .application-single {
    max-width: 620px;
  }

  .application-card__composition,
  .application-card__status {
    color: var(--color-chalk-2);
    font-size: 0.86rem;
    line-height: 1.55;
    margin-top: 0.9rem;
  }

  .application-card__status {
    color: var(--color-chalk-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .kit-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--color-edge);
    border-left: 3px solid var(--accent, var(--color-edge-2));
    background: linear-gradient(135deg, rgba(18, 22, 35, 0.92), rgba(12, 15, 25, 0.86));
    text-decoration: none;
    transition: border-color 0.18s, background 0.18s;
  }

  .kit-card:hover {
    border-color: var(--accent, var(--color-edge-2));
  }

  .kit-card__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--accent, var(--color-chalk));
  }

  .kit-card__job {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-chalk);
    letter-spacing: 0;
  }

  .kit-card__note {
    color: var(--color-chalk-2);
    font-size: 0.86rem;
    line-height: 1.55;
    flex: 1;
  }

  .kit-card__cta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent, var(--color-chalk-3));
    text-transform: uppercase;
    margin-top: 0.4rem;
  }

  /* Quickstart: real commands before diagrams. */
  .quickstart-intro {
    margin-bottom: 2rem;
  }

  .quickstart-col {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  /* Each terminal's caveats sit under it, not under the pair — the install
     cost belongs next to the install, not next to the validators. */
  .quickstart-note {
    margin: 0;
    color: var(--color-chalk-2);
  }

  .quickstart-note a {
    color: var(--color-gold);
    text-decoration: none;
  }

  .quickstart-proof {
    margin: 2rem 0 0;
  }

  .quickstart-proof a {
    color: var(--color-gold);
    text-decoration: none;
  }

  .quickstart-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
