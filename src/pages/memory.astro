---
// /memory/ merged into /knowledge-kit/ (wave 2, site/show-your-work-pass).
//
// The unique content this page carried — "you already have a memory layer, you
// don't have to replace it" — now lives on the Knowledge Kit page under
// #bring-your-own. Its spine claim ("Kontour records the sources it relied on")
// was not backed by the product and was not carried across.
//
// NOTE FOR THE ORCHESTRATOR: this is a client-side redirect placeholder only.
// The preferred mechanism is an `astro.config.mjs` `redirects` entry (that file
// is shared, so the exact diff is in the handback note). When that lands,
// DELETE this file — an Astro route and a config redirect for the same path
// collide, and the page file wins.
const target = '/knowledge-kit/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://kontourai.io${target}`} />
    <meta name="robots" content="noindex, follow" />
    <title>Moved to Knowledge Kit · Kontour AI</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>
      This page moved to <a href={target}>Knowledge Kit</a>.
    </p>
  </body>
</html>
