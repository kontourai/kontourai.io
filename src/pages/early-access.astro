---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Card from '@/components/Card.astro';
import Grid from '@/components/Grid.astro';
import Split from '@/components/Split.astro';
import Terminal from '@/components/Terminal.astro';
import Subscribe from '@/components/Subscribe.astro';
import type { Accent } from '@/lib/theme';

const lanes: { title: string; label: string; body: string; subject: string; bodyText: string; accent: Accent }[] = [
  {
    title: 'Design partner',
    label: 'AI-assisted work',
    body: 'You have a real process — intake, review, research, delivery — where the result matters more than the effort. We build the gated version with you: your acceptance criteria encoded, every output carrying evidence you can check.',
    subject: 'Kontour design partner',
    bodyText: 'I want to talk about a design partner fit for Kontour. The trust break I see is:',
    accent: 'gold',
  },
  {
    title: 'Product builder',
    label: 'Claims and evidence',
    body: 'You are building an app that makes claims and needs to show source, freshness, uncertainty, and gaps.',
    subject: 'Kontour product builder',
    bodyText: 'I am building a product that needs inspectable claims. The product is:',
    accent: 'green',
  },
  {
    title: 'Agent workflow team',
    label: 'Gates and readiness',
    body: 'You are shipping with coding agents or internal tools and want durable plans, review, verification, and release evidence.',
    subject: 'Kontour agent workflow',
    bodyText: 'I want to explore Kontour for agent workflows. The workflow I want to make inspectable is:',
    accent: 'cobalt-2',
  },
];

const mailto = (subject: string, body: string) =>
  `mailto:hello@kontourai.io?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<Layout
  title="Talk to us — design-partner work and build updates · Kontour AI"
  description="The Kontour engine is Apache-2.0 and installable today. Bring one real workflow and we build the gated version of it with you."
>
  <Nav teaser />

  <Section contour size="hero" borderBottom>
    <Glow accent="gold" position="top-right" />
    <div class="container">
      <Split ratio="1-1" gap="lg" align="center">
        <div>
          <div class="hero-badges">
            <span class="trust-badge trust-badge--verified">apache-2.0 · public on npm</span>
            <span class="install-hint">npx @kontourai/flow-agents init</span>
          </div>

          <h1 class="product-title animate-fade-up">Nothing here is gated.</h1>
          <p class="product-tagline animate-fade-up delay-100" data-accent="gold">
            The engine is free today. The conversation is about your workflow.
          </p>
          <p class="hero-copy animate-fade-up delay-200">
            An agent hands you forty pages of analysis and a green checkmark.
            You have twenty minutes and no way to tell which parts were
            actually checked. That's the moment Kontour is built for — and you
            don't need us to start. Install the engine into the coding agent
            you already run and it gates the work on evidence instead of
            promises, today, for nothing.
          </p>
          <p class="hero-copy animate-fade-up delay-200">
            The separate thing on offer here is hands-on. Bring one process you
            actually run and tell us what "done" means for it; we encode that
            as checks the work has to pass, so what comes out carries evidence
            you can re-check yourself. You judge it on outcomes you can verify,
            not a story you take on faith.
          </p>

          <div class="animate-fade-up delay-300 early-signup">
            <p class="early-signup__label">Want the occasional build update?</p>
            <Subscribe source="early-access" cta="Get build updates" event="early-access-subscribe" />
            <p class="fine early-signup__terms">
              One email when there's something real to show — no pitch sequence.
              We keep your address, the page you signed up from, the date, and
              the browser string the request carried. Ask us to delete it any
              time at hello@kontourai.io.
            </p>
            <p class="early-signup__alt">
              Ready to talk instead? <a href={mailto('Kontour design partner', 'I want to talk about a design partner fit for Kontour. The trust break I see is:')} class="early-signup__link" data-umami-event="early-access-hero-email">hello@kontourai.io</a>
              · <a href="https://github.com/kontourai" target="_blank" rel="noopener" class="early-signup__link" data-umami-event="early-access-hero-github">follow on GitHub</a>
            </p>
          </div>
        </div>

        <div class="animate-fade-in delay-300">
          <Terminal title="the free path, in one command">
            <p class="muted"># run it inside the repo you want gated</p>
            <p><span class="prompt">$ </span><span class="cmd">npx @kontourai/flow-agents init</span></p>
            <br />
            <p>Installed Claude Code bundle into ~/your-repo</p>
            <br />
            <p>Flow Agents install summary:</p>
            <p class="pass">  ✓ Runtime: claude-code (auto-detected)</p>
            <p class="pass">  ✓ Destination: ~/your-repo</p>
            <p class="pass">  ✓ Telemetry sink: local-files</p>
            <p class="muted">  - Console: local-only</p>
          </Terminal>
          <p class="try__caption">
            No key, no waitlist, no email required. Gates block on Claude Code
            and Codex; everywhere else the engine advises rather than stops the
            work. The two-command tour — install, then validate one of our own
            receipts yourself — is on the <a href="/developers/" data-umami-event="early-access-hero-developers">developers page →</a>
          </p>
        </div>
      </Split>
    </div>
  </Section>

  <!-- OWNER INPUT REQUIRED before this ships. Every `[[OWNER: …]]` token below
       is a fact only Brian has (cost, time, timeline, reply process,
       confidentiality). They are listed in the handback note. Do not guess. -->
  <Section tone="alt" borderTop size="lg">
    <div class="container container--readable">
      <Eyebrow accent="gold">What you'd be signing up for</Eyebrow>
      <h2 class="display-md send__title">One concrete workflow is enough.</h2>
      <p class="body send__copy">
        A useful first note says what the work is, who needs to trust it, what
        evidence exists today, and what currently gets missed, stale, skipped,
        or buried in chat. No procurement packet or polished brief required —
        and you don't need to send us anything confidential to start. Describe
        the shape of the work; [[OWNER: confidentiality / NDA posture — e.g.
        "we'll sign your NDA before anything specific"]].
      </p>

      <ul class="terms__list">
        <li class="terms__item" data-accent="gold">
          <strong class="terms__item-title">What you bring</strong>
          <span class="terms__item-body">
            One process you already run, and a straight answer to "what does
            done mean here?" Plus your time: [[OWNER: time commitment — e.g.
            "two or three working sessions over a couple of weeks"]].
          </span>
        </li>
        <li class="terms__item" data-accent="green">
          <strong class="terms__item-title">What you get</strong>
          <span class="terms__item-body">
            Your definition of done encoded as gates the work has to pass, and
            output carrying evidence you can re-check without taking our word
            for it. Gates refuse or escalate to you — they never silently
            proceed. You keep what we build: the engine and both kits are
            Apache-2.0, so none of it depends on us still being here.
            [[OWNER: cost posture — free while early / paid / something else]].
          </span>
        </li>
        <li class="terms__item" data-accent="cobalt-2">
          <strong class="terms__item-title">What happens after you send it</strong>
          <span class="terms__item-body">
            [[OWNER: who replies and how fast — e.g. "Brian reads every note and
            replies within a week"]]. The first conversation is
            [[OWNER: format and length — e.g. "a 30-minute call"]] about fit and
            one concrete example, not a demo. If it isn't a fit we'll say so
            rather than keep you warm.
          </span>
        </li>
      </ul>
    </div>
  </Section>

  <Section borderTop>
    <div class="container">
      <Eyebrow gap="lg">Start with the shape of the problem</Eyebrow>
      <Grid cols={3} gap="lg">
        {lanes.map(({ title, label, body, subject, bodyText, accent }) => (
          <Card accent={accent} bar="top" pad="lg">
            <div class="lane__label" data-accent={accent}>{label}</div>
            <h2 class="lane__title">{title}</h2>
            <p class="lane__body">{body}</p>
            <a href={mailto(subject, bodyText)} class="lane__link" data-accent={accent} data-umami-event={`early-access-${title.toLowerCase().replaceAll(' ', '-')}`}>Start this thread →</a>
            <span class="lane__addr">hello@kontourai.io</span>
          </Card>
        ))}
      </Grid>
      <p class="fine lanes__note">
        The same shape turns up in legal intake and conflict checks, insurance
        claims information gathering, customer-service follow-through, research
        synthesis, and investment decisioning: work with a definition of done
        where the only proof it was met is somebody's word. None of those are
        clients — they're desks where the pattern is easy to recognise.
      </p>
    </div>
  </Section>

  <Section tone="alt" borderTop size="sm">
    <div class="container container--readable">
      <Eyebrow accent="cobalt-2">The one we run on ourselves</Eyebrow>
      <h2 class="display-md ours__title">Agent-built code that earns its merge.</h2>
      <p class="body ours__copy">
        Kontour is built through its own gates, and the evidence is public
        rather than described: every bundle on the receipts page is
        downloadable and re-validatable on your machine, without trusting us
        or running anything of ours to check it.
      </p>
      <a href="/receipts/" class="btn-ghost" data-umami-event="early-access-receipts">Check the receipts →</a>
    </div>
  </Section>

  <Footer teaser />
</Layout>

<style>
  .early-signup {
    margin-top: 2rem;
  }
  .early-signup__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-chalk-2);
    margin-bottom: 0.75rem;
  }
  .early-signup__terms {
    max-width: 52ch;
    margin: 0.85rem 0 0;
    color: var(--color-chalk-3);
  }
  .early-signup__alt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-chalk-3);
    margin-top: 1.25rem;
  }
  .early-signup__link {
    color: var(--color-chalk-2);
    text-decoration: none;
  }
  .early-signup__link:hover {
    color: var(--color-chalk);
  }

  .try__caption {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--color-chalk-3);
    margin-top: 1.25rem;
    max-width: 46ch;
  }
  .try__caption a {
    color: var(--color-gold);
    text-decoration: none;
  }

  .terms__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }
  .terms__item {
    border-left: 2px solid var(--accent, var(--color-edge-2));
    padding-left: 1.2rem;
  }
  .terms__item-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--color-chalk);
    margin-bottom: 0.35rem;
  }
  .terms__item-body {
    display: block;
    color: var(--color-chalk-2);
    font-size: 0.9rem;
    line-height: 1.65;
    max-width: 68ch;
  }

  .lane__label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent);
    letter-spacing: 0;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .lane__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-chalk);
    margin-bottom: 0.75rem;
    letter-spacing: 0;
  }
  .lane__body {
    color: var(--color-chalk-2);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .lane__link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    text-decoration: none;
  }
  /* The mailto is the affordance; the address is rendered as copyable text
     beside it so a dead click (webmail, no registered handler) still leaves
     the reader with something usable. */
  .lane__addr {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-chalk-3);
    margin-top: 0.4rem;
  }
  .lanes__note {
    margin: 2.25rem 0 0;
    max-width: 72ch;
    color: var(--color-chalk-2);
  }

  .send__title {
    margin-bottom: 1.25rem;
  }
  .send__copy {
    margin-bottom: 0;
  }

  .ours__title {
    margin-bottom: 1rem;
  }
  .ours__copy {
    margin-bottom: 1.75rem;
    max-width: 66ch;
  }
</style>
