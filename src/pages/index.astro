---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Subscribe from '@/components/Subscribe.astro';
import ProofReplay from '@/components/ProofReplay.astro';

// Recognition moments (#113), ground-truthed against the flow-agents runtime
// (ops/strategy/marketing-hooks.md, 2026-07-07): every "caught by" below is a
// catch that actually exists in the shipped hooks. Ordering is deliberate —
// the backstop/memory case leads because it is both believable and
// implemented. Do NOT add moments whose catch is a named residual (stale
// pass after later edits, narrowed scope, edited tests) — those are
// disclosed as gaps in the residual line, never as catches.
const narratorMoments = [
  {
    moment: 'Said done — never actually ran it.',
    detail:
      "Long session, compacted context. The agent reports the check it remembers intending to run. Not a liar — an unreliable narrator trusting its own memory.",
    caught:
      "nothing in the log shows that command ever ran. If the project declared that check, the gate runs it itself and uses the result — not the agent's memory. If it can't, the claim is marked unverified rather than accepted.",
  },
  {
    moment: 'The summary said pass; the log said fail.',
    detail:
      'The prose wrap-up claims green; the harness-written capture recorded exit 1 while the command actually ran.',
    caught:
      'claim and capture disagree, so the turn is blocked as a caught false-completion. The narration never outranks the log.',
  },
  {
    moment: 'Masked the exit code.',
    detail: 'npm test || true, a trailing exit 0 — the command can no longer fail.',
    caught:
      "a command that masks its own exit code can't stand as evidence: the gate flags the claimed pass as untrustworthy, and CI refuses to reconcile it.",
  },
  {
    moment: 'Edited the evidence record.',
    detail: 'Hand-fix the stored result to say pass.',
    caught:
      'editing a record breaks its self-hash; the tamper-evident chain flags it.',
  },
  {
    moment: 'Made the gate green under pressure.',
    detail: 'Write whatever record turns the gate green.',
    caught:
      "status is recomputed from evidence the agent doesn't author, and CI re-runs the declared checks fresh in an environment the agent never touched.",
  },
];
---

<Layout
  title="Kontour AI — Make your agents show their work"
  description="AI writes more code than anyone can read line by line. Flow Agents puts gates in the loop, so a change arrives with the commands that actually ran and the exit codes they returned — and stops when the agent's story and the log disagree."
>
  <Nav active="home" />

  <!-- Hero: single Flow Agents headline ----------------------------------- -->
  <Section contour size="cover">
    <Glow accent="gold" position="top-center" />

    <div class="container container--hero">
      <div class="hero-inner">
        <div class="animate-fade-up hero-kicker">
          <span class="label-sm">Kontour · Flow Agents</span>
        </div>

        <h1 class="display-xl animate-fade-up delay-100 hero-title">
          Make your agents<br />show their work.
        </h1>

        <p class="lead measure animate-fade-up delay-200 hero-lead">
          AI writes more code than anyone can read line by line. Flow Agents
          puts gates in the loop, so a change arrives with the commands that
          actually ran and the exit codes they returned — and stops when the
          agent's story and the log disagree.
        </p>

        <div class="animate-fade-up delay-300 hero-actions">
          <a href="/early-access/" class="btn-primary" data-umami-event="home-hero-early-access">Get early access →</a>
          <a href="/flow-agents/" class="btn-ghost" data-umami-event="home-hero-flow-agents">How Flow Agents works</a>
          <a href="https://github.com/kontourai" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="home-hero-github">View on GitHub</a>
        </div>
      </div>
    </div>
  </Section>

  <!-- Recognition moments: the unreliable narrator (#113) ------------------ -->
  <Section tone="alt" borderTop>
    <Glow accent="cobalt-2" position="top-left" />
    <div class="container container--readable narrator">
      <Eyebrow accent="gold">The unreliable narrator</Eyebrow>
      <h2 class="display-md narrator__title">Anyone can say the tests passed.</h2>
      <p class="body measure narrator__copy">
        Agents rarely lie — they narrate. Long session, compacted context, and
        the story drifts from the log. You've probably watched all five of
        these:
      </p>

      <ul class="narrator__moments">
        {narratorMoments.map(({ moment, detail, caught }) => (
          <li class="narrator__moment">
            <p class="narrator__quote">"{moment}"</p>
            <p class="body narrator__detail">{detail}</p>
            <p class="narrator__caught"><span class="label-sm narrator__caught-label">Caught by</span> {caught}</p>
          </li>
        ))}
      </ul>

      <p class="fine narrator__residual">
        Three things this doesn't catch: a check that genuinely passed isn't
        re-invalidated when the code changes afterward, running one test file
        instead of the suite looks the same as running the suite, and an
        edited test slips through the runtime gate.{' '}
        <a href="/trust/" data-umami-event="home-narrator-trust">The full list of what gets past it →</a>
      </p>
    </div>
  </Section>

  <!-- Mechanism: claim, capture, recompute ------------------------------- -->
  <Section borderTop>
    <Glow accent="cobalt-2" position="top-right" />
    <div class="container container--readable mechanism">
      <Eyebrow accent="cobalt-2">How a gate knows</Eyebrow>
      <h2 class="display-md mechanism__title">
        Don't ask the agent.<br />Check the toothbrush.
      </h2>
      <p class="body measure mechanism__copy">
        A kid can say "I brushed my teeth" for free. The toothbrush either got
        wet or it didn't. Flow Agents treats an agent's "tests passed" the same
        way: the claim costs nothing, so it's never what a gate checks.
      </p>

      <ProofReplay />

      <ol class="mechanism__steps stack-mobile">
        <li class="mechanism__step">
          <span class="label-sm mechanism__step-label">1 · The claim</span>
          <p class="body mechanism__step-copy">The agent says "tests passed."</p>
        </li>
        <li class="mechanism__step">
          <span class="label-sm mechanism__step-label">2 · The capture</span>
          <p class="body mechanism__step-copy">
            The harness already wrote the log while the command ran — real
            exit codes, a tamper-evident record, never the model's narration.
          </p>
        </li>
        <li class="mechanism__step">
          <span class="label-sm mechanism__step-label">3 · The recompute</span>
          <p class="body mechanism__step-copy">
            Status is recomputed from the evidence. When the claim and the
            capture disagree, the turn is blocked.
          </p>
        </li>
      </ol>

      <p class="body measure mechanism__foot">
        A prompt asks an agent to be careful; a gate refuses to let the work
        pass until the evidence is there. In Claude Code and Codex, Flow Agents
        blocks the turn when a claimed pass and the recorded result disagree —
        in other runtimes it surfaces the disagreement to you instead of
        blocking. Either way, CI re-runs the same checks fresh, in an
        environment the agent never touched, before "done" counts.
      </p>
      <div class="mechanism__actions">
        <a href="/receipts/" class="btn-ghost" data-umami-event="home-mechanism-receipts">Recompute a receipt yourself →</a>
      </div>
    </div>
  </Section>

  <!-- Dogfood + peak-conviction dual CTA (#109) ---------------------------- -->
  <Section tone="alt" borderTop>
    <div class="container container--readable fork">
      <p class="body measure fork__lead">
        You don't have to take our word for any of this — this site ships
        through the same gates. Every change here merges behind a required
        check that re-runs this repo's own verification in CI and, when an
        agent published its claims, fails on any disagreement with what CI
        actually observed.
      </p>
      <div class="fork__paths">
        <div class="fork__path" data-accent="gold">
          <p class="label-sm fork__label">Convinced?</p>
          <p class="body fork__copy">
            Bring us the workflow you want to make inspectable — join as a
            design partner and we build the gated version with you.
          </p>
          <a href="/early-access/" class="btn-primary" data-umami-event="home-fork-early-access">Get early access →</a>
        </div>
        <div class="fork__path" data-accent="cobalt-2">
          <p class="label-sm fork__label">Skeptical? Good.</p>
          <p class="body fork__copy">
            The trust page leads with what we <em>can't</em> certify — and
            four ways to cheat the gate.
          </p>
          <a href="/trust/" class="btn-ghost" data-umami-event="home-fork-trust">See how to cheat it →</a>
        </div>
      </div>
    </div>
  </Section>

  <!-- Beyond code: the same rule on work that isn't code ------------------- -->
  <Section borderTop>
    <div class="container container--readable beyond">
      <Eyebrow accent="cobalt-2">Beyond code</Eyebrow>
      <h2 class="display-md beyond__title">Any work with a definition of done.</h2>
      <p class="body measure beyond__copy">
        A paralegal checks that every fact in an intake summary traces to a
        document in the file. An adjuster checks that a claim's evidence was
        actually collected, not assumed. Neither of those is code — but both
        are a list of checks, and anything that can be written down as checks
        can be gated the same way. The result arrives with the record of what
        was checked, and what wasn't.
      </p>
      <p class="body measure beyond__copy">
        We run this on our own tax filings. On the paths that check it, an
        extracted figure that can't point to the words it came from is dropped
        before it ever reaches the math.
      </p>
      <p class="body measure beyond__copy">
        Facts need the same chain code does. <strong>Survey</strong> is the
        record format for it: an extracted value stays tied to the page it came
        from, the alternatives that lost, and the reviewer who decided — so an
        answer built on it can show what it stood on instead of asking you to
        trust the tone.
      </p>
      <div class="beyond__actions">
        <a href="/survey/" class="btn-ghost" data-umami-event="home-proof-survey">How Survey produces claims →</a>
        <a href="/writing/llm-proposes-structure-verifies/" class="btn-ghost" data-umami-event="home-beyond-writing">Read the worked example →</a>
      </div>
    </div>
  </Section>

  <!-- CTA ----------------------------------------------------------------- -->
  <Section tone="alt" borderTop size="lg">
    <Glow accent="gold" position="top-center" />
    <div class="container container--readable cta">
      <Eyebrow accent="gold">Early access</Eyebrow>
      <h2 class="display-md cta__title">Tell us where trust breaks.</h2>
      <p class="body measure cta__copy">
        We're building in public. Drop your email for build updates and an early
        look — or start a design-partner conversation: bring a real process, and
        we build the checkable version of it with you.
      </p>
      <Subscribe source="home" cta="Get early access" event="home-subscribe" />
      <p class="cta__alt">
        Developer? Two commands — install the engine, verify a receipt — on the{' '}
        <a href="/developers/" class="cta__alt-link" data-umami-event="home-cta-developers">developers page →</a>
      </p>
    </div>
  </Section>

  <Footer active="home" />
</Layout>

<style>
  /* Hero ----------------------------------------------------------------- */
  .hero-inner {
    max-width: 760px;
  }
  .hero-kicker {
    margin-bottom: 2.25rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-title {
    margin-bottom: 1.5rem;
  }
  .hero-lead {
    margin-bottom: 2.5rem;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Recognition moments (#113) ------------------------------------------- */
  .narrator__title {
    margin-bottom: 1rem;
  }
  .narrator__copy {
    margin-bottom: 2.25rem;
  }
  .narrator__moments {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }
  .narrator__moment {
    border-left: 2px solid var(--color-edge-2);
    padding-left: 1.25rem;
  }
  .narrator__quote {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-chalk);
    margin: 0 0 0.4rem;
  }
  .narrator__detail {
    margin: 0 0 0.5rem;
    max-width: 66ch;
  }
  .narrator__caught {
    font-size: 0.9rem;
    color: var(--color-chalk-2);
    margin: 0;
    max-width: 70ch;
  }
  .narrator__caught-label {
    color: var(--color-green);
    margin-right: 0.35rem;
  }
  .narrator__residual {
    margin: 0;
    max-width: 72ch;
    color: var(--color-chalk-2);
  }
  .narrator__residual a {
    color: var(--color-chalk-2);
  }

  /* Mechanism -------------------------------------------------------------- */
  .mechanism__title {
    margin-bottom: 1.25rem;
  }
  .mechanism__copy {
    margin-bottom: 2rem;
  }
  .mechanism__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }
  .mechanism__step-label {
    display: block;
    margin-bottom: 0.75rem;
  }
  .mechanism__step-copy {
    margin: 0;
  }
  .mechanism__foot {
    margin-bottom: 2rem;
  }
  .mechanism__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Dogfood + peak-conviction fork (#109) -------------------------------- */
  .fork__lead {
    margin-bottom: 2.5rem;
  }
  .fork__paths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
  }
  .fork__path {
    border-left: 2px solid var(--accent, var(--color-edge-2));
    padding-left: 1.25rem;
  }
  .fork__label {
    color: var(--accent, var(--color-chalk-3));
    margin: 0 0 0.6rem;
  }
  .fork__copy {
    margin: 0 0 1.25rem;
    max-width: 46ch;
  }

  /* Beyond code ----------------------------------------------------------- */
  .beyond__title {
    margin-bottom: 1.25rem;
  }
  .beyond__copy {
    margin-bottom: 1.5rem;
  }
  .beyond__copy:last-of-type {
    margin-bottom: 2rem;
  }
  .beyond__copy strong {
    color: var(--color-chalk);
    font-weight: 500;
  }
  .beyond__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cta__title {
    margin-bottom: 1.25rem;
  }
  .cta__copy {
    margin-bottom: 2rem;
  }
  /* CTA now sits on the alt (ink-1) ground; Subscribe's input fill defaults to
     ink-1 too (tuned for a base-tone section), so bump it to ink-2 here or the
     field disappears into the section background. */
  .cta :global(.subscribe__input) {
    background: var(--color-ink-2);
  }
  .cta__alt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-chalk-3);
    margin-top: 1.5rem;
  }
  .cta__alt-link {
    color: var(--color-chalk-2);
    text-decoration: none;
  }
  .cta__alt-link:hover {
    color: var(--color-chalk);
  }
</style>
