---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Terminal from '@/components/Terminal.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import PlatformContext from '@/components/PlatformContext.astro';
import Card from '@/components/Card.astro';
import Grid from '@/components/Grid.astro';
import Split from '@/components/Split.astro';
import QuestionGrid from '@/components/QuestionGrid.astro';
import ProductMark from '@/components/ProductMark.astro';
import { getProductStatus, productBadge } from '@/lib/product-status';
import type { Accent } from '@/lib/theme';

const consoleStatus = getProductStatus('console');

const questions: { q: string; accent?: Accent }[] = [
  { q: 'What claims are true, and how fresh are they?', accent: 'gold' },
  { q: 'Which processes are running, blocked, or done?', accent: 'cobalt-2' },
  { q: 'What proof backs each answer?', accent: 'green' },
  { q: "What's in the queue and waiting on a person?", accent: 'gold-2' },
  { q: 'What decisions were made, and by whom?', accent: 'chalk-2' },
  { q: "What's stale and needs reverification?", accent: 'gold' },
  { q: 'Which exceptions were accepted?', accent: 'red' },
  { q: 'What should happen next?', accent: 'cobalt' },
];

const producers: { product: string; detail: string; accent: Accent }[] = [
  { product: 'Surface', detail: 'claim status, evidence, freshness', accent: 'gold' },
  { product: 'Survey', detail: 'fact-review records, candidates, decisions', accent: 'gold-2' },
  { product: 'Flow', detail: 'runs, gates, transitions, exceptions', accent: 'cobalt-2' },
  { product: 'Veritas', detail: 'repo readiness, evidence gaps', accent: 'green' },
  { product: 'Flow Agents', detail: 'session + continuation state', accent: 'chalk-2' },
];

const operatingBenefits: { title: string; accent: Accent; items: string[] }[] = [
  { title: 'Orient in seconds', accent: 'cobalt', items: ['See active, blocked, stale, and waiting work', 'Follow one session from start to current gate', 'Correlate claims, reviews, runs, and readiness', 'Filter the queue to what needs attention', 'Open the next action from the same screen'] },
  { title: 'Understand before acting', accent: 'chalk-2', items: ['Read the evidence behind a gate', 'See who made a decision and when', 'Inspect accepted exceptions and missing proof', 'Distinguish a live run from an old record', 'Trace every status back to its supporting event'] },
  { title: 'Start local, grow with the team', accent: 'gold', items: ['Inspect local files with no hosted dependency', 'Stream live updates into the bundled UI', 'Keep durable event history outside the dashboard', 'Connect additional product feeds over time', 'Use the same operating vocabulary in hosted deployments'] },
];

const provenance: { title: string; accent: Accent; body: string }[] = [
  { title: 'Un-fakeable at merge', accent: 'green', body: 'The trust gate fires at PR time and re-runs verification in an environment the agent never controls. "I verified everything" stops being unfalsifiable.' },
  { title: 'Permanent in git', accent: 'cobalt', body: 'The signed bundle is committed and pinned to the merge commit — distributed, tamper-evident, and available long after a dashboard view changes.' },
  { title: 'Inspectable beside the run', accent: 'gold', body: 'The Flow bridge reads a run\'s trust-bundle evidence into Console\'s trust panel, so the proof behind each gate — what was verified, how, and by whom — sits next to the run it belongs to.' },
];
---

<Layout
  title="Console — One operating plane for the suite · Kontour AI"
  description="Console shows what is live, blocked, stale, waiting, and backed by proof, with the context and next action for each session."
>
  <Nav active="console" />

  <!-- Hero -->
  <Section contour size="hero" borderBottom>
    <Glow accent="cobalt" position="top-right" />
    <div class="container">
      <Split ratio="1-1" gap="lg" align="center">
        <div>
          <PlatformContext />
          <div class="hero-badges">
            <span class="trust-badge trust-badge--verified">{productBadge(consoleStatus)}</span>
            <span class="install-hint">npm install -D @kontourai/console</span>
          </div>

          <ProductMark product="console" size={40} class="product-hero-mark animate-fade-up" data-accent="cobalt" />
          <h1 class="product-title animate-fade-up">Console</h1>
          <p class="product-tagline animate-fade-up delay-100" data-accent="cobalt">see what is live, stale, blocked, waiting, and backed by proof</p>

          <p class="hero-copy hero-copy--wide animate-fade-up delay-200">
            Console is the operating screen for work that should not disappear
            into logs: active runs, stalled gates, stale claims, review queues,
            readiness reports, proof, decisions, and next actions. Open it to
            understand what is moving now, what needs a person, and what evidence
            sits behind a session before you trust it.
          </p>

          <div class="hero-actions animate-fade-up delay-300">
            <a href="https://github.com/kontourai/console" target="_blank" rel="noopener" class="btn-primary" data-umami-event="console-hero-github">View on GitHub →</a>
            <a href="#questions" class="btn-ghost" data-umami-event="console-hero-questions">What it answers</a>
          </div>
        </div>

        <Terminal class="animate-fade-in delay-300" title="console — operating-state inspection">
          <p><span class="prompt">$ </span><span class="cmd">npx --package @kontourai/console console-inspect</span></p>
          <br />
          <p class="info">  Kontour Console operating-state inspection</p>
          <br />
          <p class="muted">  Event streams: 3</p>
          <p class="muted">  Projection snapshots: 2</p>
          <br />
          <p>  claim <span class="muted">claim-provider-directory</span>  <span class="pass">verified</span> <span class="muted">freshness=fresh</span></p>
          <p>  process <span class="muted">run-provider-118-review</span>  <span class="pass">completed</span></p>
          <p>  gate <span class="muted">gate-provider-evidence</span>  <span class="pass">passed</span></p>
          <p>  review <span class="muted">review-provider-118</span>  <span class="pass">approved</span></p>
          <p>  action <span class="muted">action-apply-provider-118</span>  <span class="warn">read-only</span></p>
          <br />
          <p class="rule">  ───────────────────────────────</p>
          <p class="pass">  Validation: errors=0</p>
          <p class="muted">  actions shown as inert descriptors only</p>
        </Terminal>
      </Split>
    </div>
  </Section>

  <!-- What Console brings together -->
  <Section id="questions" size="lg">
    <div class="container">
      <Eyebrow accent="cobalt" gap="sm">What it answers</Eyebrow>
      <h2 class="display-md measure-lg ans-title">The questions operators ask when work is moving.</h2>
      <p class="fine ans-note">
        Today, the Flow bridge follows real runs live. Other feeds are arriving
        product by product through local producer helpers and fixtures, so the
        public page stays honest about what is live while still showing the
        intended operating shape.
      </p>

      <QuestionGrid items={questions} min="260" />
    </div>
  </Section>

  <!-- The operating plane -->
  <Section tone="alt" borderTop borderBottom>
    <div class="container">
      <Split ratio="1-1.15" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt">The operating plane</Eyebrow>
          <h2 class="display-md plane__title">One screen for sessions, gates, proof, queues, and next actions.</h2>
          <p class="body plane__copy">
            Console turns product records into an operator view: a run can show
            its active step, the gate that blocks it, the proof already gathered,
            the stale claim it depends on, and the action that will move it.
          </p>
          <p class="body plane__copy plane__copy--last">
            Every item keeps a direct path to the product and action that can
            resolve it, so operators can move from “what is stuck?” to the
            right intervention without reconstructing the run. Flow feeds this
            live today through <code class="codechip" data-accent="cobalt-2">kontour-flow-bridge</code>.
          </p>
        </div>

        <Terminal title="producers → console">
          {producers.map(({ product, detail, accent }) => (
            <p><span data-accent={accent}>{product}</span>  {detail}</p>
          ))}
          <br />
          <p class="muted">  each emits → console projection + event stream</p>
          <p class="rule">  ───────────────────────────────</p>
          <p><span data-accent="cobalt">Kontour Console</span>  one correlated operating plane</p>
        </Terminal>
      </Split>
    </div>
  </Section>

  <!-- Unified work queue -->
    <Section borderBottom>
    <div class="container">
      <Eyebrow accent="cobalt" gap="sm">See it</Eyebrow>
      <figure class="product-shot">
        <img src="/screenshots/console-operating-plane.png" alt="Console local operating plane: an interactive process canvas with passed and waiting gates, claims, and an active process" loading="lazy" />
        <figcaption>The local operating plane rendering replayed cross-product streams — a Flow run drawn as an honest dependency-DAG pipeline (stages with their needs and derived readiness), gate states, claims, and the next actions in one screen.</figcaption>
      </figure>
      <figure class="product-shot">
        <img src="/screenshots/console-environment.png" alt="Console Overview: needs-you triage cards, stat tiles for processes, gates, claims, and inquiries, and a live happening-now feed" loading="lazy" />
        <figcaption>The Overview — one roll-up of everything going on: needs-you triage first, suite stats, and a live happening-now feed, derived from the same record streams.</figcaption>
      </figure>
    </div>
  </Section>

  <!-- Run it locally (#164): the reader couldn't tell this is npx-runnable today -->
  <Section tone="alt" borderTop borderBottom>
    <div class="container">
      <Split ratio="1-1" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt" gap="sm">Run it locally</Eyebrow>
          <h2 class="display-md run__title">Two commands to a live operating plane.</h2>
          <p class="body run__copy">
            The suite CLI starts the local hub with the bundled UI at
            <code class="codechip" data-accent="cobalt">127.0.0.1:3737</code> —
            loopback-only by default, token-gated beyond it, state under
            <code class="codechip" data-accent="cobalt">.kontourai/console</code>.
            Point the Flow bridge at a real run and the plane follows your
            actual gated work, no demo scripting.
          </p>
          <p class="body run__copy run__copy--last">
            The same hub publishes an OpenAPI spec for everything the UI
            renders, and speaks MCP for its usage analytics — machine-readable
            through the same contracts, no scraping.
          </p>
        </div>

        <Terminal title="suite CLI">
          <p><span class="prompt">$ </span><span class="cmd">npm install --global @kontourai/cli @kontourai/console</span></p>
          <p><span class="prompt">$ </span><span class="cmd">kontour console serve</span></p>
          <p class="pass">  hub + UI  http://127.0.0.1:3737/</p>
          <br />
          <p class="muted"># follow a live Flow run into the plane</p>
          <p><span class="prompt">$ </span><span class="cmd">kontour-flow-bridge --flow-root .kontourai/flow --watch</span></p>
        </Terminal>
      </Split>
    </div>
  </Section>

<Section size="lg">
    <div class="container">
      <Split ratio="1-1" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt">Unified work queue</Eyebrow>
          <h2 class="display-md queue__title">Everything waiting on a human,<br />in one queue.</h2>
          <p class="body queue__copy">
            Stale claims, evidence gaps, open Flow gates, Survey review items,
            reverification requests, and Veritas readiness gaps usually live in
            five different tools. The queue is the design goal: bring them into
            one suite-level view so nothing waits unseen.
          </p>
          <p class="body queue__copy queue__copy--last">
            Each item keeps a link back to the product that can resolve it. The
            view below is illustrative; Flow items arrive live via the bridge,
            while Surface, Survey, and Veritas feeds are still being wired in.
          </p>
        </div>

        <Terminal title="suite work queue — illustrative">
          <p class="warn">  stale     surface · claim-provider-directory</p>
          <p class="muted">            → request reverification</p>
          <p class="info">  open      flow · gate-provider-evidence</p>
          <p class="muted">            → review evidence, then resume run</p>
          <p><span data-accent="gold-2">  review    survey · review-provider-118-npi</span></p>
          <p class="muted">            → approve or send back a candidate</p>
          <p class="pass">  ready     veritas · change-search-filters</p>
          <p class="muted">            → merge with reduced review</p>
          <br />
          <p class="rule">  ───────────────────────────────</p>
          <p class="muted">  actions routed to the owning product</p>
        </Terminal>
      </Split>
    </div>
  </Section>

  <!-- Example use case -->
  <Section tone="alt" borderTop>
    <div class="container">
      <Split ratio="1-1" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt">Example use case</Eyebrow>
          <h2 class="display-md queue__title">A release operator sees what needs attention.</h2>
          <p class="body queue__copy">
            Before a launch, an operator opens Console and sees one stale Surface
            claim, one Flow gate blocked on missing browser evidence, and one
            Veritas readiness report that passed. Console correlates the objects
            and routes each action back to the product that can resolve it.
          </p>
          <p class="body queue__copy queue__copy--last">
            Every status keeps its supporting event and deep link, so the
            operator can move from “something is blocked” to the exact gate,
            evidence, and action that will unblock it.
          </p>
        </div>

        <Terminal title="operator attention view">
          <p class="warn">  attention  surface · claim-provider-directory stale</p>
          <p class="info">  blocked    flow · release-browser-check missing</p>
          <p class="pass">  ready      veritas · readiness-report passed</p>
          <br />
          <p class="muted">  route stale claim → Surface</p>
          <p class="muted">  route blocked gate → Flow</p>
          <p class="muted">  route readiness evidence → Veritas</p>
        </Terminal>
      </Split>
    </div>
  </Section>

  <!-- Provenance -->
  <Section borderTop borderBottom>
    <div class="container">
      <Eyebrow accent="green" gap="sm">Provenance</Eyebrow>
      <h2 class="display-md measure-lg">Trust you can query. Not trust you take on faith.</h2>
      <p class="fine ans-note">
        Every gated delivery ships a signed trust bundle — the claims that were
        made, how they were verified, and a fresh CI reconciliation — pinned
        to the merge commit. The Flow bridge brings the evidence relevant to
        each run into Console's trust panel, where you can ask what was
        verified, how, and by whom.
      </p>

      <Grid cols={3} gap="lg">
        {provenance.map(({ title, accent, body }) => (
          <Card accent={accent} pad="md">
            <h3 class="boundary__title">{title}</h3>
            <p class="body">{body}</p>
          </Card>
        ))}
      </Grid>
    </div>
  </Section>

  <!-- Operating value -->
  <Section tone="alt" borderTop borderBottom>
    <div class="container">
      <Eyebrow gap="sm">Built for daily operations</Eyebrow>
      <p class="fine boundary-note">
        Console turns scattered process events into a practical attention
        system: what changed, what is stuck, why it matters, and where to go
        next.
      </p>

      <Grid cols={3} gap="lg">
        {operatingBenefits.map(({ title, accent, items }) => (
          <Card accent={accent} pad="md">
            <h3 class="boundary__title">{title}</h3>
            <ul class="def-list">
              {items.map(item => (
                <li class="def-item">
                  <span class="def-item__dash">—</span>
                  <span class="def-item__text">{item}</span>
                </li>
              ))}
            </ul>
          </Card>
        ))}
      </Grid>
    </div>
  </Section>

  <!-- Open integration surface -->
  <Section size="lg">
    <div class="container">
      <Split ratio="1-1.15" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt">Open integration surface</Eyebrow>
          <h2 class="display-md cf__title">Use the UI.<br />Build on the same live API.</h2>
          <p class="body cf__copy">
            Event streams, identity links, queue actions, and live projections
            are available through the same contracts that power the bundled
            interface. Build a focused operator view, automate a response, or
            embed the live state in the tools your team already watches.
          </p>
          <p class="body cf__copy cf__copy--last">
            The repo ships a local read-only fixture inspector, a
            loopback event hub, local telemetry storage adapters, product
            telemetry descriptors, and a local UI that renders live suite state
            over SSE — backed by dependency-free producer helpers that write
            control-plane records under a local <code class="codechip" data-accent="cobalt">.kontourai/console</code> root.
            That open-source package is the foundation; a private production
            deployment of it runs hosted at console.kontourai.io, with OIDC
            login, per-session revocation, and a durable Postgres-backed store.
            Cross-product wiring is partial: Flow is live through the bridge;
            Surface, Survey, and Veritas feeds are still contract-stage.
          </p>
        </div>

        <Terminal title="local-producer.js">
<pre class="code code--cobalt"><span class="t-com">// write control-plane records locally — no network</span>
<span class="t-kw">const</span> {'{'} KontourEmitter, LocalFileSink {'}'} =
  <span class="t-fn">require</span>(<span class="t-str">"@kontourai/console"</span>);

<span class="t-kw">const</span> emitter = <span class="t-kw">new</span> <span class="t-fn">KontourEmitter</span>({'{'}
  sink: <span class="t-kw">new</span> <span class="t-fn">LocalFileSink</span>({'{'} root: <span class="t-str">".kontourai/console"</span> {'}'}),
{'}'});

<span class="t-kw">await</span> emitter.<span class="t-fn">emitEvent</span>({'{'}
  type: <span class="t-str">"claim.updated"</span>,
  producer: {'{'} product: <span class="t-str">"surface"</span> {'}'},
  subject: {'{'} kind: <span class="t-str">"claim"</span>, id: <span class="t-str">"claim-1"</span> {'}'},
{'}'});

<span class="t-com">// → .kontourai/console/events/ + .kontourai/console/projections/</span></pre>
        </Terminal>
      </Split>
    </div>
  </Section>

  <Section size="note" borderTop>
    <div class="container">
      <p class="closing-note">
        Kontour primitives make transparency portable. Kontour Console makes
        transparency operable — you can adopt any product without it.
      </p>
    </div>
  </Section>

  <Footer active="console" />
</Layout>

<style>
  .hero-copy--wide {
    max-width: 500px;
  }

  .ans-title {
    margin-bottom: 1rem;
  }
  .ans-note {
    max-width: 640px;
    margin-bottom: 2.5rem;
  }

  .plane__title,
  .queue__title,
  .run__title,
  .cf__title {
    margin-bottom: 1.25rem;
  }
  .plane__copy,
  .queue__copy,
  .run__copy,
  .cf__copy {
    margin-bottom: 1.5rem;
  }
  .plane__copy--last,
  .queue__copy--last,
  .run__copy--last,
  .cf__copy--last {
    margin-bottom: 0;
  }
  .strong {
    color: var(--color-chalk);
  }

  .boundary-note {
    max-width: 700px;
    margin-bottom: 2.5rem;
  }
  .boundary__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-chalk);
    margin-bottom: 1.25rem;
    letter-spacing: 0;
  }

  .closing-note {
    color: var(--color-chalk-3);
    font-size: 0.95rem;
    line-height: 1.7;
    font-style: italic;
    margin: 0;
  }
</style>
