---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Terminal from '@/components/Terminal.astro';
import Section from '@/components/Section.astro';
import Glow from '@/components/Glow.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import PlatformContext from '@/components/PlatformContext.astro';
import Card from '@/components/Card.astro';
import Grid from '@/components/Grid.astro';
import Split from '@/components/Split.astro';
import QuestionGrid from '@/components/QuestionGrid.astro';
import ProductMark from '@/components/ProductMark.astro';
import { getProductStatus, productBadge } from '@/lib/product-status';
import type { Accent } from '@/lib/theme';

const consoleStatus = getProductStatus('console');
const DOCS = 'https://kontourai.github.io/console/';

// Each of these is answered by a labelled region of the Overview shot above it.
const questions: { q: string; accent?: Accent }[] = [
  { q: 'Which run is paused, and what is it waiting for?', accent: 'gold' },
  { q: 'What is waiting on a person rather than a machine?', accent: 'gold-2' },
  { q: 'What proof sits behind a gate that says it passed?', accent: 'green' },
  { q: 'Which claim went stale underneath a run that depends on it?', accent: 'cobalt-2' },
  { q: 'What have the agents been doing, and what did it cost?', accent: 'chalk-2' },
  { q: 'What happens next, and which product does it happen in?', accent: 'cobalt' },
];

// `feed: live` = a bridge follows the product's own files as they change.
// `feed: helper` = records are written by a local producer helper you call.
const producers: { product: string; detail: string; accent: Accent; feed: 'live' | 'helper' }[] = [
  { product: 'Flow', detail: 'runs, gates, transitions, exceptions', accent: 'cobalt-2', feed: 'live' },
  { product: 'Flow Agents', detail: 'session state, blocked reasons, review waits', accent: 'chalk-2', feed: 'live' },
  { product: 'Surface', detail: 'claim status, evidence, freshness', accent: 'gold', feed: 'helper' },
  { product: 'Survey', detail: 'fact-review records, candidates, decisions', accent: 'gold-2', feed: 'helper' },
  { product: 'Veritas', detail: 'repo readiness, evidence gaps', accent: 'green', feed: 'helper' },
];

const views: { name: string; accent: Accent; body: string }[] = [
  { name: 'Overview', accent: 'cobalt', body: 'What needs you right now — paused runs, work that has not moved, and the reason each one is stuck.' },
  { name: 'Board', accent: 'cobalt-2', body: 'Every work item by stage. Open a card for the gates and the evidence sitting behind it.' },
  { name: 'Operate', accent: 'gold', body: 'One run: its pipeline, the stage it is on, and the gate holding everything downstream.' },
  { name: 'Telemetry', accent: 'chalk-2', body: 'What the agents actually did, per tool — latency, failures, and cost, rolled up by project and work item.' },
];

const operatingBenefits: { title: string; accent: Accent; items: string[] }[] = [
  { title: 'Orient in seconds', accent: 'cobalt', items: ['See active, blocked, stale, and waiting work at once', 'Follow one session from its first step to the gate it is sitting at', 'Open the next action from the same screen'] },
  { title: 'Understand before acting', accent: 'chalk-2', items: ['Read the evidence behind a gate that passed', 'See who made a decision, and when', 'Tell a live run apart from a record nobody has touched in weeks'] },
  { title: 'Start local, grow with the team', accent: 'gold', items: ['Run it against local files with nothing hosted', 'Watch the UI update live as your runs move', 'Keep the event history in your repo, outside any dashboard'] },
];
---

<Layout
  title="Console — One operating plane for the suite · Kontour AI"
  description="Console shows what is live, blocked, stale, waiting, and backed by proof, with the context and next action for each session."
>
  <Nav active="console" />

  <!-- Hero -->
  <Section contour size="hero" borderBottom>
    <Glow accent="cobalt" position="top-right" />
    <div class="container">
      <Split ratio="1-1" gap="lg" align="center">
        <div>
          <PlatformContext />
          <div class="hero-badges">
            <span class="trust-badge trust-badge--verified">{productBadge(consoleStatus)}</span>
            <span class="install-hint">npx --package @kontourai/console kontour serve</span>
          </div>

          <ProductMark product="console" size={40} class="product-hero-mark animate-fade-up" data-accent="cobalt" />
          <h1 class="product-title animate-fade-up">Console</h1>
          <p class="product-tagline animate-fade-up delay-100" data-accent="cobalt">see what is live, stale, blocked, waiting, and backed by proof</p>

          <p class="hero-copy hero-copy--wide animate-fade-up delay-200">
            Five agent sessions are running. One of them is stuck. Console is the
            screen that tells you which one, what it is waiting for, and what
            proof is sitting behind the gates that already passed — read out of
            the files your runs are writing anyway.
          </p>

          <div class="hero-actions animate-fade-up delay-300">
            <a href="#see-it" class="btn-primary" data-umami-event="console-hero-see-it">See the screen →</a>
            <a href={DOCS} target="_blank" rel="noopener" class="btn-ghost" data-umami-event="console-hero-docs">Read the docs</a>
          </div>
        </div>

        <Terminal class="animate-fade-in delay-300" title="terminal">
          <p class="t-line"><span class="prompt">$ </span><span class="cmd">npx --package @kontourai/console kontour serve</span></p>
          <p class="t-line pass">Kontour local hub: http://127.0.0.1:3737</p>
          <p class="t-line pass">Console UI:        http://127.0.0.1:3737/</p>
          <p class="t-line muted">POST /records  GET /state  GET /inspect  GET /events  GET /stream SSE</p>
        </Terminal>
      </Split>
    </div>
  </Section>

  <!-- The screen itself, before any explanation of it -->
  <Section id="see-it" size="lg">
    <div class="container">
      <Eyebrow accent="cobalt" gap="sm">What it answers</Eyebrow>
      <h2 class="display-md measure-lg ans-title">Three things need you. Here they are, by name.</h2>

      <figure class="product-shot shot--lead">
        <img src="/screenshots/console-environment.png" alt="Console Overview: needs-you triage cards, stat tiles for processes, gates, claims, and inquiries, and a live happening-now feed" loading="lazy" />
        <figcaption>
          The first screen you land on. One run is parked at the Required fields
          coverage gate, waiting for someone to record a license-number source;
          two more processes have not moved in weeks and say so. Underneath:
          what is active, which gates passed, which claims are still verified,
          and the last few things that happened, in order.
        </figcaption>
      </figure>

      <QuestionGrid items={questions} min="280" />
    </div>
  </Section>

  <!-- The operating plane -->
  <Section tone="alt" borderTop borderBottom>
    <div class="container">
      <Eyebrow accent="cobalt" gap="sm">The operating plane</Eyebrow>
      <h2 class="display-md measure-lg ans-title">One screen for sessions, gates, proof, queues, and next actions.</h2>

      <figure class="product-shot">
        <img src="/screenshots/console-operating-plane.png" alt="Console local operating plane: an interactive process canvas with passed and waiting gates, claims, and an active process" loading="lazy" />
        <figcaption>
          One run, drawn from its own records: plan and shape passed, implement
          is current, verify and publish are blocked — because the Required
          fields coverage gate is still missing license-number-source evidence.
          The gate that passed shows what it checked. The action beside it is
          marked read-only: Console reports the state of your work, it does not
          drive it. <a href={DOCS} target="_blank" rel="noopener">Explore the docs →</a>
        </figcaption>
      </figure>
    </div>
  </Section>

  <!-- Four views -->
  <Section>
    <div class="container">
      <Eyebrow accent="cobalt" gap="sm">Four views</Eyebrow>
      <h2 class="display-md measure-lg ans-title">One set of records, four ways to look at it.</h2>

      <Grid cols={4} gap="lg">
        {views.map(({ name, accent, body }) => (
          <Card accent={accent} pad="md">
            <h3 class="boundary__title">{name}</h3>
            <p class="body">{body}</p>
          </Card>
        ))}
      </Grid>
    </div>
  </Section>

  <!-- Example use case -->
  <Section tone="alt" borderTop borderBottom>
    <div class="container">
      <Eyebrow accent="cobalt" gap="sm">Example use case</Eyebrow>
      <h2 class="display-md measure-lg ans-title">A release operator sees what needs attention.</h2>
      <p class="body measure-lg use__copy">
        The afternoon before a launch, one screen: a Surface claim that has gone
        stale under a run still depending on it, a Flow gate blocked on browser
        evidence nobody attached, and a Veritas readiness report that came back
        clean. Three products, three record types, one list, sorted by what is
        actually in the way.
      </p>
      <p class="body measure-lg use__copy use__copy--last">
        Every line keeps the event that produced it and a link into the product
        that can resolve it, so the next move is a click rather than a
        reconstruction.
      </p>
    </div>
  </Section>

  <!-- Run it locally -->
  <Section id="run-it" borderBottom>
    <div class="container">
      <Split ratio="1-1" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt" gap="sm">Run it locally</Eyebrow>
          <h2 class="display-md run__title">One command. No install, no account, no cloud.</h2>
          <p class="body run__copy">
            <code class="codechip" data-accent="cobalt">kontour serve</code> starts
            the hub and the bundled UI on
            <code class="codechip" data-accent="cobalt">127.0.0.1:3737</code> —
            loopback only, token-gated if you ever expose it further, with the
            record history under
            <code class="codechip" data-accent="cobalt">.kontourai/console</code>
            in your own repo. Node 22+. If you would rather have the commands
            on your PATH,
            <code class="codechip" data-accent="cobalt">npm install -g @kontourai/console</code>
            installs the same ones.
          </p>
          <p class="body run__copy run__copy--last">
            Then point it at work you are already doing.
            <code class="codechip" data-accent="cobalt-2">kontour-flow-bridge</code>
            follows Flow runs under <code class="codechip" data-accent="cobalt-2">.kontourai/flow</code>,
            and <code class="codechip" data-accent="cobalt-2">kontour-process-bridge</code>
            follows Flow Agents sessions, including the ones sitting blocked or
            waiting on a person. Both read those files without writing to them,
            and re-running either one changes nothing — the run below is this
            site's own repo.
          </p>
        </div>

        <Terminal title="terminal">
          <p class="t-line muted"># follow the Flow runs already in this repo</p>
          <p class="t-line"><span class="prompt">$ </span><span class="cmd">npx --package @kontourai/console kontour-flow-bridge --flow-root .kontourai/flow --watch</span></p>
          <p class="t-line">kontourai-kontourai-io-208: 7 events (<span class="pass">7 accepted</span>, 0 duplicate, 0 failed)</p>
          <p class="t-line">kontourai-kontourai-io-212: 12 events (<span class="pass">12 accepted</span>, 0 duplicate, 0 failed)</p>
          <p class="t-line info">watching .kontourai/flow every 2000ms; Ctrl+C to stop</p>
          <br />
          <p class="t-line muted"># same records, read back without the UI</p>
          <p class="t-line"><span class="prompt">$ </span><span class="cmd">npx --package @kontourai/console console-inspect local .kontourai/console</span></p>
          <p class="t-line">Console local inspection</p>
          <br />
          <p class="t-line">Event streams: 1</p>
          <p class="t-line muted">- local:events/flow-bridge/project-flow-local.jsonl: events=19 accepted=19</p>
          <p class="t-line muted">  types: flow.pipeline.snapshot=2, process.progressed=15, process.started=2</p>
          <br />
          <p class="t-line">Projection snapshots: 0</p>
          <br />
          <p class="t-line pass">Validation: errors=0 warnings=0</p>
        </Terminal>
      </Split>
    </div>
  </Section>

  <!-- Where the answers come from -->
  <Section tone="alt" borderBottom>
    <div class="container">
      <Split ratio="1-1.15" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt">Where the answers come from</Eyebrow>
          <h2 class="display-md plane__title">Five products write records.<br />Console reads them.</h2>
          <p class="body plane__copy plane__copy--last">
            Flow and Flow Agents feed the screen live through their bridges
            today. Surface, Survey, and Veritas records are written by local
            producer helpers you call yourself — the record shapes are settled,
            the live feeds are landing product by product. Whichever way a
            record arrives, it keeps the identity of the product that made it,
            so a status can always be traced back to the event underneath it.
          </p>
        </div>

        <Terminal title="producers → console">
          {producers.map(({ product, detail, accent, feed }) => (
            <p class="t-line">
              <span data-accent={accent}>{product.padEnd(13)}</span>
              <span class={feed === 'live' ? 'pass' : 'muted'}>{feed.padEnd(8)}</span>
              <span class="muted">{detail}</span>
            </p>
          ))}
          <br />
          <p class="t-line muted">live    = a bridge follows the product's files as they change</p>
          <p class="t-line muted">helper  = a local producer you call writes the records</p>
          <p class="t-line rule">───────────────────────────────</p>
          <p class="t-line"><span data-accent="cobalt">Kontour Console</span>  one screen over all of them</p>
        </Terminal>
      </Split>
    </div>
  </Section>

  <!-- Provenance -->
  <Section borderBottom>
    <div class="container">
      <Eyebrow accent="green" gap="sm">Provenance</Eyebrow>
      <h2 class="display-md measure-lg ans-title">Trust you can query. Not trust you take on faith.</h2>
      <p class="body measure-lg use__copy">
        Every gated delivery ships a signed trust bundle — the claims that were
        made, how each one was verified, and a fresh reconciliation run in CI —
        alongside a checkpoint file stamped with the commit it was sealed
        against, both committed with the change. The Flow bridge brings the
        evidence relevant to each run into Console's trust panel, where you can
        ask what was verified, how, and by whom.
      </p>
      <p class="body measure-lg use__copy use__copy--last">
        Producing and signing that bundle is{' '}
        <a href="/flow-agents/">Flow Agents</a>' job. Console's job is putting
        it next to the run, so clicking a gate that says "passed" shows you the
        proof rather than the word.
      </p>
    </div>
  </Section>

  <!-- Operating value -->
  <Section tone="alt" borderBottom>
    <div class="container">
      <Eyebrow gap="sm">Built for daily operations</Eyebrow>
      <p class="fine boundary-note">
        Console turns scattered process events into something you can work
        from: what changed, what is stuck, why it matters, and where to go next.
      </p>

      <Grid cols={3} gap="lg">
        {operatingBenefits.map(({ title, accent, items }) => (
          <Card accent={accent} pad="md">
            <h3 class="boundary__title">{title}</h3>
            <ul class="def-list">
              {items.map(item => (
                <li class="def-item">
                  <span class="def-item__dash">—</span>
                  <span class="def-item__text">{item}</span>
                </li>
              ))}
            </ul>
          </Card>
        ))}
      </Grid>
    </div>
  </Section>

  <!-- Open integration surface -->
  <Section size="lg">
    <div class="container">
      <Split ratio="1-1.15" gap="md" align="center">
        <div>
          <Eyebrow accent="cobalt">Open integration surface</Eyebrow>
          <h2 class="display-md cf__title">Use the UI.<br />Build on the same live API.</h2>
          <p class="body cf__copy">
            Event streams, identity links, queue actions, and live state are
            available through the same contracts that power the bundled
            interface. Build a focused operator view, automate a response, or
            embed the live state in the tools your team already watches. The hub
            publishes a generated OpenAPI document at
            <code class="codechip" data-accent="cobalt">/openapi.json</code> for
            every endpoint the UI calls, and answers MCP on the same port, so an
            agent can ask what it has been costing you.
          </p>
          <p class="body cf__copy cf__copy--last">
            The npm package ships everything the screenshots above are running:
            the loopback hub, the bundled UI streaming live state over SSE, the
            Flow and Flow Agents bridges, the local inspector, and
            dependency-free helpers that write records under
            <code class="codechip" data-accent="cobalt">.kontourai/console</code>.
            That open-source package is the foundation; a private production
            deployment of it runs hosted at console.kontourai.io, with OIDC
            login, per-session revocation, and a durable Postgres-backed store.
          </p>
        </div>

        <Terminal title="local-producer.js">
<pre class="code code--cobalt"><span class="t-com">// write records locally — no network</span>
<span class="t-kw">const</span> {'{'} KontourEmitter, LocalFileSink {'}'} =
  <span class="t-fn">require</span>(<span class="t-str">"@kontourai/console"</span>);

<span class="t-kw">const</span> emitter = <span class="t-kw">new</span> <span class="t-fn">KontourEmitter</span>({'{'}
  sink: <span class="t-kw">new</span> <span class="t-fn">LocalFileSink</span>({'{'} root: <span class="t-str">".kontourai/console"</span> {'}'}),
{'}'});

<span class="t-kw">const</span> result = <span class="t-kw">await</span> emitter.<span class="t-fn">emitEvent</span>({'{'}
  schema: <span class="t-str">"kontour.console.event"</span>,
  version: <span class="t-str">"0.1"</span>,
  id: <span class="t-str">"event-provider-directory-updated"</span>,
  type: <span class="t-str">"claim.updated"</span>,
  occurredAt: <span class="t-str">"2026-06-01T16:00:00Z"</span>,
  producer: {'{'} product: <span class="t-str">"surface"</span>, id: <span class="t-str">"surface-console-producer"</span> {'}'},
  scope: {'{'} product: <span class="t-str">"surface"</span>, kind: <span class="t-str">"tenant"</span>, id: <span class="t-str">"acme"</span> {'}'},
  subject: {'{'} product: <span class="t-str">"surface"</span>, kind: <span class="t-str">"claim"</span>, id: <span class="t-str">"claim-provider-directory-current"</span> {'}'},
  payload: {'{}'}
{'}'});

<span class="t-com">// result.outcome === "accepted"</span>
<span class="t-com">// → .kontourai/console/events/surface-console-producer/tenant-acme.jsonl</span></pre>
        </Terminal>
      </Split>
    </div>
  </Section>

  <Section size="note" borderTop>
    <div class="container">
      <p class="closing-note">
        Every other Kontour product works fine on its own. Console is for the
        day you are running enough of them at once that you have stopped being
        able to hold it all in your head.
      </p>
      <div class="closing-actions">
        <a href="#run-it" class="btn-primary" data-umami-event="console-close-run">Run it locally</a>
        <a href={DOCS} target="_blank" rel="noopener" class="btn-ghost" data-umami-event="console-close-docs">Read the docs →</a>
        <a href="https://github.com/kontourai/console" target="_blank" rel="noopener" class="btn-ghost" data-umami-event="console-close-github">View on GitHub</a>
      </div>
    </div>
  </Section>

  <Footer active="console" />
</Layout>

<style>
  .hero-badges {
    flex-wrap: wrap;
  }
  .hero-copy--wide {
    max-width: 500px;
  }

  /* Real terminal output keeps its own leading whitespace and column
     alignment; `.terminal-body p` would otherwise collapse it. */
  .t-line {
    white-space: pre-wrap;
  }

  .ans-title {
    margin-bottom: 2rem;
  }

  .shot--lead {
    margin-bottom: 2.5rem;
  }

  .plane__title,
  .run__title,
  .cf__title {
    margin-bottom: 1.25rem;
  }
  .plane__copy,
  .run__copy,
  .cf__copy,
  .use__copy {
    margin-bottom: 1.5rem;
  }
  .plane__copy--last,
  .run__copy--last,
  .cf__copy--last,
  .use__copy--last {
    margin-bottom: 0;
  }

  .boundary-note {
    max-width: 700px;
    margin-bottom: 2.5rem;
  }
  .boundary__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-chalk);
    margin-bottom: 1.25rem;
    letter-spacing: 0;
  }

  .closing-note {
    color: var(--color-chalk-3);
    font-size: 0.95rem;
    line-height: 1.7;
    font-style: italic;
    margin: 0 0 1.75rem;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
