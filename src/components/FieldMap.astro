---
/**
 * FieldMap — the suite drawn as a surveyor's territory map.
 *
 * Every product is named for the surveyor's craft, and the map takes that
 * literally: problem domains are terrain regions (contour hills rendered on a
 * canvas), products are markers with their design-system glyphs, and Surface
 * sits at the summit because it is the reference everything else measures
 * against — the integration point for Hachure, the open trust format.
 *
 * Edge discipline, same as everywhere else on this site: a line is drawn only
 * when the relationship exists in code today.
 *  - gold route  = the grounded-knowledge pipeline (artifacts moving stage to stage)
 *  - blue arrow  = a verified point-to-point artifact flow (bundles, records, receipts)
 *  - dotted tie  = the product speaks Hachure via Surface's contract (library import;
 *                  nothing "flows through" Surface — it is a contract, not a store)
 *  - thin line   = a published package dependency
 *
 * Glyphs mirror the product marks in @kontourai/ui (24×24, stroke 1.75,
 * currentColor). Marks not yet shipped by the package are drawn here to the
 * same contract, byte-shaped to switch to package imports when it next ships —
 * the same convention ProductMark.astro documents.
 */
---

<div class="fm-scroll">
  <div class="fm-frame">
    <canvas id="fm-terrain" aria-hidden="true"></canvas>
    <svg class="fm-routes" viewBox="0 0 1000 625" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <marker id="fm-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--color-gold-2)"></path>
        </marker>
        <marker id="fm-arrow2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--color-cobalt-2)"></path>
        </marker>
      </defs>
      <!-- pipeline route -->
      <g stroke="var(--color-gold-2)" stroke-width="2" fill="none">
        <path d="M92,128 Q150,84 208,83" marker-end="url(#fm-arrow)"></path>
        <path d="M234,90 Q300,110 358,164" marker-end="url(#fm-arrow)"></path>
        <path d="M382,190 Q450,262 502,330" marker-end="url(#fm-arrow)"></path>
      </g>
      <!-- package dependencies -->
      <g stroke="var(--color-chalk-2)" stroke-width="1" fill="none" opacity="0.4">
        <path d="M310,516 L156,545"></path>
        <path d="M706,408 Q770,386 824,362"></path>
      </g>
      <!-- artifact flows: verified point-to-point movements -->
      <g stroke="var(--color-cobalt-2)" stroke-width="1.6" fill="none" opacity="0.8">
        <path d="M94,242 Q170,258 252,272" marker-end="url(#fm-arrow2)"></path>
        <path d="M108,392 L186,442" marker-end="url(#fm-arrow2)"></path>
        <path d="M212,456 L302,504" marker-end="url(#fm-arrow2)"></path>
        <path d="M318,498 Q298,390 276,292" marker-end="url(#fm-arrow2)"></path>
        <path d="M840,336 L840,254" marker-end="url(#fm-arrow2)"></path>
        <path d="M828,228 Q680,-10 496,54" marker-end="url(#fm-arrow2)"></path>
      </g>
      <!-- Hachure ties: speaks Surface's contract; nothing flows through the summit -->
      <g stroke="var(--color-chalk-3)" stroke-width="1.1" stroke-dasharray="2 4" fill="none" opacity="0.55">
        <path d="M282,282 Q390,312 490,336"></path>
        <path d="M822,352 L580,346"></path>
        <path d="M726,184 Q640,250 566,306"></path>
        <path d="M822,246 Q690,288 574,328"></path>
        <path d="M486,86 Q500,190 512,290"></path>
      </g>
    </svg>

    <span class="fm-region" style="left: 17%; top: 5%;">The Survey</span>
    <span class="fm-region" style="left: 51%; top: 3.5%;">Basecamp</span>
    <span class="fm-region" style="left: 93.5%; top: 29%;">Method</span>
    <span class="fm-region" style="left: 24%; top: 95%;">Instruments</span>
    <span class="fm-region" style="left: 82%; top: 95.5%;">Outposts</span>

    <div class="fm-mk" style="left: 8%; top: 20%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M4.5 9.5h15v9a1.5 1.5 0 0 1-1.5 1.5h-12a1.5 1.5 0 0 1-1.5-1.5Z"/><path d="M8.5 9.5V7a3.5 3.5 0 0 1 7 0v2.5"/></svg></span>
      <span class="fm-nm">forage</span><span class="fm-vb">acquire</span>
      <span class="fm-tip fm-tip-r"><span class="fm-t-role"><b>Safe, replayable crawling.</b> SSRF-pinned egress, content-addressed snapshots of the untrusted web.</span><span class="fm-t-line"><span class="fm-t-k">feeds</span>snapshots + source refs to traverse, lookout, bearing</span></span>
    </div>
    <div class="fm-mk" style="left: 22%; top: 13%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M4 18.5 9 8.5l5.5 6L20 5.5"/><circle cx="4" cy="18.5" r="1.1"/><circle cx="9" cy="8.5" r="1.1"/><circle cx="14.5" cy="14.5" r="1.1"/><circle cx="20" cy="5.5" r="1.1"/></svg></span>
      <span class="fm-nm">traverse</span><span class="fm-vb">extract</span>
      <span class="fm-tip fm-tip-s"><span class="fm-t-role"><b>Schema-directed extraction.</b> Every proposed value carries the exact source span that grounds it.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>extraction proposals (Survey's shape) &rarr; fieldwork</span><span class="fm-t-line"><span class="fm-t-k">uses</span>forage</span></span>
    </div>
    <div class="fm-mk" style="left: 37%; top: 28%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="5.5"/><path d="M14 14 19.5 19.5"/><path d="M7.6 9H12.4"/><path d="M7.6 11.2H11.2"/></svg></span>
      <span class="fm-nm">survey</span><span class="fm-vb">review</span>
      <span class="fm-tip"><span class="fm-t-role"><b>Review contracts &mdash; and the bundle constructor.</b> Proposals become reviewed, attributable decisions; <code>buildSurveyTrustBundle</code> mints the TrustBundle on behalf of its consumers.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>TrustBundle &rarr; Surface shape</span><span class="fm-t-line"><span class="fm-t-k">uses</span>surface</span></span>
    </div>
    <div class="fm-mk fm-summit" style="left: 52%; top: 55%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M12 3.5 20.5 8 12 12.5 3.5 8Z"/><path d="M3.5 12 12 16.5 20.5 12"/><path d="M3.5 16 12 20.5 20.5 16"/></svg></span>
      <span class="fm-nm">surface</span><span class="fm-vb"><a href="/hachure/" data-umami-event="fieldmap-hachure">hachure format</a></span>
      <span class="fm-tip"><span class="fm-t-role"><b>The trust kernel &mdash; a contract and library, not a store.</b> No bytes pass through it. Implements <a href="/hachure/">Hachure</a>, the open trust format: TrustBundle / Claim / Evidence types, validation, claim folding, trust reports, and the trust-panel web component.</span><span class="fm-t-line"><span class="fm-t-k">consumed by</span>survey, flow, veritas, fieldwork, console</span></span>
    </div>
    <div class="fm-mk" style="left: 8%; top: 38%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M3.5 12S7 6.5 12 6.5 20.5 12 20.5 12 17 17.5 12 17.5 3.5 12 3.5 12Z"/><circle cx="12" cy="12" r="2.5"/></svg></span>
      <span class="fm-nm">lookout</span><span class="fm-vb">watch drift</span>
      <span class="fm-tip fm-tip-r"><span class="fm-t-role"><b>Source registry + drift checks</b> on forage snapshots. Unchanged bytes skip the model entirely; only what moved re-enters review.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>drift observations &rarr; fieldwork recheck</span><span class="fm-t-line"><span class="fm-t-k">uses</span>forage, traverse, datum</span></span>
    </div>
    <div class="fm-mk" style="left: 27%; top: 44%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M8.5 3.5v17"/><path d="M8.5 4.9 18 8.2 8.5 11.5Z"/><path d="M4.5 20.5h9"/></svg></span>
      <span class="fm-nm">fieldwork</span><span class="fm-vb">runs the line</span>
      <span class="fm-tip"><span class="fm-t-role"><b>Grounded extraction review, end to end.</b> The one place the whole pipeline runs in a single process: acquire &rarr; extract &rarr; review &rarr; validated TrustBundle export per run.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>validated TrustBundle (run receipt)</span><span class="fm-t-line"><span class="fm-t-k">uses</span>forage, traverse, survey, surface, lookout, datum, dispatch, relay</span></span>
    </div>

    <div class="fm-mk" style="left: 10%; top: 62%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M15 9l-2 4.5L9 15l2-4.5Z"/></svg></span>
      <span class="fm-nm">bearing</span><span class="fm-vb">capability</span>
      <span class="fm-tip fm-tip-r"><span class="fm-t-role"><b>Evidence-backed model capability observations.</b> Even &ldquo;model X is good at Y&rdquo; is a snapshot-backed claim; catalogs + runtime-aware ranking.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>catalog snapshots &rarr; datum, dispatch</span><span class="fm-t-line"><span class="fm-t-k">uses</span>forage</span></span>
    </div>
    <div class="fm-mk" style="left: 20%; top: 72%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M12 5.5 18 16H6Z"/><circle cx="12" cy="3.6" r="1"/><path d="M4 19.5h16"/></svg></span>
      <span class="fm-nm">datum</span><span class="fm-vb">registry</span>
      <span class="fm-tip fm-tip-r"><span class="fm-t-role"><b>The model registry.</b> Which provider, which model, whose key &mdash; resolved from bearing's capability catalog. Never makes a call itself.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>model policy &rarr; dispatch, lookout, fieldwork</span><span class="fm-t-line"><span class="fm-t-k">uses</span>bearing</span></span>
    </div>
    <div class="fm-mk" style="left: 32%; top: 82%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M20.5 3.5 10.5 13.5"/><path d="M20.5 3.5 14 20.5l-3.5-7-7-3.5Z"/></svg></span>
      <span class="fm-nm">dispatch</span><span class="fm-vb">route + receipt</span>
      <span class="fm-tip"><span class="fm-t-role"><b>Policy-aware model execution.</b> Routing, budgets, fallbacks &mdash; and a receipt for every call.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>receipts &rarr; fieldwork, flow-agents</span><span class="fm-t-line"><span class="fm-t-k">uses</span>relay, datum</span></span>
    </div>
    <div class="fm-mk" style="left: 14%; top: 88%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M4.5 9h11"/><path d="M12.5 5.5 16 9l-3.5 3.5"/><path d="M19.5 15h-11"/><path d="M11.5 18.5 8 15l3.5-3.5"/></svg></span>
      <span class="fm-nm">relay</span><span class="fm-vb">invoke</span>
      <span class="fm-tip fm-tip-r"><span class="fm-t-role"><b>Provider-neutral invocation contracts</b> + adapters + conformance tools. The floor of the model plane.</span><span class="fm-t-line"><span class="fm-t-k">consumed by</span>dispatch, fieldwork, flow-agents</span></span>
    </div>

    <div class="fm-mk" style="left: 84%; top: 38%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="5" rx="1.4"/><path d="M12 8V10.2"/><path d="M12 10.2 16.4 14.8 12 19.4 7.6 14.8Z"/><path d="M16.4 14.8H19.2V20.5"/></svg></span>
      <span class="fm-nm">flow</span><span class="fm-vb">gatekeeper</span>
      <span class="fm-tip fm-tip-l"><span class="fm-t-role"><b>Workflow definitions, gates, runs &mdash; the bundle gatekeeper.</b> The only evidence a gate accepts is <code>kind: trust.bundle</code>: validated, report-derived, freshness re-checked on every evaluation.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>run projections &rarr; console</span><span class="fm-t-line"><span class="fm-t-k">uses</span>surface</span></span>
    </div>
    <div class="fm-mk" style="left: 84%; top: 56%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M12 3 19.5 7.5v9L12 21 4.5 16.5v-9Z"/><path d="M10.2 9.4 15 12 10.2 14.6Z"/></svg></span>
      <span class="fm-nm">flow-agents</span><span class="fm-vb">kit host</span>
      <span class="fm-tip fm-tip-l"><span class="fm-t-role"><b>Process discipline inside the agent tools you already use; hosts the kit ecosystem.</b> The highest-volume bundle producer: one trust.bundle per session &mdash; its only store &mdash; handed to Flow as gate evidence.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>session trust.bundle &rarr; flow gates</span><span class="fm-t-line"><span class="fm-t-k">uses</span>flow, conduit, dispatch, relay, survey</span></span>
    </div>
    <div class="fm-kits" style="left: 85%; top: 61.5%;" tabindex="0">
      <span class="fm-ks-label">&#9494; kits</span>
      <span class="fm-kit-row"><span class="fm-kit">builder</span><span class="fm-kit">knowledge</span><span class="fm-kit">release-evidence</span></span>
      <span class="fm-kit-row"><span class="fm-kit fm-kit-ext">governance &#8599; veritas</span></span>
      <span class="fm-tip fm-tip-l"><span class="fm-t-role"><b>The kit shelf</b> &mdash; swappable solutions hosted by flow-agents via the <code>kit.json</code> contract.</span><span class="fm-t-line"><span class="fm-t-k">built-in</span>builder (the delivery workflow) &middot; knowledge (gated knowledge store) &middot; release-evidence (agentless CI gate)</span><span class="fm-t-line"><span class="fm-t-k">external</span>governance ships with veritas and gates the bundle <code>veritas readiness</code> emits</span></span>
    </div>
    <div class="fm-mk" style="left: 69%; top: 67%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M3.5 9.5h17"/><path d="M3.5 14.5h17"/><path d="M9.5 7v10"/><path d="M14.5 7v10"/></svg></span>
      <span class="fm-nm">conduit</span><span class="fm-vb">host contract</span>
      <span class="fm-tip"><span class="fm-t-role"><b>Portable agent-host integration contracts</b>, lifecycle adapters, and conformance evidence &mdash; how kits plug into the coding-agent harnesses.</span><span class="fm-t-line"><span class="fm-t-k">consumed by</span>flow-agents</span></span>
    </div>
    <div class="fm-mk" style="left: 74%; top: 27%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M12 3 19 6v5c0 5-7 9.5-7 9.5S5 16 5 11V6Z"/><path d="M9 12 11 14 15 9.6"/></svg></span>
      <span class="fm-nm">veritas</span><span class="fm-vb">readiness</span>
      <span class="fm-tip fm-tip-s"><span class="fm-t-role"><b>Merge autonomy for AI-authored code.</b> Repo standards become a readiness record that embeds a genuine TrustBundle + TrustReport &mdash; evidence the agent reads back before merging.</span><span class="fm-t-line"><span class="fm-t-k">produces</span>readiness records &rarr; merge gates</span><span class="fm-t-line"><span class="fm-t-k">uses</span>surface</span></span>
    </div>

    <div class="fm-mk" style="left: 48%; top: 10%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M3.5 9h17"/><path d="M11.5 9v10.5"/></svg></span>
      <span class="fm-nm">console</span><span class="fm-vb">inspect</span>
      <span class="fm-tip fm-tip-s"><span class="fm-t-role"><b>The operating hub.</b> Ingests events, projections, and telemetry records &mdash; <b>not</b> bundles. Trust appears only as a TrustReport derived on the fly from Flow runs, rendered via Surface's trust panel.</span><span class="fm-t-line"><span class="fm-t-k">consumes</span>flow projections + run files, telemetry</span><span class="fm-t-line"><span class="fm-t-k">uses</span>surface (dynamic)</span></span>
    </div>
    <div class="fm-mk" style="left: 68%; top: 8%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.2"/><rect x="13" y="4" width="7" height="7" rx="1.2"/><rect x="4" y="13" width="7" height="7" rx="1.2"/><path d="M13 16.5h7"/><path d="M16.5 13v7"/></svg></span>
      <span class="fm-nm">ui</span><span class="fm-vb">tokens</span>
      <span class="fm-tip fm-tip-s fm-tip-l"><span class="fm-t-role"><b>The design system.</b> Framework-agnostic tokens + primitives &mdash; including the product marks on this map.</span><span class="fm-t-line"><span class="fm-t-k">consumed by</span>this site (console adoption pending)</span></span>
    </div>
    <div class="fm-mk" style="left: 93%; top: 88%;" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><path d="M12 3.5V8"/><path d="M8.5 8h7v4L12 17l-3.5-5Z"/><path d="M12 17v3.5"/></svg></span>
      <span class="fm-nm">plumb</span><span class="fm-vb">prod truth</span>
      <span class="fm-tip fm-tip-l"><span class="fm-t-role"><b>The plumb line &mdash; standalone by design.</b> Scheduled deployment checks that turn failures into agent-drafted repair proposals (PR or issue, never merge), behind cooldown and cap guards. Zero package edges on purpose: independence is the product.</span><span class="fm-t-line"><span class="fm-t-k">relates</span>watches deployed products; checks are any shell command</span></span>
    </div>

    <div class="fm-cli" tabindex="0">
      <span class="fm-ic"><svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M7 9.5 10 12l-3 2.5"/><path d="M12.5 15H17"/></svg></span>
      <span class="fm-cli-txt"><b>cli</b><span class="fm-cli-sub">suite router</span></span>
      <span class="fm-ticks" aria-hidden="true"></span>
      <span class="fm-tip"><span class="fm-t-role"><b>Offline-first suite router.</b> Knows where every product lives and routes to all of them &mdash; deliberately no runtime package edges, which is why it spans the map instead of sitting on it.</span></span>
    </div>

    <span class="fm-corner" style="right: 12px; top: 8px;">KONTOUR AI &middot; FIELD MAP</span>
    <span class="fm-corner" style="right: 12px; bottom: 10px;">EVERY EDGE VERIFIED IN CODE</span>
  </div>
  <div class="fm-legend">
    <span><span class="fm-lg fm-lg-route"></span> pipeline route</span>
    <span><span class="fm-lg fm-lg-flow"></span> artifact flow (bundle / record)</span>
    <span><span class="fm-lg fm-lg-tie"></span> speaks Hachure (the open trust format)</span>
    <span><span class="fm-lg fm-lg-dep"></span> package dependency</span>
  </div>
</div>

<style>
  .fm-scroll { overflow-x: auto; }
  .fm-frame {
    position: relative; min-width: 760px; aspect-ratio: 1000 / 625;
    border: 1px solid var(--color-edge-2); outline: 1px solid var(--color-edge);
    outline-offset: 5px; margin: 6px; background: var(--color-ink-1);
    border-radius: 2px; overflow: hidden;
  }
  #fm-terrain { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fm-routes { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fm-region {
    position: absolute; transform: translate(-50%, -50%);
    font-family: var(--font-mono); font-size: 12px; text-transform: uppercase;
    letter-spacing: 0.28em; color: var(--color-chalk-3); white-space: nowrap;
    pointer-events: none; font-weight: 600;
  }
  .fm-mk {
    position: absolute; transform: translate(-50%, -50%); z-index: 2;
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    text-align: center; cursor: default;
  }
  .fm-mk:hover, .fm-mk:focus, .fm-kits:hover, .fm-kits:focus, .fm-cli:hover, .fm-cli:focus { z-index: 40; outline: none; }
  .fm-ic {
    width: 27px; height: 27px; border: 1.5px solid var(--color-chalk-2);
    border-radius: 5px; background: var(--color-ink-2);
    display: flex; align-items: center; justify-content: center;
  }
  .fm-ic svg { width: 17px; height: 17px; stroke: var(--color-chalk); fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .fm-summit .fm-ic { width: 36px; height: 36px; border-color: var(--color-gold-2); border-width: 2px; background: color-mix(in srgb, var(--color-gold) 14%, var(--color-ink-2)); }
  .fm-summit .fm-ic svg { width: 23px; height: 23px; stroke: var(--color-gold-2); }
  .fm-mk:focus-visible .fm-ic { outline: 2px solid var(--color-gold-2); outline-offset: 2px; }
  .fm-nm {
    font-size: 12px; font-weight: 650; line-height: 1.15; color: var(--color-chalk);
    background: color-mix(in srgb, var(--color-ink-1) 80%, transparent);
    padding: 0 5px; border-radius: 2px;
  }
  .fm-summit .fm-nm { font-size: 14.5px; color: var(--color-gold-2); }
  .fm-vb { font-family: var(--font-mono); font-size: 8.5px; text-transform: uppercase; color: var(--color-chalk-2); letter-spacing: 0.1em; }
  .fm-vb a { color: inherit; text-decoration: underline dotted; text-underline-offset: 2px; }
  .fm-tip {
    position: absolute; bottom: calc(100% + 9px); left: 50%; transform: translateX(-50%);
    width: 250px; background: var(--color-ink-2); border: 1px solid var(--color-edge-2);
    border-radius: 4px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); padding: 10px 12px;
    font-size: 11.5px; line-height: 1.5; color: var(--color-chalk-2); text-align: left;
    opacity: 0; visibility: hidden; transition: opacity 0.12s ease; pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) { .fm-tip { transition: none; } }
  .fm-mk:hover .fm-tip, .fm-mk:focus .fm-tip, .fm-kits:hover .fm-tip, .fm-kits:focus .fm-tip,
  .fm-cli:hover .fm-tip, .fm-cli:focus .fm-tip { opacity: 1; visibility: visible; }
  .fm-tip b { color: var(--color-chalk); }
  .fm-tip a { color: var(--color-gold-2); }
  .fm-tip code { font-family: var(--font-mono); font-size: 10.5px; }
  .fm-t-role { display: block; margin-bottom: 6px; }
  .fm-t-line { display: block; margin-top: 3px; }
  .fm-t-k { font-family: var(--font-mono); color: var(--color-cobalt-2); font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; margin-right: 5px; }
  .fm-tip-s { bottom: auto; top: calc(100% + 9px); }
  .fm-tip-r { left: 0; transform: none; }
  .fm-tip-l { left: auto; right: 0; transform: none; }

  .fm-kits {
    position: absolute; transform: translateX(-50%); z-index: 2;
    display: flex; flex-direction: column; gap: 3px; align-items: center; cursor: default;
  }
  .fm-ks-label { font-family: var(--font-mono); font-size: 8.5px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-cobalt-2); }
  .fm-kit-row { display: flex; gap: 4px; }
  .fm-kit {
    font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.04em;
    padding: 1.5px 6px; border-radius: 2px; border: 1px solid var(--color-edge-2);
    background: color-mix(in srgb, var(--color-ink-2) 92%, transparent);
    color: var(--color-chalk-2); white-space: nowrap;
  }
  .fm-kit-ext { border-style: dashed; }

  .fm-cli {
    position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%);
    white-space: nowrap; z-index: 3; cursor: default;
    display: flex; align-items: center; gap: 10px; padding: 6px 14px;
    background: color-mix(in srgb, var(--color-ink-2) 92%, transparent);
    border: 1px solid var(--color-edge-2); border-radius: 3px;
  }
  .fm-cli .fm-ic { width: 24px; height: 24px; }
  .fm-cli .fm-ic svg { width: 15px; height: 15px; }
  .fm-cli b { font-size: 12.5px; color: var(--color-chalk); margin-right: 8px; }
  .fm-cli-sub { font-family: var(--font-mono); font-size: 9.5px; text-transform: uppercase; color: var(--color-chalk-2); letter-spacing: 0.08em; }
  .fm-ticks { width: 74px; height: 7px; border-left: 1.5px solid var(--color-chalk-2); border-right: 1.5px solid var(--color-chalk-2); border-bottom: 1.5px solid var(--color-chalk-2); position: relative; opacity: 0.65; }
  .fm-ticks::before { content: ""; position: absolute; left: 33%; top: 1px; bottom: 0; border-left: 1px solid var(--color-chalk-2); }
  .fm-ticks::after { content: ""; position: absolute; left: 66%; top: 1px; bottom: 0; border-left: 1px solid var(--color-chalk-2); }

  .fm-corner { position: absolute; font-family: var(--font-mono); font-size: 9.5px; color: var(--color-chalk-3); }
  .fm-legend {
    display: flex; flex-wrap: wrap; gap: 7px 24px; margin: 14px 6px 0;
    font-family: var(--font-mono); font-size: 10.5px; color: var(--color-chalk-2);
  }
  .fm-legend span { display: inline-flex; align-items: center; gap: 8px; }
  .fm-lg { display: inline-block; width: 26px; height: 0; }
  .fm-lg-route { border-top: 2px solid var(--color-gold-2); }
  .fm-lg-flow { border-top: 1.6px solid var(--color-cobalt-2); }
  .fm-lg-tie { border-top: 1.5px dotted var(--color-chalk-3); }
  .fm-lg-dep { border-top: 1px solid var(--color-chalk-2); opacity: 0.6; }
</style>

<script>
  // Deterministic contour terrain: one gaussian hill per region, Surface at
  // the summit, iso-lines via marching squares. Colors read from the theme
  // tokens at draw time.
  const bumps: Array<[number, number, number, number]> = [
    [0.52, 0.55, 0.15, 1.7],
    [0.19, 0.24, 0.25, 0.85],
    [0.2, 0.76, 0.22, 0.75],
    [0.82, 0.46, 0.24, 0.8],
    [0.55, 0.1, 0.18, 0.6],
    [0.84, 0.82, 0.15, 0.55],
    [0.93, 0.9, 0.06, 0.4],
  ];
  const field = (x: number, y: number): number =>
    bumps.reduce((v, [bx, by, r, a]) => v + a * Math.exp(-((x - bx) ** 2 + (y - by) ** 2) / (r * r)), 0);

  function draw(): void {
    const canvas = document.getElementById("fm-terrain") as HTMLCanvasElement | null;
    if (!canvas) return;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (!w || !h) return;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);

    const styles = getComputedStyle(document.documentElement);
    const faint = styles.getPropertyValue("--color-edge").trim() || "#1e2538";
    const strong = styles.getPropertyValue("--color-edge-2").trim() || "#2a3450";

    const step = 10;
    const cols = Math.ceil(w / step) + 1;
    const rows = Math.ceil(h / step) + 1;
    const vals: number[][] = [];
    let vmin = Infinity;
    let vmax = -Infinity;
    for (let r = 0; r < rows; r++) {
      vals[r] = [];
      for (let c = 0; c < cols; c++) {
        const v = field((c * step) / w, (r * step) / h);
        vals[r][c] = v;
        if (v < vmin) vmin = v;
        if (v > vmax) vmax = v;
      }
    }

    const levels = 20;
    for (let li = 1; li < levels; li++) {
      const t = vmin + ((vmax - vmin) * li) / levels;
      const index = li % 4 === 0;
      ctx.strokeStyle = index ? strong : faint;
      ctx.lineWidth = index ? 1.4 : 1;
      ctx.beginPath();
      for (let r = 0; r < rows - 1; r++) {
        for (let c = 0; c < cols - 1; c++) {
          const tl = vals[r][c];
          const tr = vals[r][c + 1];
          const br = vals[r + 1][c + 1];
          const bl = vals[r + 1][c];
          const x0 = c * step;
          const y0 = r * step;
          const state = (tl > t ? 8 : 0) | (tr > t ? 4 : 0) | (br > t ? 2 : 0) | (bl > t ? 1 : 0);
          if (state === 0 || state === 15) continue;
          const ix = (a: number, b: number) => (t - a) / (b - a);
          const top: [number, number] = [x0 + step * ix(tl, tr), y0];
          const right: [number, number] = [x0 + step, y0 + step * ix(tr, br)];
          const bottom: [number, number] = [x0 + step * ix(bl, br), y0 + step];
          const left: [number, number] = [x0, y0 + step * ix(tl, bl)];
          let segs: Array<[[number, number], [number, number]]> = [];
          switch (state) {
            case 1: case 14: segs = [[left, bottom]]; break;
            case 2: case 13: segs = [[bottom, right]]; break;
            case 3: case 12: segs = [[left, right]]; break;
            case 4: case 11: segs = [[top, right]]; break;
            case 5: segs = [[left, top], [bottom, right]]; break;
            case 6: case 9: segs = [[top, bottom]]; break;
            case 7: case 8: segs = [[left, top]]; break;
            case 10: segs = [[top, right], [left, bottom]]; break;
          }
          for (const [[ax, ay], [bx2, by2]] of segs) {
            ctx.moveTo(ax, ay);
            ctx.lineTo(bx2, by2);
          }
        }
      }
      ctx.stroke();
    }
  }

  let raf: number | null = null;
  const schedule = () => {
    if (raf) return;
    raf = requestAnimationFrame(() => {
      raf = null;
      draw();
    });
  };
  const canvas = document.getElementById("fm-terrain");
  if (canvas && "ResizeObserver" in window) new ResizeObserver(schedule).observe(canvas);
  window.addEventListener("resize", schedule);
  schedule();
</script>
